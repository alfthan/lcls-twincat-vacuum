<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_VGC_2S" Id="{d40d8100-9381-4a07-9a91-635cbd71ed90}">
    <Declaration><![CDATA[TYPE ST_VGC_2S EXTENDS ST_VGC:
STRUCT
    {attribute 'pytmc' := '
    pv: AT_VAC_SP_DS;
    io: o;
    field: HOPR 1000
    field: LOPR 0
    field: PREC 2
    field: EGU "TORR"
    autosave_pass1: VAL DESC
    '}
    rAT_VAC_SP_DS	:	REAL := 0.000001;	// Interlock setpoint for gauges on the downstream side of the valve
    {attribute 'pytmc' := '
    pv: AT_VAC_HYS_DS;
    io: o;
    field: HOPR 1000
    field: LOPR 0
    field: PREC 2
    field: EGU "TORR"
    autosave_pass1: VAL DESC
    '}
    rAT_VAC_HYS_DS	:	REAL :=0.000001;	// Hysteresis of the vacuum sp downstream
    rAT_VAC_SP_LAST_DS :	REAL :=0.000001 ;
(* Command / permit data of the 2-setpoint gate valve. These used to be
   separate VAR_INPUTs of FB_VGC_2S; they live in the interface struct so the
   whole command/status set travels through one VAR_IN_OUT reference. *)
    {attribute 'pytmc' := '
    pv: Dis_DPIlk;
    field: ZNAM ILK ACTIVE ;
    field: ONAM ILK DISABLED ;
    io: io;
    '}
    xDis_DPIlk	:	BOOL := FALSE;	// Command: disable the differential-pressure interlock
    {attribute 'pytmc' := '
    pv: EPS_OK;
    field: ZNAM NOT OK ;
    field: ONAM OK ;
    io: io;
    '}
    xEPS_OK	:	BOOL := TRUE;	// Permit: external EPS interlock satisfied
    {attribute 'pytmc' := '
    pv: PMPS_ILK_OK;
    field: ZNAM NOT OK ;
    field: ONAM OK ;
    io: io;
    '}
    xPMPS_ILK_OK	:	BOOL;	// Permit: external PMPS interlock satisfied
    {attribute 'pytmc' := '
    pv: MPS_FAULT_OK;
    field: ZNAM MPS FAULT ;
    field: ONAM MPS OK ;
    io: i;
    '}
    xMPS_OK	:	BOOL;	// Status: MPS fast-fault OK for this valve
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>