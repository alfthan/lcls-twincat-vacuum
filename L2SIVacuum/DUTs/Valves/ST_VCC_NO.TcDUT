<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_VCC_NO" Id="{b5ff0a28-38ae-4b86-b0f5-fc2738b0759d}">
    <Declaration><![CDATA[TYPE ST_VCC_NO:
STRUCT

(* A normally open valve needs permission to close! *)
(* Inputs *)
    {attribute 'pytmc' := '
    pv: CLS_SW ;
    field: ONAM CLOSE;
    field: ZNAM OPEN;
    io: io ;
    '}
    pv_xCLS_SW	: BOOL; (* Close request: TRUE requests CLOSE, FALSE requests OPEN. Dimensionless (BOOL) *)
    {attribute 'pytmc' := '
    pv: FORCE_CLS;
    field: ZNAM FALSE;
    field: ONAM FORCE CLOSE;
    io: io;
    '}
    pv_xOvrdCls	:	BOOL; (* Force close override request: TRUE = request override, honoured only while xOverrideMode is TRUE. Dimensionless (BOOL) *)
    {attribute 'pytmc' := '
    pv: CLS_OK;
    field: ZNAM FALSE;
    field: ONAM CLS_OK;
    io: i;
    '}
    xCLS_OK	: BOOL; (* Close permission: TRUE = close interlocks satisfied, valve may close; FALSE = permission denied, valve is driven open. Dimensionless (BOOL) *)

    {attribute 'pytmc' := '
    pv: OVRD_ON;
    field: ZNAM Override OFF ;
    field: ONAM Override ON;
    io: io
    '}
    xOverrideMode	:	BOOL; (* Shows the override status of this valve *)

(* Outputs *)
    {attribute 'pytmc' := '
    pv: CLS_DO;
        field: ZNAM FALSE;
    field: ONAM TRUE;
    io: i;
    '}
    xCLS_DO	: BOOL; (* Close output: TRUE = valve commanded CLOSED, FALSE = valve OPEN. Dimensionless (BOOL) *)

END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>