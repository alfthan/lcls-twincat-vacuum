<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_VFS_State" Id="{3f0d8a1c-5b2e-4a86-9c1d-7e2b4f6a9d35}">
    <Declaration><![CDATA[(*
    E_VFS_State - open/close sequence states of the fast shutter valve (FB_VFS, FB_VFS_2OO3).

    PURPOSE
        Name every step of the fast shutter sequence, so the block runs one
        explicit CASE machine with exactly one action per state and a documented
        exit condition per transition, instead of the ad hoc xOpen/xClose flags
        and the free-running close/open timers it used before.

    USAGE
        Declared in the VAR section of FB_VFS and FB_VFS_2OO3 as
            eState : E_VFS_State := E_VFS_State.eVFS_Idle;
        and driven only by the CASE statement in the body, whose header carries
        the full transition table. i_xClsLS / i_xOpnLS (not the state) tell where
        the shutter physically is, because a limit switch can disagree with the
        command - that disagreement is what the two timeout states report.

    HISTORY
        2026-11-27 / Scirix Agent
            Type created while refactoring the FB_VFS open/close sequence into an
            explicit state machine (audit finding #1022, convention conv_1cb8e41c12ca).

    NOTE
        Members carry the eVFS_ prefix because TwinCAT enumerators live in the
        global namespace; the prefix keeps a bare Idle/Open from colliding with
        the E_VGC / E_ValvePositionState members used by the same blocks.
*)
TYPE E_VFS_State :
(
    (* No command active. Open solenoid and close pulse outputs de-energized.
       Entered at power-up, after a fault acknowledge, and when the close
       sequence has finished. *)
    eVFS_Idle        := 0,

    (* Open command accepted and the open solenoid is energized; waits for the
       open limit switch, bounded by tOPNTimeOutDuration. *)
    eVFS_Opening     := 1,

    (* Open limit switch made; the open solenoid is held for tOpenSeatDuration so
       the shutter seats before the output is released. *)
    eVFS_OpenSeat    := 2,

    (* Shutter open and the open solenoid released; waits for the next command. *)
    eVFS_Open        := 3,

    (* Close request active and the close solenoids pulsed; held for
       tClosePulseDuration (vendor pulse rated coils). *)
    eVFS_Closing     := 4,

    (* Close pulse finished; waits for the close limit switch, bounded by
       tCLSTimeOutDuration. *)
    eVFS_CloseWait   := 5,

    (* Latched fault: the open limit switch was not made within
       tOPNTimeOutDuration. Open solenoid released. Reported as E_VGC.Opn_Timeout. *)
    eVFS_OpnTimeout  := 6,

    (* Latched fault: the close limit switch was not made within
       tCLSTimeOutDuration. Reported as E_VGC.Cls_Timeout. *)
    eVFS_ClsTimeout  := 7

);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
