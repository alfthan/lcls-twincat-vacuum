<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="Constants" Id="{352ad9bf-a34d-4366-bd0d-dad0c46d83d9}">
    <Declaration><![CDATA[VAR_GLOBAL CONSTANT
    gc_iSizeOfGGOArray : INT := 50;
    gc_GaugeValidState :	INT := 4;

    (* Analog input terminal scaling of the gauge FBs (hardware dependent).
       Counts the Beckhoff EL3174 analog input terminal reports at 10 V full scale on the range
       used by the vacuum architecture. Change the full-scale count here only; the gauge FBs
       reference it for their initial value and for their divide-by-zero fallback. *)
    gc_uiAnalogTermFullScaleBits : UINT := 30518; // Raw count reported by the terminal at full scale
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>