<TcPlcObject Version="1.1.0.1">
  <GVL Name="Constants" Id="{352ad9bf-a34d-4366-bd0d-dad0c46d83d9}">
    <Declaration><![CDATA[VAR_GLOBAL CONSTANT
    gc_iSizeOfGGOArray : INT := 50;
    gc_GaugeValidState :	INT := 4;
    (* Explicit timeout applied to every cross-PLC ADS read. Kept longer than the
       T#900ms remote-counter watchdog so a slow read is not reported twice. *)
    gc_tAdsReadTimeout : TIME := T#1S;
END_VAR
]]></Declaration>
