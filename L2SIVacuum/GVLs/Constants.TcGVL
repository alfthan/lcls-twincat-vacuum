<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="Constants" Id="{352ad9bf-a34d-4366-bd0d-dad0c46d83d9}">
    <Declaration><![CDATA[VAR_GLOBAL CONSTANT
    gc_iSizeOfGGOArray : INT := 50;
    gc_GaugeValidState :	INT := 4;

    (* Cross-PLC ADS watchdog: the remote PLC writes its watchdog counter once per this period. *)
    (* The ADS reader blocks (FB_TBOOL_ADS, FB_TVGC_ADS, ...) check that counter over a longer  *)
    (* window, so the write period can be lengthened per device on a busy remote PLC without    *)
    (* the readers reporting a watchdog error.                                                 *)
    gc_tAdsWatchdogWritePeriod : TIME := T#30MS; // Period at which the remote PLC writes its ADS watchdog counter
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>