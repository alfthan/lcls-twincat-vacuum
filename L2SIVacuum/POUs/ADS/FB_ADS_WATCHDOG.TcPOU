<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ADS_WATCHDOG" Id="{fa67c1d7-9960-48b3-9228-718e772a08ad}" SpecialFunc="None">
    <Declaration><![CDATA[(*This function block is to be used whenever deivce data going to be read over ADS*)
(*The remote plc has to instantiate this function block in order to write a watchdog variable*)
(*that the ADS read function expects to keep checking*)
FUNCTION_BLOCK FB_ADS_WATCHDOG
VAR_INPUT
    sNetId : String; //NetID of the Destination PLC controller
    nPort : uint; // port number
    sVarName : string;// the variable name of the watchdog on the remote plc.
    i_xAck : BOOL; //Acknowledge/reset of the latched bError fault: the only way bError is cleared
END_VAR
VAR_OUTPUT
    bError:BOOL; //Latched fault: set by an ADS write error, cleared only by i_xAck
END_VAR
VAR

    fb_WriteWatchdog:FB_WriteWatchdog;
    ftReset_Watchdog: F_TRIG;
    xFirstPass: BOOL:= true;
    xErrorActive : BOOL; //Live ADS write error reported by fb_WriteWatchdog
    xErrorLatched : BOOL; //Latched fault, driven from xErrorActive
    rtAck : R_TRIG; //Rising edge of the acknowledge input i_xAck

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[

ftReset_Watchdog(CLK:= fb_WriteWatchdog.bBusy OR xFirstPass);
xFirstPass := false;

(*calling ADS Watchdog function*)
fb_WriteWatchdog(
    bEnable:= TRUE ,
    sNetId:= sNetId,
    nPort:= nPort,
    nIdxGrp:= ,
    nIdxOffs:= ,
    sVarName:= sVarName,
    tWatchdogTime:= t#30ms,
    bSendNow:= ftReset_Watchdog.Q ,
    bBusy=> ,
    nLastCnt=>  ,
    bError=> xErrorActive,
    nErrorId=> );


(*Error*)
(*Latched fault: an ADS write error sets the latch and it stays set across cycles. It is cleared only
by the acknowledge input i_xAck, and only while the write path reports healthy again.*)
IF xErrorActive THEN
    xErrorLatched := TRUE;
END_IF

rtAck(CLK:= i_xAck);
IF rtAck.Q AND NOT xErrorActive THEN
    xErrorLatched := FALSE;
END_IF

bError := xErrorLatched;


]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>