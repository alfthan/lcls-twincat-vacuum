<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_VVC" Id="{a538d8bd-5f3e-49c2-b528-765b2211bef2}" SpecialFunc="None">
    <Declaration><![CDATA[(* This Function Block Implements Basic Functionality for Vent Valves VVC.

    This function block is also intended for the general use case of solenoid driven (non-variable) valves that lack status readbacks or position indicators.

    Usage:
        - Wire i_xExtILK_OK to the vent-valve interlock function (F_<Device>_ILK), or set it TRUE when the valve has no external interlock.
        - Wire i_xOverrideMode to the vacuum override request.
        - Connect iq_stValve to EPICS (OPN_SW, FORCE_OPN, OVRD_ON, OPN_OK, OPN_DO).

    Objectives:
        - Command the open solenoid output from the open switch request and the external interlock permit.
        - Honour a manual override only after the request has been held for i_tOvrdQualDur, and release it
          once it is no longer needed.
        - Never let the override defeat the external interlock permit (xOPN_OK) and never let it stay engaged
          longer than i_tOvrdMaxDur: on expiry the override is cleared and a diagnostic is logged.

    History:
        - 2026-11-28, TAIO: the override branch is now gated on xOPN_OK so a manual override can never bypass
          a safety interlock permit; the override qualification/release time is configurable (i_tOvrdQualDur);
          a maximum-override-duration limiter (i_tOvrdMaxDur) clears xOvrdOpn and logs a diagnostic when it
          expires, so an override can no longer persist indefinitely; diagnostics go through the shared
          logger inherited from FB_Valve.
*)
FUNCTION_BLOCK FB_VVC EXTENDS FB_Valve
VAR_IN_OUT

END_VAR
VAR_INPUT
    i_xExtILK_OK:BOOL; (*Other External Interlock, Set to True when no external interlock is required*)
    i_xOverrideMode : BOOL; (*To be linked to global override bit. This Overrides Vacuum logic only*)
    i_tOvrdQualDur : TIME := T#10S; (*Override is honoured only after it has been requested this long, and is released once the permit has been healthy this long*)
    i_tOvrdMaxDur : TIME := T#10M; (*Maximum time a Force Open override may stay engaged before it clears itself and logs a diagnostic*)
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
    pv:
    '}
    iq_stValve : ST_VVC;
END_VAR
VAR

    tonOvrd : TON; (*Override qualification timer*)
    tonOvrdMax : TON; (*Maximum override duration timer*)
    rtOvrdExpired : R_TRIG; (*Rising edge of the maximum override duration expiry*)
    tonDelOK : TON; (*Permit-healthy timer used to release a stale override*)
    rtOK : R_TRIG; (*Permit has been healthy for i_tOvrdQualDur*)

    (*IO*)
    q_xOPN_DO AT%Q*: BOOL;

    pv_xOvrdOpn: INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[iq_stValve.xOPN_OK := i_xExtILK_OK;

IF NOT iq_stValve.xOPN_OK THEN
iq_stValve.pv_xOPN_SW := FALSE;
END_IF

(* Override logic *)
(* Goal: give ability to override, but do so in a way that people won't forget it.
Solution: Override only after ten seconds of override, protect against blips,
when the valve permission goes true for more than ten seconds consistently, remove override.
The override is additionally bounded in time (i_tOvrdMaxDur) and can never defeat the
external interlock permit (xOPN_OK). *)

tonDelOK(IN:=iq_stValve.xOPN_OK, PT:=i_tOvrdQualDur);
rtOK(CLK:=tonDelOK.Q);
IF rtOK.Q THEN iq_stValve.xOvrdOpn :=FALSE; END_IF
// Release the Force Open bit when the system override is false
IF NOT (i_xOverrideMode) THEN  iq_stValve.xOvrdOpn :=FALSE; END_IF

//Override qualification timer: the override is only honoured after i_tOvrdQualDur
tonOvrd(IN:=iq_stValve.xOvrdOpn, PT:=i_tOvrdQualDur);

//Maximum override duration: a Force Open request may never persist longer than i_tOvrdMaxDur.
//On expiry the override is cleared so the valve returns to its commanded state, and a diagnostic
//is logged through the shared logger so the removal of the override is observable.
tonOvrdMax(IN:=iq_stValve.xOvrdOpn AND i_xOverrideMode, PT:=i_tOvrdMaxDur);
rtOvrdExpired(CLK:=tonOvrdMax.Q);
IF rtOvrdExpired.Q THEN
iq_stValve.xOvrdOpn := FALSE;
fbLogger(sMsg:='Vent valve force open override cleared: maximum override duration expired.', eSevr:=TcEventSeverity.Warning);
END_IF

(* Here's where the valve opens.
The override branch is ANDed with xOPN_OK so a manual override can never hold the valve open while
the external interlock permit is not satisfied, and it is inhibited by tonOvrdMax.Q so the override
never outlives i_tOvrdMaxDur. *)
iq_stValve.q_xOPN_DO := (iq_stValve.pv_xOPN_SW AND iq_stValve.xOPN_OK) OR (tonOvrd.Q AND i_xOverrideMode AND iq_stValve.xOPN_OK AND NOT tonOvrdMax.Q);

(*IO Mapping*)
ACT_IO();]]></ST>
    </Implementation>
    <Action Name="ACT_IO" Id="{ffed0298-5cb5-4bca-838f-8066b1682c67}">
      <Implementation>
        <ST><![CDATA[(*inputs*)
iq_stValve.xOverrideMode := i_xOverrideMode;
(*outputs*)
q_xOPN_DO:= iq_stValve.q_xOPN_DO;]]></ST>
      </Implementation>
    </Action>
    <Method Name="M_IsClosed" Id="{01a9d73c-fa4d-4cbb-8f1d-032d6c8e6684}">
      <Declaration><![CDATA[// Method Returns True if the Valve is closed, i.e. the open digital output is not active
METHOD PUBLIC M_IsClosed : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_IsClosed := NOT This^.q_xOPN_DO;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsOpen" Id="{baefc52d-c554-4c1d-a7d8-483b83575ac0}">
      <Declaration><![CDATA[// Method Returns True if the Valve is open, i.e. the open digital output is active
METHOD PUBLIC M_IsOpen : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_IsOpen := This^.q_xOPN_DO;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Open" Id="{d474e7d3-5328-4b96-aefd-0d239f7cb017}">
      <Declaration><![CDATA[METHOD PUBLIC M_Open : BOOL
VAR_INPUT
    open: bool; //Set to true to open the valvue, false to close
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[This^.iq_stValve.pv_xOPN_SW := open;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Set_OPN_SW" Id="{6bb3ce16-a9f1-46bd-80bc-4a279a4b4310}">
      <Declaration><![CDATA[// Use this Methode to Open or close the valve by setting the OPN_SW to the input value.
METHOD PUBLIC M_Set_OPN_SW : BOOL
VAR_INPUT
    value:BOOL; //True to SET, False to RESET
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[This^.iq_stValve.pv_xOPN_SW := value;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>