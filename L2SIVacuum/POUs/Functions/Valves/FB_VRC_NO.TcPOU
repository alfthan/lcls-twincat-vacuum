<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_VRC_NO" Id="{5d1c15c7-6ca9-4210-b69b-eb5b4e8facc5}" SpecialFunc="None">
    <Declaration><![CDATA[(* This function block is different from the regular VRC in that CLOSING must be permitted.

Override policy (conv_eeb5d87743fc - manual overrides are time-qualified, self-clearing and never bypass safety interlocks):
- The close override (ST_VRC_NO.pv_xOvrdCls / FORCE_CLS) is only honoured with the plant-wide override mode
  (i_xOverrideMode) enabled, and only after the request has been held continuously for the qualification time tOvrd.
- The override clears itself automatically when either:
    1) safe condition restored - the close permission iq_stValve.xCLS_OK has been continuously true for tOvrd
       (tonDelOK), or
    2) duration expiry - it has been active (qualified request AND override mode enabled) for the configured
       maximum duration tOvrdMaxDuration (tonOvrdMax).
  Both clears are logged at Warning severity and reset the retained operator request ST_VRC_NO.pv_xOvrdCls to FALSE.
- The override only replaces the vacuum close-permission term of the close command; the site interlocks evaluated
  by the caller (EPS/MPS/PMPS) are unaffected.
History: 2026-11-27 Scirix agent (task #118) - added duration expiry (tonOvrdMax/tOvrdMaxDuration) and made the
         safe-condition reset level triggered, so an override can no longer stay on indefinitely. *)
FUNCTION_BLOCK FB_VRC_NO EXTENDS FB_Valve
VAR_IN_OUT

END_VAR
VAR_INPUT

    i_xExtILK_OK : BOOL; //Connect to Interlock logic condition(e.g F_TURBO_VRC_ILK Function), otherwise, Set to True if the valve is not interlocked
    i_xOverrideMode : BOOL; (*To be linked to global override bit. This Overrides Vacuum logic only, EPS, MPS and PMPS are still enforces*)

END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
    pv:
    '}
        iq_stValve : ST_VRC_NO;
END_VAR
VAR

    {attribute 'noinit'}
    sPath: STRING;
    xFirstPass	:	BOOL;
    fbFSInit		:	R_TRIG;
    tonOvrd	:	TON;                        // Override qualification timer: the override is honoured only after tOvrd of continuous request
    tonDelOK : TON;                             // Close-permission debounce: TRUE once iq_stValve.xCLS_OK has been continuously true for tOvrd
    tOvrd	:	TIME := T#10s;                  // Override qualification time, also used as the close-permission debounce time of the safe-condition reset
    tonOvrdMax : TON;                           // Override duration timer: runs while the override is active and expires it after tOvrdMaxDuration
    tOvrdMaxDuration : TIME := T#30M;           // Configured maximum duration an active close override may remain on before it is cleared automatically
    xOvrdActive : BOOL;                         // TRUE while the override is actually in effect (qualified request AND plant-wide override mode enabled)
    (* Timeouts*)
    tTimeOutDuration: TIME:= T#30S;
    tOPNtimeout: TON;
    tCLStimeout:TON;


(*IO*)
    i_xOpnLS	AT%I*: BOOL;
    i_xClsLS	AT%I*: BOOL;
    q_xCLS_DO	AT%Q*: BOOL;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* This function block is different from the regular VRC in that CLOSING must be permitted. *)

(* On first PLC pass, put valve into vented state, which implies a closed valve *)
fbFSInit( CLK := TRUE, Q => xFirstPass);
IF xFirstPass THEN
    iq_stValve.pv_xCLS_SW := FALSE;
END_IF




///Check valve position
IF iq_stValve.i_xClsLS AND  iq_stValve.i_xOpnLS THEN
    iq_stValve.eState:=INVALID;
ELSIF NOT iq_stValve.i_xClsLS AND iq_stValve.i_xOpnLS AND NOT iq_stValve.q_xCLS_DO THEN
    iq_stValve.eState:=OPEN;
ELSIF iq_stValve.i_xClsLS AND NOT iq_stValve.i_xOpnLS AND iq_stValve.q_xCLS_DO THEN
    iq_stValve.eState:=CLOSED;
ELSIF NOT iq_stValve.i_xClsLS AND NOT iq_stValve.i_xOpnLS THEN
    iq_stValve.eState:=MOVING;
ELSE
    iq_stValve.eState:=INVALID;
END_IF


(*evaluate Valve CLose external interlock*)
iq_stValve.xCLS_OK := i_xExtILK_OK;
IF NOT iq_stValve.xCLS_OK and NOT tonOvrd.Q THEN
    iq_stValve.pv_xCLS_SW := FALSE;
END_IF


(* Override logic *)
(* Goal: give ability to override, but do so in a way that people won't forget it.
Solution: Override only after the request has been held for tOvrd (protects against blips), and the override is
never allowed to stay on indefinitely: it clears itself when the close permission has been restored for tOvrd,
or when it has been active for the configured maximum duration tOvrdMaxDuration.
*)

(* Safe-condition reset. Level triggered on purpose: once the close permission has been continuously true for
   tOvrd the override is no longer needed. Using tonDelOK.Q as a level (rather than its rising edge) also clears
   an override that is requested after the permission has already been good for longer than tOvrd. *)
tonDelOK(IN:=iq_stValve.xCLS_OK, PT:=tOvrd);
IF tonDelOK.Q AND iq_stValve.pv_xOvrdCls THEN
    iq_stValve.pv_xOvrdCls :=FALSE;
    if (iq_stValve.eState=CLOSED) AND (i_xOverrideMode) THEN iq_stValve.pv_xCLS_SW := TRUE; END_IF
    //Log
    fbLogger(sMsg:='Override expired', eSevr:=TcEventSeverity.Warning);
END_IF

//Override timer
tonOvrd(IN:=iq_stValve.pv_xOvrdCls, PT:=tOvrd);

(* Release the retained override request while the plant-wide override mode is disabled, so a stale request
   cannot take effect later when the mode is enabled for an unrelated reason. *)
IF NOT i_xOverrideMode THEN
    iq_stValve.pv_xOvrdCls := FALSE;
END_IF

(* Duration expiry. A manual override must not stay active indefinitely: the timer runs while the override is
   actually in effect (request qualified by tonOvrd AND the plant-wide override mode enabled) and clears the
   latched override request once tOvrdMaxDuration has elapsed, so the normal vacuum close-permission logic
   resumes without anyone having to remember the override. *)
xOvrdActive := tonOvrd.Q AND i_xOverrideMode;
tonOvrdMax(IN:=xOvrdActive, PT:=tOvrdMaxDuration);
IF tonOvrdMax.Q AND iq_stValve.pv_xOvrdCls THEN
    iq_stValve.pv_xOvrdCls := FALSE;
    //Log
    fbLogger(sMsg:='Override expired after configured duration', eSevr:=TcEventSeverity.Warning);
END_IF

(* Here's where the valve Actuates *)
q_xCLS_DO := ((iq_stValve.xCLS_OK  AND iq_stValve.pv_xCLS_SW)OR (tonOvrd.Q AND i_xOverrideMode));
iq_stValve.q_xOPN_DO := NOT q_xCLS_DO;



///Check valve moving position timout
IF NOT iq_stValve.i_xClsLS AND tCLStimeout.Q THEN
    iq_stValve.bErrorPresent := TRUE;
    //iq_stValve.sErrorMessage := ' Close Timeout';
ELSIF NOT iq_stValve.i_xOpnLS AND tOPNtimeout.Q THEN
    iq_stValve.bErrorPresent := TRUE;
    //iq_stValve.sErrorMessage := ' Open Timeout';
END_IF
IF (iq_stValve.eState=INVALID) THEN
    iq_stValve.bErrorPresent := TRUE;
    //iq_stValve.sErrorMessage := CONCAT(sPath,' Invalid Valve Position');
END_IF

(*Timers*)
tOPNtimeout(IN:= NOT iq_stValve.q_xCLS_DO, PT := tTimeOutDuration );
tCLStimeout(IN:= iq_stValve.q_xCLS_DO, PT := tTimeOutDuration);


(*Soft IO Mapping*)
ACT_IO();

// Log States and triggers
ACT_Logger();

(*Reset Alarms*)
ACT_ResetAlarms();]]></ST>
    </Implementation>
    <Action Name="ACT_IO" Id="{78c09d9d-7b22-4f95-9e71-00f022d33838}">
      <Implementation>
        <ST><![CDATA[(*inputs*)
iq_stValve.i_xOpnLS := 	i_xOpnLS;
iq_stValve.i_xClsLS:=	i_xClsLS;
//iq_stValve. := i_xEXT_OK;
iq_stValve.xOverrideMode := i_xOverrideMode;
(*outputs*)
iq_stValve.q_xCLS_DO := q_xCLS_DO;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ACT_ResetAlarms" Id="{43b4539e-05f9-4647-acc6-2ecda35caef2}">
      <Implementation>
        <ST><![CDATA[iq_stValve.bErrorPresent R= iq_stValve.pv_xAlmRst;

IF ( iq_stValve.pv_xAlmRst) THEN
    iq_stValve.sErrorMessage :='';
     iq_stValve.pv_xAlmRst := FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="M_IsClosed" Id="{1a4f7fba-716e-4142-91d1-acdbbe554bf0}">
      <Declaration><![CDATA[METHOD PUBLIC M_IsClosed : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_IsClosed := (This^.iq_stValve.eState = E_ValvePositionState.CLOSED);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsOpen" Id="{355e028c-f542-4933-a598-b48f9c69ec45}">
      <Declaration><![CDATA[METHOD PUBLIC M_IsOpen : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_IsOpen := (This^.iq_stValve.eState = E_ValvePositionState.OPEN);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Set_CLS_SW" Id="{ad95ac56-f25b-4000-8aac-5537758a35ec}">
      <Declaration><![CDATA[// Use this Methode to Open or close the valve by setting the OPN_SW to the input value.
METHOD PUBLIC M_Set_CLS_SW : BOOL
VAR_INPUT
        value:BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[This^.iq_stValve.pv_xCLS_SW := value;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>