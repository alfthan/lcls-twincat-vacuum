<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_VFS" Id="{68519563-003c-4daf-ae0e-7245b1fe09af}" SpecialFunc="None">
    <Declaration><![CDATA[(*
    FB_VFS - fast shutter (VFS) valve control.

    PURPOSE
        Drives a VAT fast shutter: one open solenoid (q_xOPN_DO) and three parallel
        close pulse outputs (q_xClose_A/B/C), with the pressure-OK, external, veto,
        override and PMPS/MPS handling of the fast shutter family.

    USAGE
        Instantiated once per fast shutter and mapped to the FAST I/O portion of the
        ethercat bus, so it is scanned at the fast task rate (tested with a 50 us
        cycle base time, 0.050 ms cycle). The normal task half is FB_VFS_Interface;
        the two halves exchange commands and status over the AT%I*/AT%Q* soft IO.
        Create a separate virtual PLC for the fast shutter logic if the rest of the
        vacuum I/O is slower. io_fbFFHWO must be the hardware fast-fault output the
        shutter reports into.

    OBJECTIVES
        - Run the open/close sequence as one explicit, non-blocking state machine
          (E_VFS_State, CASE in the body): one action per state, a documented exit
          condition per transition and a step counter (nStep).
        - Bound every wait. Waiting for the open limit switch is bounded by
          tOPNTimeOutDuration and waiting for the close limit switch by
          tCLSTimeOutDuration; each expiry lands in a latched timeout state instead
          of an open-ended wait.
        - Keep the physical outputs de-energized unless the active state drives them,
          so a cold start, a latched fault or an unhandled state cannot hold a coil in.

    HISTORY
        2019-02 / M. Ghaly
            Block written, with ad hoc open/close BOOL flags and free-running timers.
        2026-11-27 / Scirix Agent
            Open/close sequence refactored into E_VFS_State + CASE. The ad hoc
            open/close flags, the close/open hold timers and the close-timeout path
            that could never expire were removed (audit finding #1022, convention
            conv_1cb8e41c12ca).
*)
FUNCTION_BLOCK FB_VFS EXTENDS FB_Valve
VAR_INPUT
    i_xPMPS_OK:	BOOL	; (*External MPS interlock, Set to TRUE when no PMPS interlock is required*)
    i_xExt_OK: BOOL; (*Other External Interlock, Set to True when no external interlock is required*)
    i_sDevName : T_MaxString :=  'VGC'; // Device name for diagnostic
    i_xVeto_Enable:BOOL:= FALSE; (*Set to TRUE if there is a Veto Valve to this VFS*)
END_VAR
VAR_IN_OUT
    io_fbFFHWO    :    FB_HardwareFFOutput;
END_VAR
VAR
    xOPN_OK :BOOL;
    xERR_ExtFault :BOOL;
    xVeto: BOOL;
    // PMPS
    fbFF    :    FB_FastFault :=(
        i_DevName := 'VFS',
        i_Desc := 'Fault occurs when fast valve is not in open state',
        i_TypeCode := 16#1010);

    rDiffPressAllowed	:	REAL := 22.5; // Torr, Default value comes from Vat Valve Manual
    rDiffPress : REAL;
    set : BOOL;
    reset: BOOL;

    xFirstPass	:	BOOL := TRUE;
    //fbFSInit		:	R_TRIG;
    rtOPN_SW :	R_TRIG;

    tonDelOK : TON;
    rtOK	:	R_TRIG;
    tonOvrd	:	TON;

    tDelOK	:	TIME := T#60S;
    tOvrd	:	TIME := T#10s;
    rTrigOverrideOpen : R_TRIG;

    (* Open/close sequence - explicit state machine, transition table in the body *)
    eState : E_VFS_State := E_VFS_State.eVFS_Idle;      // current sequence state
    eStatePrev : E_VFS_State := E_VFS_State.eVFS_Idle;  // previous scan's state, drives the step counter
    nStep : UINT;                                       // transition counter, +1 per state change, saturates at 65535

    (* Sequence requests, evaluated once per scan before the state machine *)
    xCloseDemand : BOOL; (* trigger, lost pressure permit or lost external interlock - veto and override aware *)
    xCloseReq : BOOL;    (* close request that is not satisfied yet: no pulse once the close switch is made *)
    xOpenReq : BOOL;     (* one open sequence: EPICS open edge while permitted, or the qualified override *)

    (* Sequence timers - all called unconditionally, see the end of the body *)
    tonOpenTimeout : TON;  (* open wait bound: open solenoid energized, open limit switch not made *)
    tonOpenSeat : TON;     (* open seat time: open solenoid held after the open limit switch makes *)
    tonClosePulse : TON;   (* close pulse width: how long the close solenoids are energized *)
    tonCloseTimeout : TON; (* close wait bound: close pulse finished, close limit switch not made *)

    (* Sequence times *)
    tOPNTimeOutDuration : TIME := T#10S;   (* max time to reach the open limit switch after an open command *)
    tCLSTimeOutDuration : TIME := T#0.5S;  (* max time to see the close limit switch after the close pulse *)
    tOpenSeatDuration : TIME := T#2S;      (* hold time on the open limit switch before the open DO is released *)
    tClosePulseDuration : TIME := T#20MS;  (* vendor close-coil pulse width *)


    (*IO*)
    i_xOpnLS	AT%I*: BOOL;
    i_xClsLS	AT%I*: BOOL;
    q_xClose_A	AT%Q*: BOOL;
    q_xClose_B	AT%Q*: BOOL;
    q_xClose_C	AT%Q*: BOOL;
    q_xOPN_DO	AT%Q*: BOOL;
    i_xTrigger	AT%I*: BOOL;

    (*VETO Devices*)
    i_xVetoValveOpenDO AT%I*: BOOL;
    i_xVetoValveClosed AT%I*: BOOL;

    // Interface
    i_xPress_OK AT%I*:BOOL; (*To be linked to the Fast sensor structure signal IG.xPRESS_OK, to make sure that the device is connected*)
    i_xOPN_SW AT%I*:BOOL;
    i_xCLS_SW AT%I*:BOOL; (*external open signal e.g epics*)
    i_xVAC_FAULT_Reset	AT%I*: BOOL;(*Valve Vacuum OK, is set to False when there is Vacuum Fault*)
    i_xOverrideMode AT%I*: BOOL; (*To be linked to global override bit. This Overrides Vacuum logic only, EPS, MPS and PMPS are still enforces*)
    i_xOverrideOpen AT%I*: BOOL;
    q_xTrigger	AT%Q*: BOOL; (*Interface*)
    q_xVFS_Open AT%Q*: BOOL; (*Interface*)
    q_xVFS_Closed AT%Q*: BOOL; (*Interface*)
    q_xVAC_FAULT_OK AT%Q*: BOOL; (*Valve Vacuum OK, is set to False when there is Vacuum Fault*)
    q_xMPS_OK	 AT%Q*:	BOOL; (*MPS Fault OK, is set when the Valve is Open and there is no trigger*)
    q_eVFS_State AT%Q*: E_VGC; (*Interface*)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
(* Fast Shutter/Valve Function Block*)
(* M.Ghaly Feb 2019*)

(* Fast Shutters do not function as complete isolation valves, but are intended to rapidly limit conductance
between vacuum regions.  They should be installed in conjunction with isolation gate valves.  The conductance
of the fast shutter in the closed state may be sufficiently low as to create an isolated vacuum region.
Thus, at least a pirani gauge, that can measure a pressure down to 1x10-4 Torr, needs to be installed between
the shutter and the isolation gate valve.
In the case where a gauge is not installed, the neigboring gate Valves should not be opened unless the shutter
is Open.
*)
(* On first PLC pass, put valve into vented state, which implies a closed valve *)
IF xFirstPass THEN
    fbFF.i_DevName := i_sDevName;
    xFirstPass := FALSE;
END_IF


(*set Veto bit*)
IF (i_xVeto_Enable) THEN
    xVeto := (i_xVetoValveClosed AND NOT i_xVetoValveOpenDO);
ELSE
    xVeto := FALSE;
END_IF

(* EPICS open command: the rising edge arms one open sequence *)
rtOPN_SW(CLK := i_xOPN_SW);

(* Close demand. A fast trigger, loss of the pressure permit or loss of the external
   interlock all demand a close; a veto device and an active override keep the trigger
   from acting. This is the condition that used to drive the close flag directly. *)
xCloseDemand := ((i_xTrigger) OR NOT (i_xPress_OK) OR NOT (i_xExt_OK))
                AND NOT (xVeto)
                AND NOT (tonOvrd.Q AND i_xOverrideMode);

(* A close request is only meaningful while the shutter is not already at the close
   limit switch, otherwise the close pulse would be re-issued every scan. *)
xCloseReq := (xCloseDemand OR i_xCLS_SW) AND NOT i_xClsLS;

(* The close demand latches the external fault and drops the neighbouring-valve interlock *)
IF xCloseDemand THEN
    xERR_ExtFault := TRUE;
END_IF
IF (xCloseDemand OR i_xCLS_SW) THEN
    q_xVAC_FAULT_OK := FALSE;
END_IF

(*OPN OK evaluation bit *)
xOPN_OK := (NOT xERR_ExtFault) AND (NOT i_xTrigger OR xVeto);

(* Open request: the rising edge of the EPICS open command while opening is permitted,
   or the manual override once it has been qualified for tOvrd. *)
xOpenReq := ((rtOPN_SW.Q) AND xOPN_OK AND NOT i_xOpnLS) OR (tonOvrd.Q AND i_xOverrideMode);

(* ----------------------------------------------------------------------------------
   Fast shutter open/close sequence - explicit, non-blocking state machine.

   The outputs are driven to their de-energized state at the top of the machine and
   only the active state energizes anything, so a cold start, a latched fault or an
   unhandled state cannot leave a coil energized. A close request always wins over an
   open request, because closing is the safe direction for a fast shutter.

     state             action                          exit condition
     ----------------  ------------------------------  ---------------------------------
     eVFS_Idle         none                            xCloseReq -> eVFS_Closing
                                                       xOpenReq  -> eVFS_Opening
     eVFS_Opening      q_xOPN_DO                       xCloseReq -> eVFS_Closing
                                                       i_xOpnLS  -> eVFS_OpenSeat
                                                       tonOpenTimeout.Q -> eVFS_OpnTimeout
     eVFS_OpenSeat     q_xOPN_DO                       xCloseReq -> eVFS_Closing
                                                       NOT i_xOpnLS -> eVFS_Opening
                                                       tonOpenSeat.Q -> eVFS_Open
     eVFS_Open         none                            xCloseReq -> eVFS_Closing
     eVFS_Closing      q_xClose_A/B/C                  i_xClsLS -> eVFS_Idle
                                                       tonClosePulse.Q -> eVFS_CloseWait
     eVFS_CloseWait    none                            i_xClsLS -> eVFS_Idle
                                                       tonCloseTimeout.Q -> eVFS_ClsTimeout
     eVFS_OpnTimeout   none (open solenoid released)   xCloseReq -> eVFS_Closing
                                                       i_xVAC_FAULT_Reset -> eVFS_Idle
     eVFS_ClsTimeout   none                            i_xClsLS -> eVFS_Idle
                                                       i_xVAC_FAULT_Reset -> eVFS_Idle
   ---------------------------------------------------------------------------------- *)
q_xOPN_DO := FALSE;
q_xClose_A := FALSE;
q_xClose_B := FALSE;
q_xClose_C := FALSE;

CASE eState OF
    E_VFS_State.eVFS_Idle:
        (* no command: the shutter is resting at one of the limit switches *)
        IF xCloseReq THEN
            eState := E_VFS_State.eVFS_Closing;
        ELSIF xOpenReq THEN
            eState := E_VFS_State.eVFS_Opening;
        END_IF

    E_VFS_State.eVFS_Opening:
        (* energize the open solenoid and wait for the open limit switch *)
        q_xOPN_DO := TRUE;
        IF xCloseReq THEN
            eState := E_VFS_State.eVFS_Closing;
        ELSIF i_xOpnLS THEN
            eState := E_VFS_State.eVFS_OpenSeat;
        ELSIF tonOpenTimeout.Q THEN
            (* bounded wait expired: release the solenoid and latch the fault *)
            eState := E_VFS_State.eVFS_OpnTimeout;
        END_IF

    E_VFS_State.eVFS_OpenSeat:
        (* open limit switch made: hold the open solenoid for tOpenSeatDuration *)
        q_xOPN_DO := TRUE;
        IF xCloseReq THEN
            eState := E_VFS_State.eVFS_Closing;
        ELSIF NOT i_xOpnLS THEN
            (* lost the open limit switch: seat it again *)
            eState := E_VFS_State.eVFS_Opening;
        ELSIF tonOpenSeat.Q THEN
            (* seated: release the solenoid and consume the EPICS open command *)
            i_xOPN_SW := FALSE;
            eState := E_VFS_State.eVFS_Open;
        END_IF

    E_VFS_State.eVFS_Open:
        (* shutter open, open solenoid released, waiting for the next command *)
        IF xCloseReq THEN
            eState := E_VFS_State.eVFS_Closing;
        END_IF

    E_VFS_State.eVFS_Closing:
        (* pulse the close solenoids for tClosePulseDuration *)
        IF i_xClsLS THEN
            eState := E_VFS_State.eVFS_Idle;
        ELSE
            q_xClose_A := TRUE;
            q_xClose_B := TRUE;
            q_xClose_C := TRUE;
            IF tonClosePulse.Q THEN
                eState := E_VFS_State.eVFS_CloseWait;
            END_IF
        END_IF

    E_VFS_State.eVFS_CloseWait:
        (* pulse finished: wait for the close limit switch, bounded *)
        IF i_xClsLS THEN
            eState := E_VFS_State.eVFS_Idle;
        ELSIF tonCloseTimeout.Q THEN
            eState := E_VFS_State.eVFS_ClsTimeout;
        END_IF

    E_VFS_State.eVFS_OpnTimeout:
        (* LATCHED: the open limit switch was not made within tOPNTimeOutDuration.
           The open solenoid is released (its safe state). Acknowledge with the vacuum
           fault reset input, or let a close request take over. *)
        IF xCloseReq THEN
            eState := E_VFS_State.eVFS_Closing;
        ELSIF i_xVAC_FAULT_Reset THEN
            eState := E_VFS_State.eVFS_Idle;
        END_IF

    E_VFS_State.eVFS_ClsTimeout:
        (* LATCHED: the close limit switch was not made within tCLSTimeOutDuration.
           The close pulse is not repeated automatically: the close coils are pulse
           rated, so re-pulsing them every scan chatters them and holding them
           energized exceeds their duty cycle. Acknowledge with the vacuum fault reset
           input; if the close demand is still present the sequence then retries. *)
        IF i_xClsLS THEN
            (* the switch finally made: the timeout is resolved *)
            eState := E_VFS_State.eVFS_Idle;
        ELSIF i_xVAC_FAULT_Reset THEN
            eState := E_VFS_State.eVFS_Idle;
        END_IF
END_CASE

(* Transition counter: +1 per state change, saturating at the UINT limit. Diagnostic
   only: it makes the number of sequence steps and re-entries visible online. *)
IF eState <> eStatePrev THEN
    IF nStep < 65535 THEN
        nStep := nStep + 1;
    END_IF
    eStatePrev := eState;
END_IF

(* Sequence timers - called every scan, driven by the state the CASE machine was in.
   The one-scan lag between entering a state and starting its timer is intentional and
   resets every timer as soon as its state is left. *)
tonOpenTimeout(IN := (eState = E_VFS_State.eVFS_Opening), PT := tOPNTimeOutDuration);
tonOpenSeat(IN := (eState = E_VFS_State.eVFS_OpenSeat), PT := tOpenSeatDuration);
tonClosePulse(IN := (eState = E_VFS_State.eVFS_Closing), PT := tClosePulseDuration);
tonCloseTimeout(IN := (eState = E_VFS_State.eVFS_CloseWait), PT := tCLSTimeOutDuration);

(* Neighboring Valves Interlock bit is reset When the Vacuum event error is reset and the Shutter is opened *)
IF ((NOT i_xTrigger) OR xVeto) AND (NOT xERR_ExtFault) AND i_xOpnLS THEN
    q_xVAC_FAULT_OK := TRUE;
END_IF

(* When the valve is open MPS is OK *)
q_xMPS_OK := i_xOpnLS AND ((NOT i_xTrigger AND i_xPress_OK) OR xVeto)  AND NOT(i_xCLS_SW);

(* Override logic *)
(* Goal: give ability to override, but do so in a way that people won't forget it.
Solution: Override only after ten seconds of override, protect against blips,
when the valve permission goes true for more than ten seconds consistently, remove override
*)
rTrigOverrideOpen(CLK:= i_xOverrideOpen);
tonDelOK(IN:=xOPN_OK, PT:=tDelOK);
rtOK(CLK:=tonDelOK.Q);
IF rtOK.Q AND i_xOverrideOpen THEN
    i_xOverrideOpen :=FALSE;
    //Log
    fbLogger(sMsg:='Override expired', eSevr:=TcEventSeverity.Warning);
END_IF

//Override timer
tonOvrd(IN:=i_xOverrideOpen, PT:=tOvrd);

(* Publish the sequence status in the existing E_VGC vocabulary (EPICS/pytmc contract) *)
IF (i_xTrigger) THEN
    q_eVFS_State := E_VGC.Triggered;
ELSIF xERR_ExtFault THEN
    q_eVFS_State :=  E_VGC.Vac_Fault;
ELSIF eState = E_VFS_State.eVFS_ClsTimeout THEN
    q_eVFS_State :=  E_VGC.Cls_Timeout;
ELSIF eState = E_VFS_State.eVFS_OpnTimeout THEN
    q_eVFS_State :=  E_VGC.Opn_Timeout;
ELSE
    q_eVFS_State :=  E_VGC.At_Vac;
END_IF

(* Soft IO Mapping*)
IO();

(*Alarm reset *)
ACT_ResetAlarms();

(*FAST FAULT*)
fbFF(i_xOK := q_xMPS_OK,
    i_xReset := i_xVAC_FAULT_Reset,
    i_xAutoReset :=TRUE,
    io_fbFFHWO := io_fbFFHWO);



]]></ST>
    </Implementation>
    <Action Name="ACT_ResetAlarms" Id="{5bc381e2-d93d-4e07-9868-4d1094f97e97}">
      <Implementation>
        <ST><![CDATA[//iq_stValve.xERR_DifPres R= i_xResetFault;

//iq_stValve.bErrorPresent R= i_xResetFault;

IF (NOT i_xTrigger AND i_xPress_OK AND i_xVAC_FAULT_Reset) OR xVeto THEN
    xERR_ExtFault := FALSE;
    i_xVAC_FAULT_Reset:=FALSE;
END_IF


IF (i_xTrigger OR NOT i_xPress_OK) AND NOT xVeto THEN
    i_xVAC_FAULT_Reset:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="IO" Id="{be2b8137-473d-4278-9e2c-831399c62f45}">
      <Implementation>
        <ST><![CDATA[
q_xTrigger := i_xTrigger;
q_xVFS_Closed:= i_xClsLS;
q_xVFS_Open:= i_xOpnLS;]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>