<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_VFS_Interface" Id="{57bc9317-df03-4829-82d4-3e35e70264fe}" SpecialFunc="None">
    <Declaration><![CDATA[(*Used as soft IO mapping to create a psuedo valve to communicate over two task on the same PLC.*)
(*for FAST shutter control*)

Open override policy (conv_eeb5d87743fc - a manual override is time-qualified, self-clearing and never a
bypass of a safety interlock):
- The open override (ST_VFS.pv_xOvrdOpn / FORCE_OPN) is honoured only while the plant-wide override mode
  (ST_VFS.xOverrideMode / OVRD_ON) is enabled, only after the request has been held continuously for the
  qualification time tOvrd, and only while this block's open permit xOPN_OK is satisfied. xOPN_OK is
  ST_VFS.i_xVAC_FAULT_OK AND (no trigger OR veto device closed), so the override can no longer force the fast
  shutter open against the vacuum-fault interlock or a non-vetoed trigger (a trigger vetoed by the closed veto
  device stays permitted, exactly as for a normal open request); q_xOverrideOpen is never a raw copy of the
  FORCE_OPN request.
- The override clears itself automatically when either:
    1) safe condition restored - the open permit xOPN_OK has been continuously true for tDelOK, or
    2) duration expiry - it has been active (qualified request AND override mode enabled) for the configured
       maximum duration tOvrdMaxDuration (tonOvrdMax).
  Both clears are logged at Warning severity and reset the retained operator request ST_VFS.pv_xOvrdOpn to FALSE.
- A retained request is also released while the plant-wide override mode is disabled, so a stale FORCE_OPN
  cannot take effect when the mode is enabled later for an unrelated reason.
Usage: instantiate in the slow (vacuum) task and map the q_x* outputs onto the i_x* inputs of the FB_VFS /
FB_VFS_2OO3 instance running in the fast shutter task, and the ST_VFS data back through iq_stValve.
History: 2026-11-27 Scirix agent (task #258) - qualified q_xOverrideOpen with tonOvrd and the xOPN_OK permit,
         added the configured-duration expiry (tonOvrdMax/tOvrdMaxDuration), moved the safe-condition reset to a
         level-triggered test and released the request when the override mode is off, so a manual override can
         no longer stay on indefinitely nor bypass an interlock.
*)
FUNCTION_BLOCK FB_VFS_Interface EXTENDS FB_Valve
VAR_INPUT
    IG : ST_VG; // The MKS422 Cold Cathode Data Structure
    Veto_Valve: ST_VGC;// The VGC structure for the Veto Valve
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
    pv: ;
    '}
    iq_stValve : ST_VFS; (* All valve data and states will be in this struct*)
    i_xVAC_FAULT_OK AT%I*: BOOL; (*Valve Vacuum OK, is set to False when there is Vacuum Fault*)
END_VAR
VAR
    rtTriggerVetoed : R_TRIG;           // Rising edge of a trigger vetoed by the veto device, for one-shot logging
    rtTriggered : R_TRIG;               // Rising edge of an accepted trigger, for one-shot logging
    tonOvrd	:	TON;                        // Override qualification timer: the request is honoured only after tOvrd of continuous request
    tOvrd	:	TIME := T#10s;              // Override qualification time (protects against blips of the FORCE_OPN request)
    tonDelOK : TON;                     // Open-permit debounce: TRUE once xOPN_OK has been continuously true for tDelOK
    tonOvrdMax : TON;                   // Override duration timer: runs while the override is active and expires it after tOvrdMaxDuration
    tOvrdMaxDuration : TIME := T#30M;   // Configured maximum duration an active override may remain on before it is cleared automatically
    xOvrdActive : BOOL;                 // TRUE while the override is in effect (qualified request AND plant-wide override mode enabled)
    rtOvrdDenied : R_TRIG;              // Rising edge of an override request that the open permit refuses, for one-shot logging
    xOPN_OK : BOOL;                     // Open permit: vacuum-fault OK AND (no trigger OR veto device closed)
    tDelOK	:	TIME := T#60S;          // Time the open permit must be continuously good before the override clears itself

    (*outputs*)
    q_xPRESS_OK AT%Q*: BOOL;
    q_xOPN_SW AT%Q*:BOOL;
    q_xCLS_SW AT%Q*:BOOL; (*external open signal e.g epics*)
    q_xVAC_FAULT_Reset AT%Q*: BOOL; (*Valve Vacuum OK, is set to False when there is Vacuum Fault*)
    q_xOverrideMode AT%Q*: BOOL; (*To be linked to global override bit. This Overrides Vacuum logic only, EPS, MPS and PMPS are still enforces*)
    q_xOverrideOpen AT%Q*: BOOL; (*Qualified, interlock-permitted override request for the fast shutter. Never a raw copy of FORCE_OPN, see the override policy in the header*)

    (*VETO Devices*)
    q_xVetoValveOpenDO AT%Q*: BOOL;
    q_xVetoValveClosed AT%Q*: BOOL;
    (*inputs*)
    i_xTrigger AT %I* : BOOL;
    i_xVFS_Open AT %I* : BOOL;
    i_xVFS_Closed AT %I* : BOOL;
    {attribute 'pytmc' := '
    pv: MPS_FAULT_OK
    field: ZNAM MPS FAULT ;
    field: ONAM MPS OK ;
    io: i ;
    '}
    i_xMPS_OK AT%I*: BOOL;(*MPS Fault OK, is set when the Valve is Open and there is no trigger*)
    i_eVFS_State AT%I*: E_VGC; (*Interface*)



END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*soft IO Mapping*)

q_xPRESS_OK := IG.xPRESS_OK;

(* Soft IO Mapping*)
IO();
///Check valve postion
IF iq_stValve.i_xClsLS AND  iq_stValve.i_xOpnLS THEN
    iq_stValve.eState:=INVALID;
ELSIF NOT iq_stValve.i_xClsLS AND iq_stValve.i_xOpnLS THEN
    iq_stValve.eState:=OPEN;
ELSIF iq_stValve.i_xClsLS AND NOT iq_stValve.i_xOpnLS THEN
    iq_stValve.eState:=CLOSED;
ELSIF NOT iq_stValve.i_xClsLS AND NOT iq_stValve.i_xOpnLS THEN
    iq_stValve.eState:=MOVING;
ELSE
    iq_stValve.eState:=INVALID;
END_IF
(*OPN OK evaluation bit. Evaluated before the override logic so that the override is always qualified against
  the permit of the current scan.*)
xOPN_OK := (i_xVAC_FAULT_OK) AND (NOT i_xTrigger OR (q_xVetoValveClosed AND NOT q_xVetoValveOpenDO)) ;

(* Open override logic *)
(* Goal: give the operator a way to force the fast shutter open, but do so in a way that people won't forget it
and that never defeats an interlock.
Policy: the request is qualified (tOvrd), permitted (xOPN_OK), self-clearing (permit good for tDelOK, or the
configured maximum duration tOvrdMaxDuration) and is released as soon as the override mode is switched off.
*)

//Override qualification timer: the request must be held continuously for tOvrd before it is honoured
tonOvrd(IN:=iq_stValve.pv_xOvrdOpn, PT:=tOvrd);

(* Duration expiry. A manual override must not stay active indefinitely: the timer runs while the override is
   actually in effect (request qualified by tonOvrd AND the plant-wide override mode enabled) and clears the
   retained operator request once tOvrdMaxDuration has elapsed, so the normal vacuum logic resumes without anyone
   having to remember the override.*)
xOvrdActive := tonOvrd.Q AND iq_stValve.xOverrideMode;
tonOvrdMax(IN:=xOvrdActive, PT:=tOvrdMaxDuration);
IF tonOvrdMax.Q AND iq_stValve.pv_xOvrdOpn THEN
    iq_stValve.pv_xOvrdOpn :=FALSE;
    //Log
    fbLogger(sMsg:='Override expired after configured duration', eSevr:=TcEventSeverity.Warning);
END_IF

(* Safe-condition reset. Level triggered on purpose: once the open permit has been continuously true for tDelOK
   the override is no longer needed. Using tonDelOK.Q as a level (rather than its rising edge) also clears an
   override that is requested after the permit has already been good for longer than tDelOK.*)
tonDelOK(IN:=xOPN_OK, PT:=tDelOK);
IF tonDelOK.Q AND iq_stValve.pv_xOvrdOpn THEN
    iq_stValve.pv_xOvrdOpn :=FALSE;
    //Log
    fbLogger(sMsg:='Override expired', eSevr:=TcEventSeverity.Warning);
END_IF

(* Release the retained request while the plant-wide override mode is disabled, so a stale FORCE_OPN cannot take
   effect later when the mode is enabled for an unrelated reason.*)
IF NOT iq_stValve.xOverrideMode THEN  iq_stValve.pv_xOvrdOpn :=FALSE; END_IF

(* Qualified and interlock-permitted override output. The open permit is ANDed in, so the override can never force
   the fast shutter open against the vacuum-fault interlock or a non-vetoed trigger.*)
q_xOverrideOpen := tonOvrd.Q AND iq_stValve.xOverrideMode AND iq_stValve.pv_xOvrdOpn AND xOPN_OK;

(* Log an override request that the open permit refuses: the override never replaces the permit.*)
rtOvrdDenied(CLK:= (tonOvrd.Q AND iq_stValve.xOverrideMode AND iq_stValve.pv_xOvrdOpn) AND NOT xOPN_OK);
IF rtOvrdDenied.Q THEN
    fbLogger(sMsg:='Override open request refused, open permit not satisfied, fast shutter stays closed.', eSevr:=TcEventSeverity.Warning);
END_IF
(* Soft IO Mapping*)
IO();
(*Logger*)
ACT_Logger();]]></ST>
    </Implementation>
    <Action Name="ACT_Logger" Id="{1bb1f80f-bfee-4970-bc9f-116f1f77d8f0}">
      <Implementation>
        <ST><![CDATA[// ILK logger

IF i_xTrigger AND ePrevState = OPEN THEN
         fbLogger(sMsg:='Fast valve triggered to close', eSevr:=TcEventSeverity.Critical);
END_IF


//STATE Logger

IF ePrevState <> iq_stValve.eState THEN
      CASE iq_stValve.eState OF
        INVALID:
            fbLogger(sMsg:='Valve invalid position.', eSevr:=TcEventSeverity.Critical);
          MOVING:
            fbLogger(sMsg:='Valve moving', eSevr:=TcEventSeverity.Warning);
        OPEN:
            fbLogger(sMsg:='Valve Open.', eSevr:=TcEventSeverity.Info);
        CLOSED:
            fbLogger(sMsg:='Valve closed.', eSevr:=TcEventSeverity.Info);
      END_CASE
      ePrevState := iq_stValve.eState;
  END_IF



// Log valve timeouts
tErrorPresent(CLK:=iq_stValve.bErrorPresent);
IF tErrorPresent.Q THEN fbLogger(sMsg:=iq_stValve.sErrorMessage, eSevr:=TcEventSeverity.Warning); END_IF

// Log valve open
tAction(CLK:= iq_stValve.q_xOPN_DO);
IF tAction.Q THEN fbLogger(sMsg:='Valve commanded open', eSevr:=TcEventSeverity.Info); END_IF

// Log override mode enabled
tOverrideActivated(CLK:= (tonOvrd.Q AND q_xOverrideMode));
IF tOverrideActivated.Q THEN fbLogger(sMsg:='Valve override mode activated', eSevr:=TcEventSeverity.Warning); END_IF

//Log when the trigger is vetoed
rtTriggerVetoed(CLK:= (NOT q_xPRESS_OK OR i_xTrigger) AND (NOT q_xVetoValveOpenDO AND q_xVetoValveClosed));
IF rtTriggerVetoed.Q THEN fbLogger(sMsg:='Valve triggered while veto device is in', eSevr:=TcEventSeverity.Warning); END_IF

rtTriggered(CLK:= (NOT q_xPRESS_OK OR i_xTrigger) AND ( q_xVetoValveOpenDO AND NOT q_xVetoValveClosed));
IF rtTriggered.Q THEN fbLogger(sMsg:='Fast valve triggered!', eSevr:=TcEventSeverity.Critical); END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="IO" Id="{312ade16-8536-4df0-9a4e-8f0b63330a33}">
      <Implementation>
        <ST><![CDATA[(*inputs*)
iq_stValve.i_xTrigger := i_xTrigger;
iq_stValve.i_xOpnLS := 	i_xVFS_Open;
iq_stValve.i_xClsLS:=	i_xVFS_Closed;
iq_stValve.eVGC_State := i_eVFS_State;
iq_stValve.i_xVAC_FAULT_OK:= i_xVAC_FAULT_OK;
(*output*)
q_xOPN_SW := iq_stValve.pv_xOPN_SW;
q_xCLS_SW:= iq_stValve.xCLS_SW;
q_xVAC_FAULT_Reset :=  iq_stValve.pv_xAlmRst;
q_xOverrideMode :=iq_stValve.xOverrideMode;
(*q_xOverrideOpen is deliberately not mapped here: the qualified, interlock-permitted value is published by the
  override logic in the body, so the raw FORCE_OPN request can never reach the physical output.*)
iq_stValve.sGFS := IG.sPath;

(*update values*)
iq_stValve.xOPN_OK := xOPN_OK;

(*Veto*)
(*VETO Devices*)
q_xVetoValveOpenDO := Veto_Valve.q_xOPN_DO;
q_xVetoValveClosed := Veto_Valve.i_xClsLS;

//reset the commands
IF ( iq_stValve.i_xOpnLS) THEN iq_stValve.pv_xOPN_SW := FALSE; END_IF
IF ( iq_stValve.i_xClsLS) THEN iq_stValve.xCLS_SW := FALSE; END_IF

//Veto device name
iq_stValve.sVetoDeviceName := Veto_Valve.sDevName;
]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>