<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TVGC_2S_ADS" Id="{2d33fb71-254e-4ee8-8b31-f9715402f769}" SpecialFunc="None">
    <Declaration><![CDATA[(* This function block is created for interface devices between different PLC*)
(* Not all the fields in the original structure is required, just few signals *)
(*Use with FB_ADS_WATCHDOG on remotePLC*)
(* The read is bounded by tAdsTimeout (inherited from FB_ADS); expiry raises bAdsTimeOut*)
(* History: 2026-11-27 - explicit ADS read timeout, expiry fault and error edge call*)
(* History: 2026-11-27 - latched fault output (bErrorLatched) with xReset acknowledge (finding #723)*)
FUNCTION_BLOCK FB_TVGC_2S_ADS extends FB_ADS
VAR_INPUT
    sNetId : String; //NetID of the Destination PLC controller
    nPort : UINT; // port number
    sVarName : string;// the variable name of the (device) declared function block.
    iWatchdog:UDINT;//The watchdog variable name written to by the remote plc
    xReset: BOOL; //Acknowledge of the latched ADS fault; a rising edge clears it only while no fault is present
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := 'pv: '}
    VGC:ST_VGC_2S;
    bError:BOOL; //Live fault: ADS read error, ADS read timeout or remote watchdog expiry
    bErrorLatched:BOOL; //Latched fault: set by any bError, cleared only by xReset while the fault is gone
END_VAR
VAR
    fb_CheckWatchdog: FB_CheckWatchdog;
    fb_Read_VGC: FB_ReadAdsSymByName;
    ftReset: F_TRIG;
    xFirstPass: bool:= true;
    rtReset: R_TRIG; //rising edge of xReset, acknowledges the latched fault
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ftReset(CLK:= fb_Read_VGC.bBusy OR xFirstPass);
xFirstPass:=false;
(*calling ADS read function*)
fb_Read_VGC(
    bRead:= ftReset.Q,
    sNetId:= sNetId,
    nPort:= nPort,
    sVarName:= CONCAT(sVarName,'.iq_stValve'),
    nDestAddr:= ADR(VGC),
    nLen:= SIZEOF(VGC),
    tTimeout:= tAdsTimeout,
    eComMode:= eAdsComModeFastCom,
    bBusy=> ,
    bError=> ,
    nErrorId=> );


(*Error*)
fb_CheckWatchdog(
    bEnable:= TRUE,
    tWatchdogTime:= T#900ms,
    nCnt:= iWatchdog ,
    bWatchdog=> ,
    nLastCnt=> );
bError:= fb_Read_VGC.bError OR fb_CheckWatchdog.bWatchdog OR M_AdsTimeout(bBusy:= fb_Read_VGC.bBusy);
tErrorPresent(CLK:= bError);
(*Latched fault: a single failed or timed out read must stay visible after the read recovers, so a
frozen VGC status is never mistaken for a healthy one. Cleared only by a rising edge on xReset and
only while no fault is present*)
rtReset(CLK:= xReset);
IF bError THEN
    bErrorLatched := TRUE;
ELSIF rtReset.Q THEN
    bErrorLatched := FALSE;
END_IF

ACT_Logger();]]></ST>
    </Implementation>
    <Action Name="ACT_Logger" Id="{4dcca01b-a24b-4b1b-865e-ad4d9c835d32}">
      <Implementation>
        <ST><![CDATA[IF tErrorPresent.Q THEN
 IF(fb_Read_VGC.bError) THEN fbLogger(sMsg:='ADS Read Error', eSevr:=TcEventSeverity.Critical); END_IF;
 IF(fb_CheckWatchdog.bWatchdog) THEN fbLogger(sMsg:='ADS Watchdog Error', eSevr:=TcEventSeverity.Critical); END_IF;
 IF(bAdsTimeOut) THEN fbLogger(sMsg:='ADS Read Timeout Error: remote PLC did not complete the ADS read within tAdsTimeout', eSevr:=TcEventSeverity.Critical); END_IF;
END_IF
]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>