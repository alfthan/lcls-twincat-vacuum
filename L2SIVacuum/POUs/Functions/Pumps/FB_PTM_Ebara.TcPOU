<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject>
  <POU Name="FB_PTM_Ebara" Id="{db9fdbdf-85bb-4e58-96cc-808f2a65a0e5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PTM_Ebara
VAR_IN_OUT
    {attribute 'pytmc' := '
    pv:
    '}
    iq_stPTM : ST_EbaraPTM;
END_VAR
VAR_INPUT
    i_iADCBits : UINT := 15; //Number of bits of the analog channel that carries the speed signal
    i_iRawSpeed: INT; //Should come from PLC Soft IO.
    (* Speed readback calibration. The defaults are the named constants of GVL_EbaraParameters;
       they are overridable here so a pump model, ADC channel or controller variant is
       calibrated per instance without editing the calculation. *)
    i_rADCFullScaleVoltage : LREAL := gcEbaraADCFullScaleVoltage; //volts represented by a full-scale ADC reading
    i_rSpeedSpanVoltage : LREAL := gcEbaraSpeedSpanVoltage; //volts spanned by the speed readback
    i_rSpeedMaxRPM : LREAL := gcEbaraSpeedMaxRPM; //rated speed at the top of the readback span
    i_rSpeedMinRPM : LREAL := gcEbaraSpeedMinRPM; //rated speed at the bottom of the readback span
    i_rSpeedZeroDeadbandVoltage : LREAL := gcEbaraSpeedZeroDeadbandVoltage; //volts; readback below this reports zero speed
END_VAR
VAR_OUTPUT

END_VAR
VAR
    TOF_START: TOF := (PT:=T#0.5S); //Manual states momentary switches need to be closed for >= 0.3s
    TOF_STOP: TOF := (PT:=T#0.5S);
    TOF_RESET: TOF :=(PT:=T#0.5S);

    lrADCFullScaleCounts : LREAL; //Raw count of a full-scale ADC reading: 2^ADC bits - 1
    lrSpeedVoltage : LREAL; //Speed readback converted to volts

    (*IO*)

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* Ebara ETC control FB
Purpose : Start/stop, protection and speed readback for an Ebara turbo pump driven by an ETC
          controller. The block reports the pump speed computed from the analog readback in
          iq_stPTM.i_diCurSpd.
Usage   : Command the pump through iq_stPTM (momentary start/stop/reset), feed the analog
          speed readback on i_iRawSpeed and the ADC width on i_iADCBits. The readback
          calibration defaults come from GVL_EbaraParameters and may be overridden through
          the i_r* inputs for a different pump/ADC variant.
Scott Stubbs & Alex W.
2026-11-28: Speed readback calibration declared as named constants (GVL_EbaraParameters)
            instead of embedded literals - audit finding 665, task 420.
*)

(* Switch processing *)
TOF_START.IN := iq_stPTM.i_xStart;
TOF_START();
TOF_STOP.IN  := iq_stPTM.i_xStop;
TOF_STOP();
TOF_RESET.IN := iq_stPTM.xReset;
TOF_RESET();

//Normally closed fault handling
iq_stPTM.i_xFault := NOT iq_stPTM.i_xNCFault;

(* Simple protection reset *)
IF iq_stPTM.xExtRunOk THEN
    iq_stPTM.q_xProtection:=TRUE;
END_IF

(* Basic pump supervisory section *)
    (* If override mode, ignore everything else *)
IF iq_stPTM.i_xOverride THEN
    IF TOF_START.Q THEN
    iq_stPTM.q_RunDO:=TRUE;
    ELSIF TOF_STOP.Q THEN
        iq_stPTM.q_RunDO:=FALSE;
    END_IF
    //Handle faults - the way the Ebara cable is done, xFault is normally closed
ELSIF iq_stPTM.i_xFault OR (iq_stPTM.q_RunDO AND NOT iq_stPTM.xExtRunOk) THEN
    iq_stPTM.q_RunDO:=FALSE;
    iq_stPTM.q_xProtection:=FALSE;
    //And one for when we need to start the pump normally. Only allows pump to be started if ILK ok.
ELSIF TOF_START.Q AND iq_stPTM.xExtRunOk THEN
    iq_stPTM.q_RunDO:=TRUE;
    iq_stPTM.q_xStart:=TOF_START.Q;
//One section for when pump is told to stop
ELSIF TOF_STOP.Q THEN
        iq_stPTM.q_RunDO:=FALSE;
END_IF

iq_stPTM.q_xReset:=TOF_RESET.Q; //No need for a conditional on these, code below takes care of it
iq_stPTM.q_xStop:=TOF_STOP.Q;
//Reset the start switch after processing
IF iq_stPTM.q_RunDO THEN
    iq_stPTM.q_xStart := TOF_START.Q;
END_IF

(* Pump speed calculation *)
(* Raw count -> volts across the ADC span (i_rADCFullScaleVoltage), then volts across the pump
   readback span (i_rSpeedSpanVoltage) -> RPM across the rated speed span
   (i_rSpeedMaxRPM - i_rSpeedMinRPM). With the GVL_EbaraParameters defaults this is
   (33600 - 100) / 5 * 10 = 67000 RPM at a full-scale ADC reading.
   Below i_rSpeedZeroDeadbandVoltage the readback is noise around zero, so report zero speed. *)
lrADCFullScaleCounts := EXPT(2, i_iADCBits) - 1;
lrSpeedVoltage := iq_stPTM.i_iRawSpeed / lrADCFullScaleCounts * i_rADCFullScaleVoltage;
IF lrSpeedVoltage >= i_rSpeedZeroDeadbandVoltage THEN
    iq_stPTM.i_diCurSpd := LREAL_TO_DINT(lrSpeedVoltage / i_rSpeedSpanVoltage * (i_rSpeedMaxRPM - i_rSpeedMinRPM));
ELSE
    iq_stPTM.i_diCurSpd := 0;
END_IF]]></ST>
    </Implementation>
    <Action Name="ACT_IO" Id="{75fa05c8-b87a-4b36-93fe-dc680536a088}">
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>
