<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ScrollPump" Id="{95800034-a8e9-430e-af6e-1fa7a649fe90}" SpecialFunc="None">
    <Declaration><![CDATA[(* This Function block provides basic  control for Scroll Pumps *)
(* Turn on scroll pump if the Turbo Vent Valve is closed. *)
(* Cannot turn off scroll pump if turb is running. delay scroll off 150s.*)

FUNCTION_BLOCK FB_ScrollPump
VAR_IN_OUT

END_VAR
VAR_OUTPUT
    (* Roughing-pump control/status interface published to EPICS.
       The pv name is deliberately left empty: pytmc builds the record
       prefix from the FB instance's own pragma (e.g. 'pv: L2SI:VAC:PFO:01'
       on the instance in the PLC project's GVL) and the record name from
       the pv of the matching ST_RoughPump member (RUN_SW, RUN_DO, ILK_OK,
       AT_SPD, WARN, ERROR, STATE). Each of those members declares the io
       direction of its own PV; the io: io declared here is the direction of
       this interface as a whole, which carries both an EPICS command
       (RUN_SW is io) and readbacks, and it only applies to a member that
       declares no io of its own. Naming this container would insert an
       extra path segment and rename every published pump PV
       (<inst>:RUN_SW -> <inst>:PFO:RUN_SW). *)
    {attribute 'pytmc' := '
    pv:
    io: io;
    '}
    iq_stPFO	:	ST_RoughPump;
END_VAR
VAR_INPUT
    TurboIsON : BOOL;
    xExtIlk : BOOL;
END_VAR
VAR
    Tmr_TOF : TOF;
    tTimerDuration : Time:= T#150S;
    //Previous_RunSW : BOOL;
    // Digital Output to be linked
    (* Hardware run command readback. The EPICS command/readback pair lives
       on iq_stPFO (RUN_SW / RUN_DO); this pragma publishes the state of the
       physical %Q output itself, so it needs a record name of its own -
       reusing RUN_DO would emit a duplicate record under the instance
       prefix. io: i because the output is driven by the PLC, never by EPICS. *)
    {attribute 'pytmc' := '
    pv: RUN_OUT;
    io: i;
    field: ZNAM FALSE;
    field: ONAM TRUE;
    field: DESC Hardware run digital output linked to the pump drive;
    '}
    q_xRunDo AT%Q*	:   BOOL;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Turn on scroll pump if the Turbo Vent Valve is closed. So you are not just
// pumping air and accomplishing nothing

// cannot turn off scroll pump if turb is running. delay scroll off 150s.
iq_stPFO.xIlkOK := xExtIlk;// and NOT Tmr_TOF.Q;

Tmr_TOF(IN:=TurboIsON, PT := tTimerDuration);

IF iq_stPFO.xIlkOK THEN
    iq_stPFO.q_xRunDo := (Tmr_TOF.Q OR iq_stPFO.pv_xRunSW);
ELSE
    iq_stPFO.q_xRunDo := FALSE;
END_IF

iq_stPFO.pv_xRunSW := iq_stPFO.q_xRunDo;

(*State evaluation*)
IF NOT iq_stPFO.q_xRunDo THEN
    iq_stPFO.eState := pumpSTOPPED;
ELSE
    iq_stPFO.eState := pumpRUNNING;
END_IF

(*soft io Mapping*)
IO();



 ]]></ST>
    </Implementation>
    <Action Name="IO" Id="{47ae7053-5350-4e8f-94b2-400e5380039f}">
      <Implementation>
        <ST><![CDATA[q_xRunDo:= iq_stPFO.q_xRunDo;]]></ST>
      </Implementation>
    </Action>
    <Method Name="M_Run" Id="{eba797a4-1012-42f7-b194-fa0d2f89ba57}">
      <Declaration><![CDATA[METHOD PUBLIC M_Run : BOOL
VAR_INPUT
    run:bool; // set to true to run, false to stop;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
this^.iq_stPFO.pv_xRunSW := run;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>