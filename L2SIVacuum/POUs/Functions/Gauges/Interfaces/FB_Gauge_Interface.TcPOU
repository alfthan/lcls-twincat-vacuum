<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Gauge_Interface" Id="{1ed0a657-4e26-4a4b-9434-968a1918180c}" SpecialFunc="None">
    <Declaration><![CDATA[(* This function block is created for interface devices between different PLC*)
(* Not all the Variables in the original structure is required, just few signals *)
(* They have to be linked to the custom created variables on the EL6692/5 primary side*)
FUNCTION_BLOCK FB_Gauge_Interface
VAR_INPUT
END_VAR
VAR_OUTPUT
    (* Gauge status interface published to EPICS.
       The pv name is deliberately left empty: pytmc builds each record
       name from the pv of the matching ST_VG member (PRESS, AT_VAC,
       PRESS_OK, STATE, HV_SW, VAC_SP, ...) and takes the record prefix
       from the pytmc pragma of the instance that declares this block, so
       the one library block serves every gauge interface. Naming this
       container would insert an extra path segment and rename every
       published gauge PV.
       The io declared here is 'i' (read-only) because the block copies
       the status it receives from the partner PLC into the struct each
       scan. ST_VG members that are real EPICS controls (HV_SW, Auto_On,
       VAC_SP, PRO_SP, SP_HYS, LOGGER) declare their own io: io there and
       keep it: a member's pragma overrides this container default. *)
    {attribute 'pytmc' := '
    pv:
    io: i;
    field: DESC Gauge interface status copied from the partner PLC;
    '}
    VG : ST_VG;
END_VAR
VAR
    i_rPRESS AT%I*: REAL;
    i_xAT_VAC AT%I*: BOOL;
    i_xPRESS_OK AT%I*: BOOL;
    i_sPath AT%I* : STRING;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* This function block is created for interface devices between different PLC*)
(* Not all the Variables in the original structure is required, just few signals *)
(* They have to be linked to the custom created variables on the EL6692/5 primary side*)

VG.rPRESS := i_rPRESS;
VG.xAT_VAC := i_xAT_VAC;
VG.xPRESS_OK := i_xPRESS_OK;
VG.sPath := i_sPath;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>