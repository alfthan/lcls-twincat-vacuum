<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ITR90" Id="{d1491968-690d-4aa1-ab30-fd64b81089f0}" SpecialFunc="None">
    <Declaration><![CDATA[(* This function block implements the Oerlikon Leybold IONVAC Hot Cathode ITR 90.
   Usage: link i_iPRESS_R to the 0..10 V analog input of the gauge controller and
   read pressure, state and setpoint flags from the PG interface struct.
   Objectives: convert the raw terminal bits into a pressure, classify the reading
   into the ITR 90 validity window and maintain the AT_VAC setpoint comparison.
   The transfer function and validity limits come from the named constants in
   GVL Constants so the gauge can be re-scaled in one place.
   History:
     2026-11-27 - replaced bare scaling/validity literals with the named constants
                  in GVL Constants and defaulted M_SetBits from the same constant.
*)
FUNCTION_BLOCK FB_ITR90
VAR_INPUT
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
    pv:
    '}
    PG : ST_VG;
END_VAR
VAR
    rV : REAL;	// input voltage
    rC: REAL := -0.125; // a constant in the manual (pressure unit dependent)
    rK: REAL := 1.0;// Calibration factor C (gas type dependent)
    iTermBits: UINT := gc_uiDefaultTermBits; // The terminal's maximum value in bits
    (*IO*)
    i_iPRESS_R AT%I* :INT; // input Pressure // Link to analog Input
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* This function block implements the Oerlikon Leybold IONVAC Hot Cathode ITR 90 *)
(* All hardware scaling and validity limits are named constants in GVL Constants *)

(* Real-value calculation *)
(* ITR 90 transfer function from the manual: p = 10^((rV - offset)/slope + rC) * rK *)

rV := gc_rITR90FullScaleV*INT_TO_REAL(PG.i_iPRESS_R)/iTermBits;
PG.rPRESS := (LREAL_TO_REAL(EXPT(10,(rV-gc_rITR90TransferOffsetV)/gc_rITR90VoltsPerDecade+rC))) * rK;


(* Pressure gauge State checks *)

//IF (rV <=9.7 ) AND (rV>=1) THEN
    //PG.eState := Valid; // normal
IF rV >= gc_rITR90MinValidV AND rV <= gc_rITR90LoHiSplitV THEN
    PG.eState := ValidLo; //LO
ELSIF rV > gc_rITR90LoHiSplitV AND rV <= gc_rITR90MaxValidV THEN
    PG.eState := ValidHi; //HIGH
ELSIF rV < gc_rITR90MinValidV THEN
    PG.eState := GaugeDisconnected; //not on
ELSE
    PG.eState := PressInvalid; //other fault - could be no gauge, controller powering up etc
END_IF



(* Pressure gauge OK checks *)
PG.xPRESS_OK := (rV <= gc_rITR90MaxValidV) AND (rV >= gc_rITR90MinValidV);


(* Setpoint evaluation *)
PG.xAT_VAC := PG.xPRESS_OK AND PG.rPRESS < PG.rVAC_SP;


(*Soft IO Linking*)
ACT_IO();
]]></ST>
    </Implementation>
    <Action Name="ACT_IO" Id="{81c379a6-172c-4570-83b8-3e8d0fcae295}">
      <Implementation>
        <ST><![CDATA[PG.i_iPRESS_R :=i_iPRESS_R;]]></ST>
      </Implementation>
    </Action>
    <Method Name="M_SetBits" Id="{2b56ae4c-1065-4c58-8da0-22d0f327520b}">
      <Declaration><![CDATA[METHOD M_SetBits : BOOL
VAR_INPUT
    TermBits : UINT; // The terminal's maximum value in bits
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Fall back to the configured default when no terminal width is supplied *)
IF TermBits = 0 THEN
    TermBits := gc_uiDefaultTermBits;
END_IF
This^.iTermBits := TermBits;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>