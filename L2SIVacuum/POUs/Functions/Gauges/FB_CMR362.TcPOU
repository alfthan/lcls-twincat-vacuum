<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_CMR362" Id="{829c6b91-5e76-4127-a78c-3990b7df60a3}" SpecialFunc="None">
    <Declaration><![CDATA[(* FB_CMR362 - Pfeiffer CMR 362 analog (0 - 10 V) gauge
   Introduction:
       Converts the CMR 362 analog output voltage into a pressure in Torr and classifies the reading
       (Valid / ValidLo / GaugeDisconnected / OoR) for the surrounding vacuum logic.
   Usage:
       Call once per cycle with the analog input wired to i_iPRESS_R; the whole device state is
       published through the PG interface struct (ST_VG). Call M_SetBits when the analog terminal
       does not deliver a 16 bit full-scale value.
   Objectives:
       * Keep the analog scaling and the range boundaries in one place: they are declared as the
         named gc_rCMR362* constants in GVL_PfeifferParameters, so a CMR 362 span or calibration
         change is a single edit per value instead of a search through the conversion logic.
   History:
       2026-11-27 (taio-generic-0) - Replaced the embedded 10 V, 0.4 V / 1.0 V / 9.8 V and 0.125
                                    literals with the named gc_rCMR362* constants. No behaviour change.
*)
FUNCTION_BLOCK FB_CMR362
VAR_INPUT
END_VAR
VAR_OUTPUT
        {attribute 'pytmc' := 'pv:'}
        PG : ST_VG;
END_VAR
VAR
    (* Calibration parameters - override per instance for a different CMR 362 full scale *)
    MinPressure : REAL := 7.5E-3; //Torr, lowest pressure the gauge reports (fixed below-range output)
    FullScale : REAL := 75.0; //Torr, pressure at the top of the measuring range (gc_rCMR362VoltageValidHiMax)
    V : REAL; //V, gauge output voltage derived from the raw analog input
    iTermBits : UINT := 32767 ; // The terminal's maximum value in bits
    (*IO*)
    i_iPRESS_R AT%I* :INT; // input Pressure // Link to analog Input
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
(* FB_CMR362 - Pfeiffer CMR 362 analog (0 - 10 V) gauge *)
(*Soft IO Mapping*)
ACT_IO();

(* Real-value calculation *)
If (iTermBits=0) THEN iTermBits := 32767;END_IF
V := gc_rCMR362VoltageSpan*INT_TO_REAL(PG.i_iPRESS_R)/iTermBits;

(* Classify the reading on the gauge output voltage *)
IF V < gc_rCMR362VoltageDisconnected THEN

    PG.eState := GaugeDisconnected; //Most likely not connected

ELSIF V >= gc_rCMR362VoltageDisconnected AND V <= gc_rCMR362VoltageValidLoMax THEN
    PG.rPRESS := MinPressure;
    PG.eState := ValidLo;

ELSIF V > gc_rCMR362VoltageValidLoMax AND V <= gc_rCMR362VoltageValidHiMax THEN

    PG.rPRESS := LREAL_TO_REAL((V-gc_rCMR362VoltageValidLoMax)*gc_rCMR362PressureSpanFactor*FullScale);
    PG.eState := Valid;

ELSE

PG.eState := OoR; //Larger voltage, probably out of range?

END_IF


(* Pressure OK check *)
PG.xPRESS_OK := (PG.rPRESS >= MinPressure);

(*Soft IO Mapping*)
ACT_IO();

]]></ST>
    </Implementation>
    <Action Name="ACT_IO" Id="{f7bdedec-d365-42ba-8021-29225073f9cd}">
      <Implementation>
        <ST><![CDATA[PG.i_iPRESS_R :=i_iPRESS_R;]]></ST>
      </Implementation>
    </Action>
    <Method Name="M_SetBits" Id="{945a4b7c-0383-4407-a003-10a045f5720a}">
      <Declaration><![CDATA[METHOD M_SetBits : BOOL
VAR_INPUT
    TermBits : UINT; // The terminal's maximum value in bits
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[This^.iTermBits := TermBits;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>