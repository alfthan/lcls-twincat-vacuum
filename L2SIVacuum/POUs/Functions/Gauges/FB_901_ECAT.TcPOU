<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_901_ECAT" Id="{84706132-589d-4d51-8b00-ab55510b97b2}" SpecialFunc="None">
    <Declaration><![CDATA[(* works for 901 with Ethercat interface*)
(* The raw EtherCAT analog PDO is routed through the common sanitizer before it is published or
   scaled: NaN/Inf and out-of-span values are rejected, the last trusted pressure is held and
   PG.xPRESS_VALID reports whether PG.rPRESS is a fresh measurement.
   2026-11-27 - author: LCLS ECS-Platforms - added external value sanitization (finding #601). *)
{attribute 'no_check'}
FUNCTION_BLOCK FB_901_ECAT  EXTENDS FB_GaugeBase
VAR_INPUT
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
    pv:
    '}
    PG	: ST_VG;
END_VAR
VAR_IN_OUT

END_VAR
VAR
    bInit: BOOL:= TRUE;(*IO*)
    xPress_OK AT%I* : BOOL;
    xOverrange AT%I* : BOOL;
    xUnderrange AT%I* : BOOL;
    i_iPRESS_R AT%I* : REAL; // input Pressure // Link to analog Input
    bWcstate AT%I* : BOOL; // 0: date valid, 1: date invalid
    fbPressSanitizer : FB_ValueSanitizer; // sanitizes the EtherCAT pressure PDO

END_VAR
VAR CONSTANT
    c_rMinPress : REAL := 0.0; // Lowest plausible pressure in Torr; smaller values are rejected
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* Standard MKS 9XX series conversion *)
(* works for 901 with Ethercat interface*)
(* Sanitize the analog PDO: the terminal WC state, NaN/Inf and the configured span are checked
   and the last trusted pressure is held while the sample is invalid *)
fbPressSanitizer(
    i_lrValue := i_iPRESS_R,
    i_xSourceValid := NOT bWcstate,
    i_lrMin := c_rMinPress,
    i_lrMax := PG.rFULL_SCALE,
    i_sName := sPath);

(* publish only the sanitized value - a bad PDO never publishes a false 0 pressure *)
PG.rPRESS := LREAL_TO_REAL(fbPressSanitizer.q_lrValue);
PG.xPRESS_VALID := fbPressSanitizer.q_xValid;
PG.xPRESS_OK := xPress_OK AND NOT bWcstate AND fbPressSanitizer.q_xValid;
IF PG.xPRESS_OK THEN
    PG.eState := Valid; //Press OK
ELSIF xOverrange and NOT bWcstate THEN
    PG.eState := OoR;
ELSIF xUnderrange and NOT bWcstate THEN
    PG.eState := PressInvalid;

END_IF



(*Logger*)
ACT_Logger();
(* Soft IO Mapping*)
ACT_IO();]]></ST>
    </Implementation>
    <Action Name="ACT_Init" Id="{79fc3e26-9526-4887-bb81-9ff0cb209da7}">
      <Implementation>
        <ST><![CDATA[IF (bInit) THEN
    bInit := False;

    //set pressure units to Torr
    // value 0x00A10000 SDO index 0xf840, si 0x01 UDINT
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="ACT_IO" Id="{afe7d8e6-827d-4f4d-895b-401bfcc2f6f0}">
      <Implementation>
        <ST><![CDATA[
(* scale only a sanitized, clamped value; while the PDO is invalid both the pressure and its
   scaled image keep their last trusted value and PG.xPRESS_VALID reports the held state *)
IF PG.xPRESS_OK THEN
    PG.i_iPRESS_R := REAL_TO_INT(LIMIT(c_rMinPress, PG.rPRESS, PG.rFULL_SCALE));
END_IF
PG.sPath := sPath;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ACT_Logger" Id="{4887216a-c77e-43cb-a418-2b8dd97c0d8a}">
      <Implementation>
        <ST><![CDATA[
//STATE Logger
IF ePrevState <> PG.eState THEN
      CASE PG.eState OF
        ValidHi:
            fbLogger(sMsg:='Gauge pressure valid high.', eSevr:=TcEventSeverity.Info);
        ValidLo:
            fbLogger(sMsg:='Gauge pressure valid low.', eSevr:=TcEventSeverity.Info);
        Valid:
            fbLogger(sMsg:='Gauge pressure valid.', eSevr:=TcEventSeverity.Info);
          GaugeDisconnected:
            fbLogger(sMsg:='Gauge Disconnected.', eSevr:=TcEventSeverity.Critical);
        PressInvalid:
            fbLogger(sMsg:='Gauge pressure invalid.', eSevr:=TcEventSeverity.Warning);
        OoR:
            fbLogger(sMsg:='Gauge pressure out of range.', eSevr:=TcEventSeverity.Warning);
        Starting:
            fbLogger(sMsg:='Gauge starting.', eSevr:=TcEventSeverity.Info);
      END_CASE
      ePrevState := PG.eState;
  END_IF


]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>