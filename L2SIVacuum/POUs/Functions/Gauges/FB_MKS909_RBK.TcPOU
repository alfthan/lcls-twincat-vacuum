<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MKS909_RBK" Id="{e4d3e807-daeb-4a47-bccf-64bd129edfcd}" SpecialFunc="None">
    <Declaration><![CDATA[(* Standard MKS 909 hot cathode with gauge on reedback*)
(* works for 972 and 925 *)
(*
    Purpose : MKS 909 hot cathode with the gauge-on feedback (works for the 972 and
              925 controllers). Converts the analog pressure input to Torr, evaluates
              the at-vacuum setpoint and gates the ion gauge high voltage on the
              pirani pressure, only while the gauge reports power.
    Usage   : call once per PLC cycle with PG wired to the associated pirani gauge
              and IG wired to the ion gauge EPICS/IO interface.
    Objectives:
              - gauge state and pressure conversion as per the MKS manual
              - the externally supplied setpoints (VAC_SP, PRO_SP, SP_HYS) are
                clamped into the declared span [rMinPressure, rMaxPressure] before
                they feed the AT_VAC comparison or the HV permit; out-of-range
                requests are rejected, logged and force the HV permit off
    History : 2026-11-27 validate/clamp the gauge setpoints against rMinPressure and
              rMaxPressure, reject and log out-of-range requests and force a safe
              HV state while they are invalid (audit findings #969, #1199)
*)

FUNCTION_BLOCK FB_MKS909_RBK EXTENDS FB_GaugeBase

VAR_INPUT
    PG	: ST_VG;
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
    pv:
    '}
    IG	: ST_VG;
END_VAR
VAR_IN_OUT

END_VAR
VAR
    rV : REAL;
    rMaxPressure	:	REAL := 5E-2; //Torr - top of the gauge span, setpoints are clamped to it
    rMinPressure	:	REAL := 1E-10; //Torr - bottom of the gauge span, setpoints are clamped to it
    rOffPressure	:	REAL := 0.0;
    timer:TON;
    (*Default set point 50 mT*)
    rDefaultVAC_SP: REAL := 9E-3; // as per manual
    iTermBits: UINT := 30518 ; // The terminal's maximum value in bits default el3174 as per vacuum architecture
    (* Setpoint validation: externally supplied setpoints are clamped into
       [rMinPressure, rMaxPressure] before they drive the AT_VAC comparison or the
       ion gauge HV permit *)
    rVAC_SPReq : REAL;           // requested at-vacuum setpoint before validation [Torr]
    rVAC_SPPGFallback : REAL;    // validated PG.rVAC_SP request, used when the ion gauge setpoint is unset [Torr]
    rVAC_SPCmd : REAL;           // validated at-vacuum setpoint used by the AT_VAC comparison [Torr]
    rPRO_SPCmd : REAL;           // validated protection setpoint used by the HV permit [Torr]
    rHYS_PRCmd : REAL;           // validated protection hysteresis used by the HV release [Torr]
    rHVRelease_PR : REAL;        // validated HV release threshold, PRO_SP + SP_HYS clipped to the span [Torr]
    xSPValid : BOOL := TRUE;     // TRUE when every requested setpoint is inside the gauge span
    xSPValidPrev : BOOL := TRUE; // previous value of xSPValid, for edge triggered diagnostics
    sSPFault : T_MaxString;      // names of the setpoints rejected on the current scan
    (*IO*)
    i_iPRESS_R AT%I* :INT; // input Pressure // Link to analog Input
    q_xHV_DIS AT %Q* : BOOL := TRUE; // Active Low
    i_xGauge_ON AT %I*	: BOOL; //  True when gauge has power  // 'TcLinkTo' (EL1084) ^Input

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* Standard MKS 9XX series conversion *)
(* works for 972 and 925 *)

(* Validate/clamp the externally supplied setpoints before they are used *)
ACT_ValidateSetpoints();

// check no div by zero
If (iTermBits=0) THEN iTermBits := 30518;END_IF
rV := 10*INT_TO_REAL(IG.i_iPRESS_R)/iTermBits;

(* Pressure OK check *)
// Gauge state
// Is the gauge plugged in, and within a reasonable range?
IF i_xGauge_ON THEN
    IF  (rV >= 0.1 AND rV <=8.7) THEN // as per manual
        IG.rPRESS := LREAL_TO_REAL(EXPT(10, rV-10));
        IG.eState := Valid;
        IG.xPRESS_OK := TRUE; //Backwards compatibility
    ELSIF rV > 8.7 AND rV < 10 THEN
        IG.rPRESS :=rOffPressure;
        IG.xPRESS_OK := FALSE;
        IG.eState := Off;
    ELSE
        IG.rPRESS := rOffPressure;
        IG.xPRESS_OK := FALSE;
        IG.eState := OoR;
    END_IF
ELSE
    IG.rPRESS := rOffPressure;
    IG.xPRESS_OK := FALSE;
    IG.eState := GaugeDisconnected;
END_IF


(* Ion gauge HV permit: only when every setpoint is valid and the pirani pressure is
   below the validated protection setpoint *)
IF NOT xSPValid THEN
    (* Rejected setpoint, force the not permitted state: high voltage off *)
         IG.q_xHV_DIS := FALSE;
         IG.xHV_SW := FALSE;
         IG.xILKOk := FALSE;
    ELSIF (PG.rPRESS <= rPRO_SPCmd) AND (PG.xPRESS_OK) THEN
         IG.q_xHV_DIS := IG.xHV_SW;
         IG.xILKOk := TRUE;
    ELSIF NOT IG.q_xHV_DIS AND timer.Q THEN
        IF IG.rPRESS > rHVRelease_PR OR PG.rPRESS > rHVRelease_PR THEN
        IG.q_xHV_DIS := FALSE;
        IG.xHV_SW := FALSE;
        END_IF
    ELSE
        IG.q_xHV_DIS := FALSE;
        IG.xHV_SW := FALSE;
        IG.xILKOk := FALSE;
     END_IF


timer(IN:= NOT IG.q_xHV_DIS, PT:= T#2s);

(* Setpoint evaluation: a rejected setpoint never reports at vacuum *)
IG.xAT_VAC := xSPValid AND IG.xPRESS_OK AND (IG.rPRESS < rVAC_SPCmd);

(*Soft IO Mapping*)
ACT_IO();
(*Load or save the persistent variables*)
ACT_Persistent();

(*Logger*)
THIS^.ACT_Logger();

(*Load or save the persistent variables*)
ACT_Persistent();
]]></ST>
    </Implementation>
    <Action Name="ACT_IO" Id="{89c7028d-3190-45b7-aaec-73bdcb00e265}">
      <Implementation>
        <ST><![CDATA[(*soft link inputs*)
IG.i_iPRESS_R:=	i_iPRESS_R;

(*soft link outputs*)
q_xHV_DIS := IG.q_xHV_DIS;]]></ST>
      </Implementation>
    </Action>
    <Action Name="ACT_Logger" Id="{c289ef5c-0d6d-44e6-b87e-b28bbd141dbf}">
      <Implementation>
        <ST><![CDATA[// Setpoint validation: report rejected requests and their recovery
IF xSPValid <> xSPValidPrev THEN
    IF xSPValid THEN
        fbLogger(sMsg:='Gauge setpoints back inside the span, HV permit restored.', eSevr:=TcEventSeverity.Info);
    ELSE
        fbLogger(sMsg:=CONCAT('Gauge setpoint out of range, HV disabled: ', sSPFault), eSevr:=TcEventSeverity.Warning);
    END_IF
    xSPValidPrev := xSPValid;
END_IF

// ILK logger
IF NOT IG.xILKOk AND NOT IG.q_xHV_DIS THEN
         fbLogger(sMsg:='Lost external interlock while gauge was on.', eSevr:=TcEventSeverity.Critical);
END_IF


// Log Action
tAction(CLK:=  IG.q_xHV_DIS);
IF tAction.Q THEN fbLogger(sMsg:='Ion gauge commanded to switch on', eSevr:=TcEventSeverity.Info); END_IF



//STATE Logger
IF ePrevState <> IG.eState THEN
      CASE IG.eState OF
        ValidHi:
        ValidLo:
        Valid:
            fbLogger(sMsg:='Gauge pressure valid.', eSevr:=TcEventSeverity.Info);
          GaugeDisconnected:
            fbLogger(sMsg:='Gauge Disconnected.', eSevr:=TcEventSeverity.Critical);
        PressInvalid:
            fbLogger(sMsg:='Gauge pressure invalid.', eSevr:=TcEventSeverity.Warning);
        OoR:
            fbLogger(sMsg:='Gauge pressure out of range.', eSevr:=TcEventSeverity.Warning);
        Starting:
            fbLogger(sMsg:='Gauge starting.', eSevr:=TcEventSeverity.Info);
      END_CASE
      ePrevState := IG.eState;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="ACT_Persistent" Id="{ba42c9e0-fb4b-4426-98a9-0712e0f03714}">
      <Implementation>
        <ST><![CDATA[(*On first PLC pass, load the persistent value into the structrue variable*)
IF (SUPER^.bRestorePersistentData) THEN
    SUPER^.bRestorePersistentData	:= FALSE;
    IF ( rVAC_SP <> 0) THEN
        IG.rVAC_SP := rVAC_SP;
    END_IF;
    IF ( rPRO_SP <> 0) THEN
        IG.rPRO_SP := rPRO_SP;
    END_IF;
    IF ( rHYS_PR <> 0) THEN
        IG.rHYS_PR := rHYS_PR;
    END_IF;
END_IF
(*Check if a new value has been written in the structure variable copy it to the persistent variable*)
IF NOT (IG.rVAC_SP = rVAC_SP)  THEN
    rVAC_SP := IG.rVAC_SP;
END_IF;

IF NOT (IG.rPRO_SP = rPRO_SP) THEN
    rPRO_SP:= IG.rPRO_SP;
END_IF;

IF NOT (IG.rHYS_PR = rHYS_PR) THEN
    rHYS_PR:= IG.rHYS_PR;
END_IF;]]></ST>
      </Implementation>
    </Action>
    <Action Name="ACT_ValidateSetpoints" Id="{a4d7e690-2b51-4c8f-9e63-5d1f7a2c8b04}">
      <Implementation>
        <ST><![CDATA[(* Clamp the externally supplied pressure setpoints into the gauge span
   [rMinPressure, rMaxPressure]. A zero at-vacuum request means 'not configured' and falls
   back to the manual default; every other out-of-range or non-numeric request is rejected
   (xSPValid = FALSE), which forces the HV permit off in the main body. The clamped copies
   are used internally, the requested values are left untouched so that a rejected request
   stays visible through EPICS. *)
xSPValid := TRUE;
sSPFault := '';

(* PG at-vacuum setpoint: legacy request, zero means unset *)
rVAC_SPReq := PG.rVAC_SP;
IF rVAC_SPReq = 0 THEN
    rVAC_SPReq := rDefaultVAC_SP;
END_IF
rVAC_SPPGFallback := M_ValidateSetpoint(rRequest := rVAC_SPReq, rFallback := rDefaultVAC_SP, sName := 'PG.rVAC_SP');

(* AT_VAC setpoint: the ion gauge setpoint is authoritative, the validated PG request is
   the fallback when the ion gauge setpoint is unset *)
rVAC_SPReq := IG.rVAC_SP;
IF rVAC_SPReq = 0 THEN
    rVAC_SPReq := rVAC_SPPGFallback;
END_IF
rVAC_SPCmd := M_ValidateSetpoint(rRequest := rVAC_SPReq, rFallback := rDefaultVAC_SP, sName := 'IG.rVAC_SP');

(* Protection setpoint and hysteresis: the HV permit and the HV release threshold *)
rPRO_SPCmd := M_ValidateSetpoint(rRequest := IG.rPRO_SP, rFallback := rMinPressure, sName := 'IG.rPRO_SP');
rHYS_PRCmd := M_ValidateSetpoint(rRequest := IG.rHYS_PR, rFallback := rMinPressure, sName := 'IG.rHYS_PR');

(* The release threshold must stay inside the gauge span as well *)
rHVRelease_PR := MIN(rMaxPressure, rPRO_SPCmd + rHYS_PRCmd);]]></ST>
      </Implementation>
    </Action>
    <Method Name="M_AutoOn" Id="{6fde0073-91f6-4cb9-bbee-4ff5715804d3}">
      <Declaration><![CDATA[METHOD M_AutoOn : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[this^.IG.q_xHV_DIS:= FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SetBits" Id="{a0b5c519-56d7-42f9-be00-fe9985112627}">
      <Declaration><![CDATA[METHOD M_SetBits : BOOL
VAR_INPUT
    TermBits : UINT; // The terminal's maximum value in bits
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[This^.iTermBits := TermBits;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ValidateSetpoint" Id="{c92b5e17-81d3-4a6f-bc4e-0e7a3f9d16b2}">
      <Declaration><![CDATA[(* Clamp one externally supplied pressure setpoint into [rMinPressure, rMaxPressure].
   Returns the request itself when it is inside the span, the matching span limit when it
   is out of range, or rFallback when the request is not a number. Every rejected request
   clears xSPValid (which disables the HV permit) and adds sName to sSPFault so that the
   caller can report it. *)
METHOD M_ValidateSetpoint : REAL
VAR_INPUT
    rRequest : REAL;    // requested setpoint [Torr]
    rFallback : REAL;   // value used when the request is not a number [Torr]
    sName : STRING;     // setpoint name for the diagnostics message
END_VAR
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_ValidateSetpoint := rRequest;

IF (rRequest <> rRequest) THEN // NaN: not a usable number, fall back to a sane value
    M_ValidateSetpoint := rFallback;
ELSIF (rRequest < rMinPressure) THEN
    M_ValidateSetpoint := rMinPressure;
ELSIF (rRequest > rMaxPressure) THEN
    M_ValidateSetpoint := rMaxPressure;
ELSE
    RETURN;
END_IF

(* Request rejected, make sure the HV permit cannot be satisfied and name the culprit *)
xSPValid := FALSE;
IF sSPFault = '' THEN
    sSPFault := sName;
ELSE
    sSPFault := CONCAT(sSPFault, CONCAT(', ', sName));
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>