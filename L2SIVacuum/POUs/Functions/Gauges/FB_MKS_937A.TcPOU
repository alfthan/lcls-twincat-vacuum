<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MKS_937A" Id="{0483146b-b0e8-4c2d-b90b-7317630633a1}" SpecialFunc="None">
    <Declaration><![CDATA[(* 937A Logarithmic Output Conversion *)
(* 7-15-2015 *)
(* This function will read the pressure from any gauge on a 937A. *)
(* To be used when the specific device function block is not available *)
(* Usage: link i_iPRESS_R to the 0..10 V analog input that carries the 937A logarithmic pressure
   output and read pressure, state, xPRESS_OK and the set point flags from the VG interface struct;
   PG carries the Pirani gauge used for the ion gauge protection and HV disable logic. *)
(* Objectives: convert the raw terminal counts into a terminal voltage, apply the 937A logarithmic
   transfer function, classify the reading into the 937A validity windows and maintain xPRESS_OK,
   the HV disable output and xAT_VAC. *)
(* The hardware dependent scaling and the cross-cutting limits are named constants in GVL Constants
   (gc_uiMKS937ATermBits, gc_rMKS937AFullScaleVolts, gc_rMKS937ALogLawBase, gc_rMKS937AVoltsPerDecade,
   gc_rMKS937AExponentOffset, gc_rMKS937AValidMinVolts, gc_rMKS937AValidMaxVolts, gc_rMKS937ALoBandMinVolts,
   gc_rMKS937ALoBandMaxVolts, gc_rMKS937AHiBandMinVolts, gc_rMKS937AHiBandMaxVolts) and are referenced
   by name only, so a different terminal resolution, a re-ranged transmitter or a corrected vendor
   curve is a one-line edit in that list instead of an edit of this logic. *)
(* History:
     2015-07-15 - 937A logarithmic output conversion
     2026-11-27 - the conversion and state window literals (32767 counts, the 10 V span, the
                  10 ^ (V / 0.6 - 12) transfer function and the 0.6 / 9.6 / 0.18 / 0.22 / 9.7 / 9.9 V
                  thresholds) were replaced with the named constants in GVL Constants. *)
FUNCTION_BLOCK FB_MKS_937A
VAR_IN_OUT

END_VAR
VAR_INPUT
    PG	:	ST_VG := g_DummyVG; // Gauge Structure used to Interlock the ion gauges
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := 'pv: '}
    VG : ST_VG; // Vacuum Gauge Data Structure
END_VAR
VAR
    rV	:	REAL; // Terminal voltage [V] of the 937A logarithmic pressure signal
        (*IOs to be linked*)
    /// Controls and I/Os
    i_iPRESS_R AT %I* :INT; // input Pressure // Link to analog Input
    q_xHV_DIS AT %Q* : BOOL; // Disable Gauge High Voltage when True // 'TcLinkTo' (EL2794) ^Output

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* 937A Logarithmic Output Conversion *)
(* 7-15-2015 *)
(* This function will read the pressure from any gauge on a 937A. *)

(* Terminal voltage [V] from the raw analog input counts (terminal span and full-scale count are
   hardware properties, declared in GVL Constants) *)
rV := gc_rMKS937AFullScaleVolts*INT_TO_REAL(VG.i_iPRESS_R)/gc_uiMKS937ATermBits;
(* 937A logarithmic transfer function: pressure [Torr] from the terminal voltage *)
VG.rPRESS := LREAL_TO_REAL(EXPT(gc_rMKS937ALogLawBase,rV/gc_rMKS937AVoltsPerDecade-gc_rMKS937AExponentOffset));


(* Ion Gauge Protection Functions *)
(* If the PG pressure is greater than the VG.PRO_SP then the gauge is disabled *)
(* If the PG pressure is less than the VG.PRO_SP then the gauge is enabled *)
(* This FB also implements some hysteresis so the gauge doesn't have rapid power cycling while near the turn on boundary *)

IF PG.rPRESS < VG.rPRO_SP THEN

VG.q_xHV_DIS :=  NOT VG.xHV_SW;

ELSIF NOT VG.q_xHV_DIS THEN
    IF VG.rPRESS > VG.rPRO_SP + VG.rHYS_PR OR PG.rPRESS > VG.rPRO_SP + VG.rHYS_PR THEN
        VG.q_xHV_DIS := TRUE;
    END_IF
ELSE
    VG.q_xHV_DIS := TRUE;
END_IF


(* Pressure gauge OK checks *)
(* The validity windows are part of the 937A curve and are named in GVL Constants *)
VG.xPRESS_OK := (rV <= gc_rMKS937AValidMaxVolts) AND (rV >= gc_rMKS937AValidMinVolts); //legacy

IF (rV <= gc_rMKS937AValidMaxVolts) AND (rV >= gc_rMKS937AValidMinVolts) THEN
    VG.eState := Valid; // normal
ELSIF rV >= gc_rMKS937ALoBandMinVolts AND rV <= gc_rMKS937ALoBandMaxVolts THEN
    VG.eState := ValidLo; //LO
ELSIF rV >= gc_rMKS937AHiBandMinVolts AND rV <= gc_rMKS937AHiBandMaxVolts THEN
    VG.eState := ValidHi; //HIGH
ELSIF rV < gc_rMKS937ALoBandMinVolts THEN
    VG.eState := GaugeDisconnected; //not on
ELSE
    VG.eState := PressInvalid; //other fault - could be no gauge, controller powering up etc
END_IF

(* Setpoint evaluation *)
VG.xAT_VAC := (VG.eState =Valid) AND VG.rPRESS < VG.rVAC_SP;

(*Soft IO Linking*)
ACT_IO();

]]></ST>
    </Implementation>
    <Action Name="ACT_IO" Id="{0ba951d1-68de-4487-b7f2-e7fe9da02dd1}">
      <Implementation>
        <ST><![CDATA[(*soft link inputs*)
VG.i_iPRESS_R:=	i_iPRESS_R;

(*soft link outputs*)
q_xHV_DIS := VG.q_xHV_DIS;]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>