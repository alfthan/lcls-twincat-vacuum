<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_VCC" Id="{5ba1a6cc-24ff-4014-aa5e-6a7b6226a38e}" SpecialFunc="None">
    <Declaration><![CDATA[(*Deprecated*)
(* THE FB_VCC FUNCTION BLOCK IS DEPRECATED. USE FB_VVC INSTEAD. *)
(* This Function Block Implements Basic Functionality for Vent Valves VVC *)
(* Note Interlock Logic is External *)
(*
    Usage:
        - Wire i_xExtILK_OK to the vent-valve interlock function (F_<Device>_ILK), or set it TRUE
          when the valve has no external interlock.
        - Wire i_xOverrideMode to the vacuum override request and connect iq_stValve to EPICS
          (OPN_SW, FORCE_OPN, OVRD_ON, OPN_OK, OPN_DO).

    Objectives:
        - Command the open solenoid output from the software open request (pv_xOPN_SW) and from the
          external interlock permit (i_xExtILK_OK, published as xOPN_OK).
        - Honour a manual Force Open override (xOvrdOpn) only after it has been held for ten seconds,
          and never let that override bypass the external interlock permit.

    History:
        - 2026-11-28, Scirix Agent: the override branch of q_xOPN_DO is now ANDed with the interlock
          permit xOPN_OK, so a held Force Open request can no longer open the valve while the external
          interlock is unsatisfied (audit finding #597, convention conv_eeb5d87743fc).
*)
FUNCTION_BLOCK FB_VCC
VAR_IN_OUT

END_VAR
VAR_INPUT
    i_xExtILK_OK:BOOL; (*Other External Interlock, Set to True when no external interlock is required*)
    i_xOverrideMode : BOOL; (*To be linked to global override bit. This overrides the software open request only; the external interlock permit xOPN_OK is never overridden*)
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
    pv:
    '}
    iq_stValve : ST_VVC;
END_VAR
VAR

    tonOvrd	:	TON; (*Override qualification timer: the Force Open override is honoured only after it has been requested for ten seconds*)
    tonDelOK : TON; (*Permit-healthy timer: used to release a stale override once the interlock permit has been good for ten seconds*)
    rtOK	:	R_TRIG; (*Rising edge of tonDelOK.Q*)

    (*IO*)
    q_xOPN_DO	AT%Q*: BOOL;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
iq_stValve.xOPN_OK := i_xExtILK_OK;

IF NOT iq_stValve.xOPN_OK THEN
iq_stValve.pv_xOPN_SW := FALSE;
END_IF

(* Override logic *)
(* Goal: give ability to override, but do so in a way that people won't forget it.
Solution: Override only after ten seconds of override, protect against blips,
when the valve permission goes true for more than ten seconds consistently, remove override
*)

tonDelOK(IN:=iq_stValve.xOPN_OK, PT:=T#10S);
rtOK(CLK:=tonDelOK.Q);
IF rtOK.Q THEN iq_stValve.xOvrdOpn :=FALSE; END_IF

//Override timer
tonOvrd(IN:=iq_stValve.xOvrdOpn, PT:=T#10S);

(* Here's where the valve opens.
Both terms are ANDed with the interlock permit (xOPN_OK): the manual override only replaces the software
open request (pv_xOPN_SW), it can never hold the valve open while the external interlock permit is not
satisfied. Without that AND a stuck or forgotten Force Open request would defeat the vacuum protection
logic for as long as the request is held. *)
iq_stValve.q_xOPN_DO := (iq_stValve.pv_xOPN_SW AND iq_stValve.xOPN_OK) OR (tonOvrd.Q AND i_xOverrideMode AND iq_stValve.xOPN_OK);

(*IO Mapping*)
ACT_IO();]]></ST>
    </Implementation>
    <Action Name="ACT_IO" Id="{d165a6d3-343d-433e-9bfc-fed40a85fa97}">
      <Implementation>
        <ST><![CDATA[(*inputs*)
iq_stValve.xOverrideMode := i_xOverrideMode;
(*outputs*)
q_xOPN_DO:= iq_stValve.q_xOPN_DO;]]></ST>
      </Implementation>
    </Action>
    <Method Name="M_IsClosed" Id="{797d56d6-e736-4bd1-8e6d-f8a341c15bae}">
      <Declaration><![CDATA[METHOD PUBLIC M_IsClosed : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_IsClosed := NOT This^.q_xOPN_DO;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsOpen" Id="{def52f34-99b7-48c7-9903-759cb85be175}">
      <Declaration><![CDATA[METHOD PUBLIC M_IsOpen : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_IsOpen := This^.q_xOPN_DO;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Set_OPN_SW" Id="{7f5acd3f-8556-413a-b630-0f2034c75abd}">
      <Declaration><![CDATA[// Use this Methode to Open or close the valve by setting the OPN_SW to the input value.
METHOD PUBLIC M_Set_OPN_SW : BOOL
VAR_INPUT
        value:BOOL;  //True to SET, False to RESET
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[This^.iq_stValve.pv_xOPN_SW := value;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>