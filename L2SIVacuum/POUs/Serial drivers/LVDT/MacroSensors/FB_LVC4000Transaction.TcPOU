<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LVC4000Transaction" Id="{7f68d6c9-2d15-48e7-9147-99c051549076}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LVC4000Transaction
(*
FB_LVC4000Transaction

Purpose:
    Performs a single serial transaction with an LVC-4000 LVDT signal
    conditioner over RS-485: clear the com buffers, build the request, send it
    and, for commands that the device answers, wait for the reply.

Usage:
    Call the block every cycle and pulse i_xExecute to start a transaction.
    q_xDone, q_xError and q_xTimeout report the outcome; q_sResponseData holds
    the reply of a read command. Only i_sCmd = 'getOut' is answered by the
    device - every other command completes as soon as it has been transmitted.

Objectives:
    The sequence is a non-blocking state machine. The step counter eState is of
    the type E_LVC4000TransactionState, so every step has a name and the numeric
    values keep gaps for inserting further steps without renumbering. Every
    state performs exactly one documented action and states the condition on
    which it leaves to the next state:

        Idle              -> ClearComBuffers    rising edge of i_xExecute
        ClearComBuffers   -> BuildRequest       unconditioned
        BuildRequest      -> SendRequest        unconditioned
        SendRequest       -> AwaitSendComplete  unconditioned
        AwaitSendComplete -> AwaitSendComplete  transmit still busy
                          -> Error              transmit error
                          -> ResetReceiver      i_sCmd = 'getOut' (reply expected)
                          -> Done               command is not answered
        ResetReceiver     -> AwaitReply         unconditioned
        AwaitReply        -> EvaluateReply      reply, receive error or timeout
        EvaluateReply     -> Done               valid reply received
                          -> Error              receive error or timeout
                          -> AwaitReply         no verdict yet
        Done              -> Idle               i_xExecute dropped
        Error             -> (latched)          a new rising edge restarts the
                                                machine at ClearComBuffers

History:
    2016-07-20  A. Wallace - original implementation with numeric step values
    2026-11-28  Sequence split into named states with one action per state
*)
VAR_INPUT
    /// rising edge execute
    i_xExecute: BOOL;
    /// RS-485 Address of LVC 4000
    i_iAddress: INT;
    /// Maximum wait time for reply
    i_tTimeOut: TIME := TIME#1s0ms;
    // Command field
    i_sCmd: T_MAXSTRING;
    // Parameter field
    i_sParam: T_MAXSTRING;
END_VAR
VAR_OUTPUT
    q_xDone: BOOL;
    q_sResponseData: STRING;
    q_xError: BOOL;
    q_xTimeout: BOOL;
    q_sResult: T_MAXSTRING;
    /// Last String Sent to Serial Device - for debugging
    q_sLastSentString: STRING;
    /// Last String Received from Serial Device - for debugging
    q_sLastReceivedString: STRING;
END_VAR
VAR_IN_OUT
    iq_stSerialRXBuffer: ComBuffer;
    iq_stSerialTXBuffer: ComBuffer;
END_VAR
VAR
    rtExecute: R_TRIG;
    /// Transaction step counter
    eState	:	E_LVC4000TransactionState := E_LVC4000TransactionState.lvcIdle;
    fbClearComBuffer: ClearComBuffer;
    sSendString: STRING;
    fbFormatString: FB_FormatString;
    iChecksum: INT;
    fbSendString: SendString;
    fbReceiveString: ReceiveString;
    sReceivedString: STRING;
    tonTimeout: TON;
    sRXStringForChecksum: STRING;
    sReceiveStringWOChecksum: STRING;
    sRXCheckSum: STRING;
    sRXAddress: STRING;
    sRXParmNum: STRING;
    CarRtn : BYTE :=16#0D;
    rAddress: REAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* This function block performs serial transactions with an LVC 4000 LVDT Signal Conditioner *)

(* rising edge trigger *)
rtExecute(CLK:= i_xExecute);
IF rtExecute.Q THEN
    q_xDone	:= FALSE;
    q_sResponseData := '';
    q_xError := FALSE;
    //q_xTimeout := FALSE;
    q_sResult:= '';
    q_sLastSentString := '';
    q_sLastReceivedString:= '';
    eState := E_LVC4000TransactionState.lvcClearComBuffers;
END_IF

(* Non-blocking state machine: one action per state, transition documented per state *)
CASE eState OF
    E_LVC4000TransactionState.lvcIdle:
        (* action: none - wait for a rising edge on i_xExecute *)

    E_LVC4000TransactionState.lvcClearComBuffers:
        (* action: clear the receive and the transmit buffer *)
        fbClearComBuffer(Buffer:= iq_stSerialRXBuffer);
        fbClearComBuffer(Buffer:= iq_stSerialTXBuffer);
        eState := E_LVC4000TransactionState.lvcBuildRequest; (* unconditioned *)

    E_LVC4000TransactionState.lvcBuildRequest:
        (* action: format the request string from address, command and parameter *)
        rAddress := INT_TO_REAL(i_iAddress);
        IF i_sParam = '' THEN
            fbFormatString( sFormat:= ':%02.0f %s $R',
                arg1:= F_REAL(rAddress),
                arg2:= F_STRING(i_sCmd),
                sOut=> sSendString);
        ELSE
            fbFormatString( sFormat:= ':%02.0f %s %s $R',
                arg1:= F_REAL(rAddress),
                arg2:= F_STRING(i_sCmd),
                arg3:= F_STRING(i_sParam),
                sOut=> sSendString);
        END_IF
        eState := E_LVC4000TransactionState.lvcSendRequest; (* unconditioned *)

    E_LVC4000TransactionState.lvcSendRequest:
        (* action: hand the request string to the transmit block and record it *)
        fbSendString( SendString:= sSendString, TXbuffer:= iq_stSerialTXBuffer );
        q_sLastSentString := sSendString;
        eState := E_LVC4000TransactionState.lvcAwaitSendComplete; (* unconditioned *)

    E_LVC4000TransactionState.lvcAwaitSendComplete:
        (* action: wait for the transmit block; the send is re-issued while busy *)
        IF fbSendString.Busy THEN
            fbSendString( SendString:= sSendString, TXbuffer:= iq_stSerialTXBuffer );
        ELSIF fbSendString.Error <> 0 THEN
            (* transition: transmit error *)
            q_sResult := CONCAT('In state lvcAwaitSendComplete fbSendString resulted in error: ', INT_TO_STRING(fbSendString.Error));
            eState := E_LVC4000TransactionState.lvcError;
        ELSIF i_sCmd = 'getOut' THEN
            (* transition: the device answers 'getOut', so a reply is expected *)
            eState := E_LVC4000TransactionState.lvcResetReceiver;
        ELSE
            (* transition: any other command is a write command and is not answered *)
            eState := E_LVC4000TransactionState.lvcDone;
        END_IF

    E_LVC4000TransactionState.lvcResetReceiver:
        (* action: reset the receive block together with its timeout watchdog *)
        fbReceiveString(
            Reset:= TRUE,
            ReceivedString:= sReceivedString,
            RXbuffer:= iq_stSerialRXBuffer );
        tonTimeout(IN:= FALSE);
        eState := E_LVC4000TransactionState.lvcAwaitReply; (* unconditioned *)

    E_LVC4000TransactionState.lvcAwaitReply:
        (* action: wait for the reply - poll the receive block, the tonTimeout
           below is the watchdog that bounds this wait. The verdict is taken
           in lvcEvaluateReply. *)
        fbReceiveString(
            Prefix:= ,
            Suffix:= '$R',
            Timeout:= i_tTimeOut,
            Reset:= FALSE,
            ReceivedString:= sReceivedString,
            RXbuffer:= iq_stSerialRXBuffer );
        tonTimeout(IN:= TRUE, PT:= i_tTimeOut);
        (* transition: reply arrived, receive failed or the wait timed out *)
        IF fbReceiveString.StringReceived
        OR fbReceiveString.Error <> 0
        OR fbReceiveString.RxTimeout
        OR tonTimeout.Q THEN
            eState := E_LVC4000TransactionState.lvcEvaluateReply;
        END_IF

    E_LVC4000TransactionState.lvcEvaluateReply:
        (* action: classify the reply and latch the outcome *)
        IF fbReceiveString.Error <> 0 AND fbReceiveString.Error <> 16#1008 THEN //16#1008 is timeout error
            q_sResult := CONCAT('In state lvcEvaluateReply fbReceiveString resulted in error: ', INT_TO_STRING(fbReceiveString.Error));
            eState := E_LVC4000TransactionState.lvcError;
        ELSIF fbReceiveString.RxTimeout OR tonTimeout.Q THEN
            (* transition: no reply within the timeout period *)
            q_sResult := 'Device failed to reply within timeout period';
            q_xTimeout := TRUE;
            eState := E_LVC4000TransactionState.lvcError;
        ELSIF fbReceiveString.StringReceived THEN
            (* transition: valid reply received *)
            q_xTimeout := FALSE; //no timeout
            q_sLastReceivedString := sReceivedString;
            q_sResponseData := sReceivedString;
            q_sResult := 'Success.';
            q_xDone:= TRUE;
            eState := E_LVC4000TransactionState.lvcDone;
        ELSE
            (* no verdict yet, keep waiting for the reply *)
            eState := E_LVC4000TransactionState.lvcAwaitReply;
        END_IF

    E_LVC4000TransactionState.lvcDone:
        (* action: hold q_xDone until the caller drops i_xExecute *)
        IF i_xExecute = FALSE THEN
            q_xDone:= FALSE;
            eState := E_LVC4000TransactionState.lvcIdle;
        END_IF

    E_LVC4000TransactionState.lvcError:
        (* action: latch q_xError; a new rising edge restarts the machine *)
        q_xError := TRUE;

    ELSE
        (* fail safe on an undefined step instead of hanging in it *)
        q_sResult := 'Invalid transaction state.';
        eState := E_LVC4000TransactionState.lvcError;

END_CASE]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>