<?xml version='1.0' encoding='utf-8'?>
<!--
  CoE startup parameters for the EL6002 RS485 serial terminal (Oerlikon TD20 classic).
  Every InitCmd is bounded by a finite CoE mailbox timeout so that a terminal which
  does not answer a mailbox write aborts EtherCAT startup with an explicit error
  instead of stalling the PS transition indefinitely. TwinCAT treats Timeout 0 as
  "no timeout monitoring", so keep a non-zero value when re-exporting these
  parameters from the TwinCAT System Manager (3000 ms is used here).
-->
<EtherCATMailbox>
  <CoE>
    <InitCmds>
      <InitCmd>
        <Transition>PS</Transition>
        <Comment>Baudrate</Comment>
        <Timeout>3000</Timeout>
        <Ccs>1</Ccs>
        <Index>32768</Index>
        <SubIndex>17</SubIndex>
        <Data>07</Data>
      </InitCmd>
      <InitCmd>
        <Transition>PS</Transition>
        <Comment>Baudrate</Comment>
        <Timeout>3000</Timeout>
        <Ccs>1</Ccs>
        <Index>32784</Index>
        <SubIndex>17</SubIndex>
        <Data>07</Data>
      </InitCmd>
      <InitCmd>
        <Transition>PS</Transition>
        <Comment>Enable RTS/CTS</Comment>
        <Timeout>3000</Timeout>
        <Ccs>1</Ccs>
        <Index>32768</Index>
        <SubIndex>1</SubIndex>
        <Data>00</Data>
      </InitCmd>
      <InitCmd>
        <Transition>PS</Transition>
        <Comment>Data frame</Comment>
        <Timeout>3000</Timeout>
        <Ccs>1</Ccs>
        <Index>32768</Index>
        <SubIndex>21</SubIndex>
        <Data>04</Data>
      </InitCmd>
      <InitCmd>
        <Transition>PS</Transition>
        <Comment>Enable RTS/CTS</Comment>
        <Timeout>3000</Timeout>
        <Ccs>1</Ccs>
        <Index>32784</Index>
        <SubIndex>1</SubIndex>
        <Data>00</Data>
      </InitCmd>
      <InitCmd>
        <Transition>PS</Transition>
        <Comment>Data frame</Comment>
        <Timeout>3000</Timeout>
        <Ccs>1</Ccs>
        <Index>32784</Index>
        <SubIndex>21</SubIndex>
        <Data>04</Data>
      </InitCmd>
    </InitCmds>
  </CoE>
</EtherCATMailbox>
