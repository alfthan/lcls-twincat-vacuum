<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_HomeToCenter_Tests" Id="{e4051d77-0001-4d40-af50-ad6030506401}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HomeToCenter_Tests EXTENDS FB_TestSuite
VAR
    //  Real stages + axes + persistent-storage doubles (one per test pair).
    fbAxisRef               : ARRAY[1..5] OF AXIS_REF;
    fbPersistentDataStorage : ARRAY[1..5] OF LCLS_Tc_DevAbs.FB_PersistentDataStorageTestDouble;
    afbStage : ARRAY[1..5] OF FB_MotionStageNC[
        (sName := 'HC_T1', AxisRef := fbAxisRef[1], iPersistentDataStorage := fbPersistentDataStorage[1]),
        (sName := 'HC_T2', AxisRef := fbAxisRef[2], iPersistentDataStorage := fbPersistentDataStorage[2]),
        (sName := 'HC_T3', AxisRef := fbAxisRef[3], iPersistentDataStorage := fbPersistentDataStorage[3]),
        (sName := 'HC_T4', AxisRef := fbAxisRef[4], iPersistentDataStorage := fbPersistentDataStorage[4]),
        (sName := 'HC_T5', AxisRef := fbAxisRef[5], iPersistentDataStorage := fbPersistentDataStorage[5])
    ] := [
        (RestoreMotionParams := FALSE, DoNotRestoreNcParameters := TRUE),
        (RestoreMotionParams := FALSE, DoNotRestoreNcParameters := TRUE),
        (RestoreMotionParams := FALSE, DoNotRestoreNcParameters := TRUE),
        (RestoreMotionParams := FALSE, DoNotRestoreNcParameters := TRUE),
        (RestoreMotionParams := FALSE, DoNotRestoreNcParameters := TRUE)
    ];
    bStagesInit : BOOL := TRUE;
    nInit       : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// One-time mode/limit enable for all stages (mirrors the T10 first-scan block).
// HomeEnable starts FALSE; the home is commanded explicitly in the test flow.
IF bStagesInit THEN
    FOR nInit := 1 TO 5 DO
        afbStage[nInit].SetModeEnableLimits(
            LimBackward    := TRUE,
            LimForward     := TRUE,
            HomeEnable     := FALSE,
            BrakeMode      := E_StageBrakeMode.IF_ENABLED,
            EnableMode     := E_StageEnableMode.ALWAYS,
            HomeMode       := E_EpicsHomeCmd.LOW_LIMIT,
            UserEnable     := TRUE,
            HardwareEnable := TRUE);
    END_FOR
    bStagesInit := FALSE;
END_IF

T01_HomeThenCenterThenZero();
T02_CenterOffset_Y_Geometry();
T03_UserEnableDrop_RedirectsToError();
T04_ReHome_ReArmsFromIdle();
T05_NoHomingEdge_StaysIdle();]]></ST>
    </Implementation>
    <Method Name="T01_HomeThenCenterThenZero" Id="{f5162e88-0001-4e50-bf60-be7040607501}">
      <Declaration><![CDATA[// Integration: drive a real limit-switch home (cam-switch pulser pattern, as in
// the T10 reference), with FB_HomeToCenter observing the NC home and performing the
// centering move + MC_SetPosition zero. Asserts the real axis is homed and that
// NcToPlc.ActPos was zeroed at the center position.
METHOD PRIVATE T01_HomeThenCenterThenZero
VAR_INST
    fbUUT : FB_HomeToCenter(iMotionStage := afbStage[1])
            := (fCenterOffset := 2.5, fDefaultVelocity := 10.0);
    fbSearch    : TON := (PT := T#5000MS);
    fbSync      : TON := (PT := T#5000MS);
    fbTimeout   : TON := (IN := TRUE, PT := T#120S);
    nStep       : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Drive the simulated limit-switch home (mirrors T10); FB observes alongside
CASE nStep OF
0:  // wait for the stage to come ready before commanding anything
    IF afbStage[1].stMotionStatus.bStageReady THEN
        nStep := 1;
    END_IF

1:  // NC-side command of the low-limit home; FB will see bHoming rise
    // afbStage[1].MotionCmd.eHomeMode --> fixed on newer releases, cant be used now
    afbStage[1].Home(HomePosition := 20.0, HomeMode := E_EpicsHomeCmd.LOW_LIMIT);
    fbSearch.IN := TRUE;
    nStep := 2;

2:  // search phase: forward-only to find the switch
    IF fbSearch.Q THEN
        afbStage[1].EnableLimits(BackwardEnable := FALSE, ForwardEnable := TRUE, HomeEnable := FALSE);
        fbSearch.IN := FALSE;
        fbSync.IN   := TRUE;
        nStep := 3;
    END_IF

3:  // sync phase: re-enable both; home completes -> bDone AND bHomed
    IF fbSync.Q THEN
        afbStage[1].EnableLimits(BackwardEnable := TRUE, ForwardEnable := TRUE, HomeEnable := FALSE);
        fbSync.IN := FALSE;
        nStep := 4;
    END_IF

4:  // home complete: the FB should have observed bHoming->(bDone AND bHomed) and be
    //  centering (CenterMove) or already zeroing (WaitCenterDone) or finished.
    IF afbStage[1].stMotionStatus.bDone AND afbStage[1].stMotionStatus.bHomed THEN
        nStep := 5;
    END_IF

5:  // wait for the FB to finish its own center + zero sequence
    IF fbUUT.bCentered AND fbUUT.bHomeDone THEN
        nStep := 6;
    END_IF

6: ;   // terminal - asserts below
END_CASE

//  All sub-FBs ticked unconditionally outside the CASE, stage last so the FB
//  reads current-cycle status.
fbSearch();
fbSync();
fbTimeout();
afbStage[1]();
fbUUT();

//  Terminal / timeout
TEST('T01_HomeThenCenterThenZero');
IF nStep = 6 THEN
    AssertTrue(
        Condition := fbAxisRef[1].Status.Homed,
        Message   := 'T01: axis should be homed');
    AssertTrue(
        Condition := fbUUT.bCentered,
        Message   := 'T01: FB should report centered');
    //  MC_SetPosition zeroed the centered position -> ActPos ~ 0
    AssertEquals_LREAL(
        Expected := 0.0,
        Actual   := fbAxisRef[1].NcToPlc.ActPos,
        Delta    := 0.01,
        Message  := 'T01: position should be zeroed at center by MC_SetPosition');
    TEST_FINISHED();
ELSIF fbTimeout.Q THEN
    AssertTrue(
        Condition := FALSE,
        Message   := CONCAT('T01: timed out at step ', TO_STRING(nStep)));
    TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="T02_CenterOffset_Y_Geometry" Id="{af59e3d5-24a5-4a57-bf04-59bcac5e9d6a}">
      <Declaration><![CDATA[// Happy path with the Y center offset (6.5) to confirm fCenterOffset is honored
// and the axis is zeroed at center by MC_SetPosition.
METHOD PRIVATE T02_CenterOffset_Y_Geometry
VAR_INST
    fbUUT : FB_HomeToCenter(iMotionStage := afbStage[2])
            := (fCenterOffset := 6.5, fDefaultVelocity := 10.0);
    fbSearch  : TON := (PT := T#5000MS);
    fbSync    : TON := (PT := T#5000MS);
    fbTimeout : TON := (IN := TRUE, PT := T#120S);
    nStep     : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nStep OF
0:  IF afbStage[2].stMotionStatus.bStageReady THEN
        nStep := 1;
    END_IF

1:  afbStage[2].Home(HomePosition := 20.0, HomeMode := E_EpicsHomeCmd.LOW_LIMIT);
    fbSearch.IN := TRUE;
    nStep := 2;

2:  IF fbSearch.Q THEN
        afbStage[2].EnableLimits(BackwardEnable := FALSE, ForwardEnable := TRUE, HomeEnable := FALSE);
        fbSearch.IN := FALSE;
        fbSync.IN   := TRUE;
        nStep := 3;
    END_IF

3:  IF fbSync.Q THEN
        afbStage[2].EnableLimits(BackwardEnable := TRUE, ForwardEnable := TRUE, HomeEnable := FALSE);
        fbSync.IN := FALSE;
        nStep := 4;
    END_IF

4:  IF afbStage[2].stMotionStatus.bDone AND afbStage[2].stMotionStatus.bHomed THEN
        nStep := 5;
    END_IF

5:  IF fbUUT.bCentered AND fbUUT.bHomeDone THEN
        nStep := 6;
    END_IF

6: ;
END_CASE

fbSearch();
fbSync();
fbTimeout();
afbStage[2]();
fbUUT();

TEST('T02_CenterOffset_Y_Geometry');
IF nStep = 6 THEN
    AssertTrue(
        Condition := fbAxisRef[2].Status.Homed,
        Message   := 'T02: axis should be homed');
    AssertEquals_LREAL(
        Expected := 0.0,
        Actual   := fbAxisRef[2].NcToPlc.ActPos,
        Delta    := 0.01,
        Message  := 'T02: position should be zeroed at center (offset 6.5) by MC_SetPosition');
    TEST_FINISHED();
ELSIF fbTimeout.Q THEN
    AssertTrue(Condition := FALSE,
        Message := CONCAT('T02: timed out at step ', TO_STRING(nStep)));
    TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="T03_UserEnableDrop_RedirectsToError" Id="{b5b77ac5-eb92-4adf-af41-42f75ebe9884}">
      <Declaration><![CDATA[// Dropping UserEnable mid-home faults the stage (bError, bStageReady still TRUE
// as a boot flag) -> FB redirects to Error, latches bLocalError, never centers.
METHOD PRIVATE T03_UserEnableDrop_RedirectsToError
VAR_INST
    fbUUT : FB_HomeToCenter(iMotionStage := afbStage[3])
            := (fCenterOffset := 2.5, fDefaultVelocity := 10.0);
    fbSearch  : TON := (PT := T#5000MS);
    fbSync    : TON := (PT := T#5000MS);
    fbTimeout : TON := (IN := TRUE, PT := T#120S);
    nStep     : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nStep OF
0:  IF afbStage[3].stMotionStatus.bStageReady THEN
        nStep := 1;
    END_IF

1:  // command the home so the FB enters its sequence
    afbStage[3].Home(HomePosition := 20.0, HomeMode := E_EpicsHomeCmd.LOW_LIMIT);
    fbSearch.IN := TRUE;
    nStep := 2;

2:  // mid-home, pull user-enable: faults the stage. bStageReady is a boot flag and
    //  stays TRUE, so rtError (bError AND bStageReady) fires in the FB.
    IF fbSearch.Q THEN
        afbStage[3].SetModeEnableLimits(
            LimBackward    := TRUE,
            LimForward     := TRUE,
            HomeEnable     := FALSE,
            BrakeMode      := E_StageBrakeMode.IF_ENABLED,
            EnableMode     := E_StageEnableMode.ALWAYS,
            HomeMode       := E_EpicsHomeCmd.LOW_LIMIT,
            UserEnable     := FALSE,
            HardwareEnable := TRUE);
        nStep := 3;
    END_IF

3:  // wait for the FB to redirect to Error
    IF fbUUT.eHomeCenterState = E_HomeCenterState.Error THEN
        nStep := 6;
    END_IF
END_CASE

fbSearch();
fbSync();
fbTimeout();
afbStage[3]();
fbUUT();

TEST('T03_UserEnableDrop_RedirectsToError');
IF nStep = 6 THEN
    AssertEquals_INT(
        Expected := E_HomeCenterState.Error,
        Actual   := fbUUT.eHomeCenterState,
        Message  := 'T03: dropping UserEnable should redirect FB to Error');
    AssertTrue(
        Condition := fbUUT.bLocalError,
        Message   := 'T03: bLocalError should latch in Error');
    AssertFalse(
        Condition := fbUUT.bCentered,
        Message   := 'T03: must NOT report centered after an error');
    AssertFalse(
        Condition := fbUUT.bHomeDone,
        Message   := 'T03: must NOT report home done after an error');
    TEST_FINISHED();
ELSIF fbTimeout.Q THEN
    AssertTrue(Condition := FALSE,
        Message := CONCAT('T03: timed out at step ', TO_STRING(nStep)));
    TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="T04_ReHome_ReArmsFromIdle" Id="{83462bf8-b643-4d93-a7df-1406a30c7e04}">
      <Declaration><![CDATA[// Complete one home+center cycle, confirm the FB returns to Idle, then command a
// second home and confirm it re-arms and re-zeroes (HomingDone -> Idle re-arm path).
METHOD PRIVATE T04_ReHome_ReArmsFromIdle
VAR_INST
    fbUUT : FB_HomeToCenter(iMotionStage := afbStage[4])
            := (fCenterOffset := 2.5, fDefaultVelocity := 10.0);
    fbSearch  : TON := (PT := T#5000MS);
    fbSync    : TON := (PT := T#5000MS);
    fbTimeout : TON := (IN := TRUE, PT := T#120S);
    nStep     : INT;
    bFirstDone : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nStep OF
0:  IF afbStage[4].stMotionStatus.bStageReady THEN
        nStep := 1;
    END_IF

1:  afbStage[4].Home(HomePosition := 20.0, HomeMode := E_EpicsHomeCmd.LOW_LIMIT);
    fbSearch.IN := TRUE;
    nStep := 2;

2:  IF fbSearch.Q THEN
        afbStage[4].EnableLimits(BackwardEnable := FALSE, ForwardEnable := TRUE, HomeEnable := FALSE);
        fbSearch.IN := FALSE;
        fbSync.IN   := TRUE;
        nStep := 3;
    END_IF

3:  IF fbSync.Q THEN
        afbStage[4].EnableLimits(BackwardEnable := TRUE, ForwardEnable := TRUE, HomeEnable := FALSE);
        fbSync.IN := FALSE;
        nStep := 4;
    END_IF

4:  IF afbStage[4].stMotionStatus.bDone AND afbStage[4].stMotionStatus.bHomed THEN
        nStep := 5;
    END_IF

5:  // first cycle complete; confirm FB returned to Idle (re-armable)
    IF fbUUT.bCentered AND fbUUT.bHomeDone THEN
        bFirstDone := TRUE;
        nStep := 6;
    END_IF

6:  // FB should restore params and fall back to Idle on its own
    IF fbUUT.eHomeCenterState = E_HomeCenterState.Idle THEN
        nStep := 7;
    END_IF

7:  // re-home: command Home() again, re-run the pulser dance
    afbStage[4].Home(HomePosition := 20.0, HomeMode := E_EpicsHomeCmd.LOW_LIMIT);
    fbSearch.IN := TRUE;
    nStep := 8;

8:  IF fbSearch.Q THEN
        afbStage[4].EnableLimits(BackwardEnable := FALSE, ForwardEnable := TRUE, HomeEnable := FALSE);
        fbSearch.IN := FALSE;
        fbSync.IN   := TRUE;
        nStep := 9;
    END_IF

9:  IF fbSync.Q THEN
        afbStage[4].EnableLimits(BackwardEnable := TRUE, ForwardEnable := TRUE, HomeEnable := FALSE);
        fbSync.IN := FALSE;
        nStep := 10;
    END_IF

10: IF fbUUT.bCentered AND fbUUT.bHomeDone THEN
        nStep := 11;
    END_IF

11: ;
END_CASE

fbSearch();
fbSync();
fbTimeout();
afbStage[4]();
fbUUT();

TEST('T04_ReHome_ReArmsFromIdle');
IF nStep = 11 THEN
    AssertTrue(
        Condition := bFirstDone,
        Message   := 'T04: first home/center cycle should have completed');
    AssertTrue(
        Condition := fbUUT.bCentered,
        Message   := 'T04: second home/center cycle should re-arm and complete');
    AssertEquals_LREAL(
        Expected := 0.0,
        Actual   := fbAxisRef[4].NcToPlc.ActPos,
        Delta    := 0.01,
        Message  := 'T04: position should be re-zeroed after the second cycle');
    TEST_FINISHED();
ELSIF fbTimeout.Q THEN
    AssertTrue(Condition := FALSE,
        Message := CONCAT('T04: timed out at step ', TO_STRING(nStep)));
    TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="T05_NoHomingEdge_StaysIdle" Id="{4c2abc0f-47ef-4f09-85f4-fdce1d6d5bc8}">
      <Declaration><![CDATA[// With no home commanded, bHoming never rises -> FB must remain Idle and never
// center (rising-edge entry, not level)
METHOD PRIVATE T05_NoHomingEdge_StaysIdle
VAR_INST
    fbUUT : FB_HomeToCenter(iMotionStage := afbStage[5])
            := (fCenterOffset := 2.5, fDefaultVelocity := 10.0);
    fbSettle  : TON := (PT := T#2000MS);
    fbTimeout : TON := (IN := TRUE, PT := T#30S);
    nStep     : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nStep OF
0:  IF afbStage[5].stMotionStatus.bStageReady THEN
        nStep := 1;
    END_IF

1:  // never command a home -> bHoming never rises. Let the stage idle for a while.
    fbSettle.IN := TRUE;
    nStep := 2;

2:  IF fbSettle.Q THEN
        nStep := 6;
    END_IF
END_CASE

fbSettle();
fbTimeout();
afbStage[5]();
fbUUT();

TEST('T05_NoHomingEdge_StaysIdle');
IF nStep = 6 THEN
    AssertEquals_INT(
        Expected := E_HomeCenterState.Idle,
        Actual   := fbUUT.eHomeCenterState,
        Message  := 'T05: with no bHoming edge the FB must stay Idle');
    AssertFalse(
        Condition := fbUUT.bCentered,
        Message   := 'T05: must not center without a home');
    TEST_FINISHED();
ELSIF fbTimeout.Q THEN
    AssertTrue(Condition := FALSE,
        Message := CONCAT('T05: timed out at step ', TO_STRING(nStep)));
    TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>