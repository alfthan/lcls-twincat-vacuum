<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4022.18">
  <POU Name="P_Override_Tran_BC" Id="{76508c70-657e-4efc-9f84-74087367a27b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Override_Tran_BC
VAR
    fbBPRequestor_Arbiter1 : FB_BPRequestor; // gets the arbiter 1 BP
    stOverrideBP:ST_BeamParams;
    stPreviousOverrideBP:ST_BeamParams;
    tDuration:TIME;
    tonDuration:TON;
    {attribute 'pytmc' := '
       pv: @(PREFIX)RequestedPowerMax
    '}
    rPowerMax:REAL;
    {attribute 'pytmc' := '
       pv: @(PREFIX)PowerOverride
    '}
    rPowerOverride:REAL;
    arrTableBC	: ARRAY[1..16,1..2] OF REAL;
    arrIndex: INT;
    bInit : BOOl:= TRUE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bInit THEN
    ACT_INIT(); // not needed every cycle
    bInit := FALSE;
END_IF


//Beam intensity factor implemenation
// No diff by zero
IF (nBeamIntensityJF =0) OR (nBeamIntensityJF > GVL.nBeamIntensity ) THEN nBeamIntensityJF:=GVL.nBeamIntensity; END_IF
//Check it it has expired or is cancelled and reset to defaults
IF(tonDuration.Q OR bCancelJF)
THEN
    nBeamIntensityJF:=GVL.nBeamIntensity;
    bCancelJF := FALSE;
     bApplyJF := FALSE;
END_IF

//Get the Beam paramters from Arbiter 1
fbBPRequestor_Arbiter1(Arbiter:=GVL.g_fbArbiter1, q_ReqBP =>stArbiter1BP);
//Start with Override to be equal to the Arbiter1 Beam parameters
stOverrideBP := stArbiter1BP;

// Maximum duration is 12 hours
rDurationJF := LIMIT(0,rDurationJF,MaxDuration);
//check if it is applied
tDuration:= TO_TIME(rDurationJF*60*60*1000);//to msec
tonDuration(IN:=bApplyJF,PT:=tDuration,ET=>);
rTimeRemainJF:= rDurationJF - (TO_REAL(tonDuration.ET)/60/60/1000);//to hours


 // Send request from this arbiter to the gas attenuator
 IF (bApplyJF) THEN
     //Transmission override
      stOverrideBP.nTran := LIMIT(0,(GVL.nBeamIntensity/nBeamIntensityJF)*stArbiter1BP.nTran*PMPS_GVL.TRANS_SCALING_FACTOR,1);
     // Beamclass override
     arrIndex := stArbiter1BP.nBeamClass+1;
     //Make sure to remain within the bounds of the array
     arrIndex := LIMIT(1,arrIndex,16);
     //Look up the Max power for this beamclass
     rPowerMax := arrTableBC[arrIndex,2];
     //Calculate the new max allowed power based on the current beam class power and judgement factor
     rPowerOverride:= ((GVL.nBeamIntensity/nBeamIntensityJF)*stArbiter1BP.nTran)*rPowerMax;
     //If Power override is lower Than Power Max, keep Power Max
     IF ( rPowerOverride < rPowerMax) THEN rPowerOverride := rPowerMax; END_IF
     //Look up the new beamclass for the adjusted power
     stOverrideBP.nBeamClass := TO_USINT(M_LookUp(rPowerOverride,arrTableBC));
     // Apply bitmask to BC range
     stOverrideBP.nBCRange:= SHL(1,stOverrideBP.nBeamClass)-1;
END_IF

// Add the override BP to arbiter 2, so it is arbitrated with the beamline parameter
IF F_DifferentBeamParams (stPreviousOverrideBP,stOverrideBP) THEN
    GVL.g_fbArbiter2.RemoveRequest(16#FFF1);
    GVL.g_fbArbiter2.AddRequest(nReqID := 16#FFF1, stReqBp := stOverrideBP, sDevName := 'Beamlines Summary');
    stPreviousOverrideBP := stOverrideBP;
END_IF

]]></ST>
    </Implementation>
    <Action Name="ACT_Init" Id="{d29f6119-c66e-4836-a684-990ead6efdb4}">
      <Implementation>
        <ST><![CDATA[IF bInit
THEN
    (* init array with BeamClass Data  *)
    (* 	BeamClass		 |		Power		*)
    arrTableBC[1,1] := 0;	arrTableBC[1,2] := 0;
    arrTableBC[2,1] := 1;	arrTableBC[2,2] := 0;
    arrTableBC[3,1] := 2;	arrTableBC[3,2] := 1.4;
    arrTableBC[4,1] := 3;	arrTableBC[4,2] := 14;
    arrTableBC[5,1] := 4;	arrTableBC[5,2] := 40;
    arrTableBC[6,1] := 5;	arrTableBC[6,2] := 60;
    arrTableBC[7,1] := 6;	arrTableBC[7,2] := 140;
    arrTableBC[8,1] := 7;	arrTableBC[8,2] := 1200;
    arrTableBC[9,1] := 8;	arrTableBC[9,2] := 6000;
    arrTableBC[10,1] := 9;	arrTableBC[10,2] := 12000;
    arrTableBC[11,1] := 10;	arrTableBC[11,2] := 30000;
    arrTableBC[12,1] := 11; arrTableBC[12,2] := 60000;
    arrTableBC[13,1] := 12;	arrTableBC[13,2] := 120000;
    arrTableBC[14,1] := 13;	arrTableBC[14,2] := 120000;
    arrTableBC[15,1] := 14;	arrTableBC[15,2] := 120000;
    arrTableBC[16,1] := 15;	arrTableBC[16,2] := 120000;

    bInit:=False;

END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="M_LookUp" Id="{e93cd4c0-557c-424b-a50e-bee09bfe06ff}">
      <Declaration><![CDATA[METHOD M_LookUp : REAL
VAR_INPUT
    Pnew : LREAL;
    arrTableBC	: ARRAY[1..16,1..2] OF REAL;
END_VAR

VAR
    iIndex: INT;
END_VAR

VAR CONSTANT
    iLowBound :INT :=1;
    iHighBound:INT :=16;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_LookUp:=0;
FOR iIndex := iLowBound TO iHighBound DO
    (*Need to avoid Floating-Point Comparison issue*)
    // Ceiling function isn't available for this build only available on TwinCAT v3.1 >= 4026.13
    IF (FLOOR(Pnew)+ 1 >= arrTableBC[iIndex,2]) THEN M_LookUp := arrTableBC[iIndex,1];
        ELSE return;
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>