<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SpindleHomeToCenter" Id="{a97012d4-df2a-4180-a42e-58cf3ac5bf40}" SpecialFunc="None">
    <Declaration><![CDATA[(*  FB_HomeIndex - Index pulse homing sequence for the spindle.

 Overview:
   Manages a multi-state homing sequence that uses a physical index pulse
   (bHomeIndex) to establish a reference position. On detecting a homing
   start, the FB waits for the index pulse, latches a HomeLimit signal for
   a configurable duration, then waits for the drive to confirm homed+done
   before issuing a centering move to fCenterOffset. Finally it zeros the
   position via MC_SetPosition and enables backlash compensation.
*)
FUNCTION_BLOCK FB_SpindleHomeToCenter
VAR_INPUT
    fCenterOffset : LREAL;
    fDefaultVelocity : LREAL;
END_VAR
VAR
    iMotionStage 		: I_MotionStage;
    bHomeIndex  AT %I* : BOOL;
    {attribute 'hide'}
    rtHomingStart     : R_TRIG;
    {attribute 'hide'}
    rtHomePulse       : R_TRIG;
    {attribute 'hide'}
    rtDoneHome        : R_TRIG;
    {attribute 'hide'}
    rtCenterDone       : R_TRIG;
    {attribute 'hide'}
    rtError : R_TRIG;

    nCurTick          : ULINT;
    nLatchStartTick   : ULINT;
    nLatchDurationNs  : ULINT := 30_000_000; // 30ms (adjust as needed)
    bHomePulseLatched : BOOL;
    fPrevVelocity     : LREAL;
    fbMcSetPosition   : MC_SetPosition;


    rtHomed: R_TRIG;
    rtWaitHomeIndexDone: R_TRIG;
END_VAR

VAR_OUTPUT
   {attribute 'pytmc' := '
        pv: bCentered
        io: i
        field: ZNAM FALSE
        field: ONAM TRUE
        field: DESC TRUE if the pulse picker is centered
    '}
    bCentered   : BOOL;
    bHomeDone         : BOOL;
    bLocalError       : BOOL;
    eHomeIndexState : E_HomeIndexState := E_HomeIndexState.Idle;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF (iMotionStage = 0) THEN
    RETURN;
END_IF

nCurTick := F_GetCurDcTickTime64();

rtError(CLK := iMotionStage.MotionStatus.bError AND iMotionStage.MotionStatus.bStageReady);
rtHomingStart(CLK := iMotionStage.MotionStatus.bHoming);
rtHomePulse(CLK := bHomeIndex);
rtHomed(CLK := iMotionStage.MotionStatus.bHomed);
// Fires when drive confirms both done and homed after index pulse
rtWaitHomeIndexDone(CLK := iMotionStage.MotionStatus.bDone
        AND iMotionStage.MotionStatus.bHomed
        AND (eHomeIndexState = E_HomeIndexState.WaitHomeDone));
// Fires when centering alignment move completes
rtCenterDone(CLK := iMotionStage.MotionStatus.bDone
    AND (eHomeIndexState = E_HomeIndexState.CenterMove));

// Any drive error immediately redirects to Error state from any point in sequence
IF rtError.Q THEN
    eHomeIndexState := E_HomeIndexState.Error;
END_IF

CASE eHomeIndexState OF
    E_HomeIndexState.Idle:
        // Wait for homing procedure to be initiated by the drive
        IF rtHomingStart.Q THEN
            Reset();
            bCentered := FALSE;
            // Preserve current velocity for restore after homing, fall back to default
            IF iMotionStage.MotionCmd.fVelocity <> 0.0 THEN
                fPrevVelocity := iMotionStage.MotionCmd.fVelocity;
            ELSE
                fPrevVelocity := fDefaultVelocity;
            END_IF
            eHomeIndexState := E_HomeIndexState.Homing;
        END_IF

    E_HomeIndexState.Homing:
        // Wait for the first rising edge of the index pulse.
        // Transition immediately on detection - HomingUnlatch owns the latch timer,
        // preventing re-entry here and thus ignoring any spurious subsequent pulses.
        IF rtHomePulse.Q THEN
            bHomePulseLatched := TRUE;
            nLatchStartTick := nCurTick;
            iMotionStage.HomeLimit := TRUE;
            eHomeIndexState := E_HomeIndexState.HomingUnlatch;
        END_IF

    E_HomeIndexState.HomingUnlatch:
        // Hold HomeLimit high for nLatchDurationNs to ensure the drive sees the pulse.
        // Any further index pulses are ignored by virtue of being in this state.
        IF (nCurTick - nLatchStartTick) >= nLatchDurationNs THEN
            bHomePulseLatched := FALSE;
            iMotionStage.HomeLimit := FALSE;
            eHomeIndexState := E_HomeIndexState.WaitHomeDone;
        END_IF

    E_HomeIndexState.WaitHomeDone:
        // Index pulse sequence complete. Wait for drive to assert both bDone and
        // bHomed, confirming the homing move has fully settled.
        IF rtWaitHomeIndexDone.Q THEN
            iMotionStage.AbsoluteMoveDefault(
                Position := fCenterOffset,
                Velocity := 15.0,
            );
           eHomeIndexState := E_HomeIndexState.CenterMove;
        END_IF

    E_HomeIndexState.CenterMove:
        // AbsoluteMoveDefault clears bDone before starting, so rtDoneAlign will
        // only fire on the fresh rising edge from this move completing.
        IF rtCenterDone.Q THEN
            // Issue MC_SetPosition to define current position as zero.
            fbMcSetPosition.Execute := TRUE;
            eHomeIndexState := E_HomeIndexState.WaitCenterDone;
        END_IF

    E_HomeIndexState.WaitCenterDone:

        // fbMcSetPosition runs unconditionally below the CASE each cycle.
        IF fbMcSetPosition.Done THEN
            fbMcSetPosition.Execute := FALSE;
            // Position zeroed - mark sequence outputs and advance to Finished
            bCentered := TRUE;
            bHomeDone := TRUE;
            eHomeIndexState := E_HomeIndexState.HomingDone;
        END_IF

    E_HomeIndexState.HomingDone:
        // Restore motion parameters to pre-homing state and enable backlash
        // compensation, then return to Idle ready for next homing cycle.
        bHomePulseLatched := FALSE;
        iMotionStage.SetDefaultMotionParameters(
            HomePosition := 0.0,
            Velocity     := fPrevVelocity,
        );
        eHomeIndexState := E_HomeIndexState.Idle;

    E_HomeIndexState.Error:
        // Latch error output and safe all drive signals.
        // Caller must invoke Reset() to clear and return to Idle.
        bLocalError := TRUE;
        iMotionStage.HomeLimit := FALSE;
        fbMcSetPosition.Execute := FALSE;
        bCentered := FALSE;
        bHomeDone := FALSE;

END_CASE

// MC_SetPosition runs every cycle - Execute is gated by WaitAlignDone state above
fbMcSetPosition(
    Axis     := GVL_AXES.Axes[1],
    Mode     := 0,
    Position := 0.0
);]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{5e232116-75c2-4521-83ce-1bcd85cc0a68}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
    iMotionStage : I_MotionStage;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.iMotionStage := iMotionStage ;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{8b7d2c0e-fee4-4974-ab5d-80525f1949f0}">
      <Declaration><![CDATA[METHOD Reset
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bHomePulseLatched := FALSE;
iMotionStage.HomeLimit := FALSE;
bCentered := FALSE;
bHomeDone := FALSE;
bLocalError := FALSE;
eHomeIndexState := E_HomeIndexState.Idle;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>