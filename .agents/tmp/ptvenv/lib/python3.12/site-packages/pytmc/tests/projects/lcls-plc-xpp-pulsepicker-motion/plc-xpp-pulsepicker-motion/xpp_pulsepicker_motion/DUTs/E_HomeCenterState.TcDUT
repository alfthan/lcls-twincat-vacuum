<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_HomeCenterState" Id="{2bbefadc-d95d-487b-87e4-8f9db038a221}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_HomeCenterState :
(
    Idle           := 0,   // waiting for NC rising edge of bHoming
    WaitHomeDone   := 1,   // drive homing to switch; wait for bDone AND bHomed
    CenterMove     := 2,   // centering AbsoluteMove issued; wait for completion
    WaitCenterDone := 3,   // MC_SetPosition executing to zero the centered position
    HomingDone     := 4,   // restore motion params, return to Idle
    Error          := 5    // latched error; requires Reset()
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>