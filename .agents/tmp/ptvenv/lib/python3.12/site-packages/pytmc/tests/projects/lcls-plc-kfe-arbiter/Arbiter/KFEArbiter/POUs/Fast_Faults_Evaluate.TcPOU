<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4022.18">
  <POU Name="Fast_Faults_Evaluate" Id="{667ad34f-81ff-0404-3362-bb63097d9547}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Fast_Faults_Evaluate
VAR
FFO    :    FB_FastFault :=(i_DevName := 'PMPS Arbiter',
        i_Desc := 'Fault occurs when the beamline valves on qrixs are not in open state',
        i_TypeCode := 16#1010);
i_xFastFaultOut_qrix_vac AT %I*:        BOOL;

FFO2   :    FB_FastFault :=(i_DevName := 'PMPS Arbiter',
        i_Desc := 'Forward Fault from TXI Vacuum.',
        i_TypeCode := 16#3010);
 {attribute 'TcLinkTo' := 'TIIB[plc-txi-vac]^IO Inputs^FFO'}
i_xFastFaultOut_txi_vac AT %I*:        BOOL;

FFO3    :    FB_FastFault :=(i_DevName := 'PMPS Arbiter',
        i_Desc := 'Forward Fault from TXI Motion.',
        i_TypeCode := 16#3013);
{attribute 'TcLinkTo' := 'TIIB[plc-txi-mot]^IO Inputs^FFO'}
i_xFastFaultOut_txi_mot AT %I*:        BOOL;


FFO4    :    FB_FastFault :=(i_DevName := 'PMPS Arbiter',
        i_Desc := 'Forward Fault from TXI OPTICS.',
        i_TypeCode := 16#3013);
{attribute 'TcLinkTo' := 'TIIB[plc-txi-optics]^IO Inputs^FFO'}
i_xFastFaultOut_txi_optics AT %I*:        BOOL;

(*TXI OPTICS Protection Faults*)

FFO_RIX_TXI_OPTICS :    FB_FastFault :=(i_DevName := 'PMPS Arbiter',
        i_Desc := 'Fault when MR1K1 and/or K3 mirrors are in inconsistent state',
        i_TypeCode := 16#3103);

FFO_TXI_OPTICS :    FB_FastFault :=(i_DevName := 'PMPS Arbiter',
        i_Desc := 'Fault when MR1K3 is OUT and MR2K3 is IN',
        i_TypeCode := 16#3113);
// This is to link 3,4,5,6,7 to an actual cactive fault 2
FFO34567to2link :    FB_FastFault :=(i_DevName := 'Hutch PLC Communication',
        i_Desc := 'Hutch PLC to Arbiter communication error, please check faults below',
        i_TypeCode := 16#00C0);

// This is an RP required FFO
RP_HighBeamPower :    FB_FastFault :=(i_DevName := 'HighPowerBeam fault',
        i_Desc := 'High power beam not allowed to terminate in the FEE',
        i_TypeCode := 16#5AFE);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//RQRIX Forard Fault
FFO(
    io_fbFFHWO := g_FastFaultOutput6,
    i_xOK := i_xFastFaultOut_qrix_vac,
    i_xAutoReset := TRUE);

//TXI Forward Faults
FFO2(
    io_fbFFHWO := g_FastFaultOutput7,
    i_xOK := i_xFastFaultOut_txi_vac,
    i_xAutoReset := TRUE);

FFO3(
    io_fbFFHWO := g_FastFaultOutput7,
    i_xOK := i_xFastFaultOut_txi_mot,
    i_xAutoReset := TRUE);

FFO4(
    io_fbFFHWO := g_FastFaultOutput1,
    i_xOK := i_xFastFaultOut_txi_optics,
    i_xAutoReset := TRUE);


(*TXI OPTICS Protection Faults*)
(* MR1K1 | MR1K3 | MR2K3 | Fault *)
(*  IN   |  IN   |  OUT  | TRUE  *)
(*  IN   |  OUT  |  IN   | TRUE  *)
(*  IN   |  IN   |  IN   | TRUE  *)
(*  OUT  |  IN   |  OUT  | TRUE  *)
(*  OUT  |  OUT  |  IN   | TRUE  *)

FFO_RIX_TXI_OPTICS(
    io_fbFFHWO := g_FastFaultOutput1,
    i_xOK := (PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K1_IN] AND NOT PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K1_OUT])
                AND ((PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K3_OUT] AND NOT PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K3_IN])
                    AND (PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR2K3_OUT] AND NOT PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR2K3_IN]))
                OR (PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K1_OUT] AND NOT PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K1_IN]) ,
    i_xAutoReset := TRUE);

FFO_TXI_OPTICS(
    io_fbFFHWO := g_FastFaultOutput1,
    i_xOK := (PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K3_OUT] AND NOT PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K3_IN]
                    AND PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR2K3_OUT] AND NOT PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR2K3_IN])
                OR (PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K3_IN] AND NOT PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K3_OUT]
                    AND PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR2K3_IN] AND NOT PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR2K3_OUT])  ,
    i_xAutoReset := TRUE);

FFO34567to2link(
	  io_fbFFHWO := g_FastFaultOutput2,
	   i_xOK := g_FastFaultOutput3.q_xFastFaultOut AND g_FastFaultOutput4.q_xFastFaultOut AND g_FastFaultOutput5.q_xFastFaultOut AND g_FastFaultOutput6.q_xFastFaultOut AND g_FastFaultOutput7.q_xFastFaultOut ,
       i_xAutoReset := TRUE);
	
// RP requested fault
RP_HighBeamPower(
io_fbFFHWO := g_FastFaultOutput1,
i_xOK := ((PMPS_GVL.stCurrentBeamParameters.nBeamClass >9 AND PMPS_GVL.stCurrentBeamParameters.nTran >=0.4) (*High Power Beam*)
             AND ((PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K1_OUT] AND NOT PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.ST3K4]) (* Beam in TMO*)
               OR (PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K1_IN] AND  NOT PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.ST1K2]))) (*BEAM in RIX*)
            OR (PMPS_GVL.stCurrentBeamParameters.nBeamClass<=9)(*LOW Power Beam *)
            OR ((PMPS_GVL.stCurrentBeamParameters.nBeamClass>=9) AND (PMPS_GVL.stCurrentBeamParameters.nTran <0.4))
            OR PMPS_GVL.stCurrentBeamParameters.nMachineMode = 0, // Machine is running in NC mode
i_xAutoReset := FALSE);

//Execute /evaulate FFOs
// Evaluate fast fault No Vetos
g_FastFaultOutput1.Execute();
g_FastFaultOutput2.EvaluateOutput(bAutoReset:=TRUE);
// Evaluate fast fault vetos TMO
//TMO-OPTICS Veto	MR1K1_IN
g_FastFaultOutput3.Execute(i_xVeto:= PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K1_IN],bAutoReset:=TRUE);
// TMO-VAC and TMO-MOT ST3K4_IN
g_FastFaultOutput4.Execute(i_xVeto:= PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.ST3K4],bAutoReset:=TRUE);
// Evaluate fast fault vetos RIX
// RIX-VAC and RIX-MOT MR1K1_OUT
g_FastFaultOutput5.Execute(i_xVeto:= PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K1_OUT],bAutoReset:=TRUE);
// QRIX-VAC, CRIX-VAC and CRIX-MOT MR1K1_OUT OR ST1K2_IN
g_FastFaultOutput6.Execute(i_xVeto:= PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K1_OUT] OR PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.ST1K2],bAutoReset:=TRUE);
// Evaluate fast fault vetos TXI
// TXI-VAC and TXI-MOT 	MR1K3_OUT and MR2K3_OUT
g_FastFaultOutput7.Execute(i_xVeto:= PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR1K3_OUT] AND PMPS_GVL.stCurrentBeamParameters.aVetoDevices[PMPS.K_Stopper.MR2K3_OUT],bAutoReset:=TRUE);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>