<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PPEPS" Id="{5f3aae40-c1c6-4266-a74b-6665ebe7f2a9}" SpecialFunc="None">
    <Declaration><![CDATA[//  Pulse-picker EPS interlock for the X/Y stage.
//
//  EPS channel model: each FB_EPS channel (forward / backward / power) ANDs all
//  its bits into a per-channel bEPS_OK. The drive section enables/powers a
//  channel only when that channel's bEPS_OK is TRUE (every bit released).
//
//  Homing gates the POWER channel ONLY.
FUNCTION_BLOCK FB_PPEPS
VAR_INPUT
    bPickActive : BOOL;
    {attribute 'pytmc' := '
        pv: 02:bXEpsBypass
        io: io
        field: DESC X ByPass EPS
    '}
    bXBypass: BOOL;
    {attribute 'pytmc' := '
        pv: 03:bYEpsBypass
        io: io
        field: DESC Y ByPass EPS
    '}
    bYBypass : BOOL;
END_VAR
VAR
    iXMotionStage	: I_MotionStage;
    iYMotionStage	: I_MotionStage;
    iXEPS : I_EPS;
    iYEPS : I_EPS;
    bXHoming : BOOL;
    bYHoming : BOOL;
    yMin     : LREAL;
    yMax     : LREAL;
END_VAR

VAR_OUTPUT
    bXMoveAllowed  : BOOL;
    bYMoveAllowed  : BOOL;
    bXHomeAllowed  : BOOL;
    bYHomeAllowed  : BOOL;
    bXInCenter     : BOOL;
    bYAboveMed     : BOOL;
    bXTowardCenter : BOOL;
END_VAR

VAR PERSISTENT
    {attribute 'pytmc' := '
        pv: 02:fXLimMin
        io: i
        field: DESC X Travel Limit Min
    '}
    fXLimMin : LREAL := -5.1;

    {attribute 'pytmc' := '
        pv: 02:fXLimMax
        io: i
        field: DESC X Travel Limit Max
    '}
    fXLimMax : LREAL := 5.1;

    {attribute 'pytmc' := '
        pv: 02:fXCenterLimMin
        io: i
        field: DESC X Center Window Min
    '}
    fXCenterLimMin : LREAL := -0.5;

    {attribute 'pytmc' := '
        pv: 02:fXCenterLimMax
        io: i
        field: DESC X Center Window Max
    '}
    fXCenterLimMax : LREAL := 0.5;

    {attribute 'pytmc' := '
        pv: 03:fYLimMin
        io: i
        field: DESC Y Travel Limit Min
    '}
    fYLimMin : LREAL := -0.1;

    {attribute 'pytmc' := '
        pv: 03:fYLimMedium
        io: i
        field: DESC Y Critical Threshold
    '}
    fYLimMedium : LREAL := 10.0;

    {attribute 'pytmc' := '
        pv: 03:fYLimMax
        io: i
        field: DESC Y Travel Limit Max
    '}
    fYLimMax : LREAL := 20.1;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[bXInCenter := (iXMotionStage.MotionStatus.fActPosition >= fXCenterLimMin) AND
              (iXMotionStage.MotionStatus.fActPosition <= fXCenterLimMax);
bYAboveMed := iYMotionStage.MotionStatus.fActPosition > fYLimMedium;

//  bExecute is the drive-section confirmation of a FRESH home request; combined
//  with eCommand=HOME it distinguishes a live request from a stale, held command
bXHoming := iXMotionStage.ExMotionStatus.bNewMoveReq AND (iXMotionStage.MotionStatus.eCommand = E_EpicsMotorCmd.HOME);
bYHoming := iYMotionStage.ExMotionStatus.bNewMoveReq AND (iYMotionStage.MotionStatus.eCommand = E_EpicsMotorCmd.HOME);

//  Y move interlock
yMin := fYLimMin;
IF bYAboveMed THEN
    bYMoveAllowed := bXInCenter;
ELSE
    yMax := SEL(bXInCenter, fYLimMedium, fYLimMax);
    bYMoveAllowed := (iYMotionStage.MotionCmd.fPosition >= yMin) AND
                     (iYMotionStage.MotionCmd.fPosition <= yMax);
END_IF

//  X move interlock
IF bYAboveMed THEN
    IF bXInCenter THEN
        bXMoveAllowed := (iXMotionStage.MotionCmd.fPosition >= fXCenterLimMin) AND
                         (iXMotionStage.MotionCmd.fPosition <= fXCenterLimMax);
    ELSE
        //  Outside center with Y high: only allow motion that moves TOWARD center.
        bXTowardCenter := (iXMotionStage.MotionStatus.fActPosition < fXCenterLimMin AND
                           iXMotionStage.MotionCmd.fPosition > iXMotionStage.MotionStatus.fActPosition) OR
                          (iXMotionStage.MotionStatus.fActPosition > fXCenterLimMax AND
                           iXMotionStage.MotionCmd.fPosition < iXMotionStage.MotionStatus.fActPosition);
        bXMoveAllowed := bXTowardCenter;
    END_IF
ELSE
    bXMoveAllowed := (iXMotionStage.MotionCmd.fPosition >= fXLimMin) AND
                     (iXMotionStage.MotionCmd.fPosition <= fXLimMax);
END_IF

//  Y homing interlock: gates POWER only, never directional
IF bYHoming THEN
    bYHomeAllowed := bXInCenter;
ELSE
    bYHomeAllowed := TRUE;
END_IF

//  X homing interlock: gates POWER only, never directional
IF bXHoming THEN
    bXHomeAllowed := NOT bYAboveMed;
ELSE
    bXHomeAllowed := TRUE;
END_IF

//  Picker active overrules all
//  The EPS bit writes below also enforce this at the bit level (picker bit0 and
//  the NOT bPickActive wrapper on the move bit).
IF bPickActive THEN
    bXMoveAllowed := FALSE;
    bYMoveAllowed := FALSE;
    bXHomeAllowed := FALSE;
    bYHomeAllowed := FALSE;
END_IF

//
//  DIRECTIONAL (forward / backward):
//    bit 0 : picker gate  NOT bPickActive, never bypassable
//    bit 1 : move interlock OR bypass, picker still absolute
//            = NOT bPickActive AND (bBypass OR bMoveAllowed)
//    Gated by the MOVE interlock only; NEVER by homing (avoids faking the limit
//    switch). Both bits 1 => directional bEPS_OK TRUE.
//
//  POWER:
//    bit 0 : picker gate  NOT bPickActive, never bypassable
//    bit 1 : homing gate  SEL(bHoming, TRUE, bHomeAllowed)
//            not homing       -> TRUE  (released; power depends only on picker)
//            homing requested -> bHomeAllowed (TRUE only if home permitted)
//    Both bits 1 => power bEPS_OK TRUE => drive section grants power.
//    Bypass does NOT touch the power channel.

//  X directional: move interlock + bypass, picker absolute
iXEPS.setBitForward (nBits := 0, bValue := NOT bPickActive);
iXEPS.setBitBackward(nBits := 0, bValue := NOT bPickActive);
iXEPS.setBitForward (nBits := 1, bValue := NOT bPickActive AND (bXBypass OR bXMoveAllowed));
iXEPS.setBitBackward(nBits := 1, bValue := NOT bPickActive AND (bXBypass OR bXMoveAllowed));
//  X power: picker gate + homing gate (not bypassable)
iXEPS.setBitPower   (nBits := 0, bValue := NOT bPickActive);
iXEPS.setBitPower   (nBits := 1, bValue := SEL(bXHoming, TRUE, bXHomeAllowed));

//  Y directional: move interlock + bypass, picker absolute
iYEPS.setBitForward (nBits := 0, bValue := NOT bPickActive);
iYEPS.setBitBackward(nBits := 0, bValue := NOT bPickActive);
iYEPS.setBitForward (nBits := 1, bValue := NOT bPickActive AND (bYBypass OR bYMoveAllowed));
iYEPS.setBitBackward(nBits := 1, bValue := NOT bPickActive AND (bYBypass OR bYMoveAllowed));
//  Y power - picker gate + homing gate (not bypassable)
iYEPS.setBitPower   (nBits := 0, bValue := NOT bPickActive);
iYEPS.setBitPower   (nBits := 1, bValue := SEL(bYHoming, TRUE, bYHomeAllowed));
]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{b3a7243a-7686-4384-9b11-f298fc664985}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
    iXMotionStage	: I_MotionStage;
    iYMotionStage	: I_MotionStage;
    iXEPS : I_EPS;
    iYEPS : I_EPS;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.iXMotionStage := iXMotionStage;
THIS^.iYMotionStage := iYMotionStage;
THIS^.iXEPS := iXEPS;
THIS^.iYEPS := iYEPS;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>