<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_XY" Id="{7166b72e-c262-4a7d-a8f3-0d9bbbc8710e}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_XY
VAR
     {attribute 'pytmc' := '
        axis-link: GVL_Axes.Axes[2]
        pv: SH1L2:PP:MMS:02
    '}
    {attribute 'TcLinkTo' := '.fbLimSwStatus.bLimitFwd  := TIIB[XY]^DI Inputs Channel 1^Input 2;
                              .fbLimSwStatus.bLimitBwd := TIIB[XY]^DI Inputs Channel 1^Input 1;
                              .fbEncoderScaling.nRawEncoderUDINT  := TIIB[XY]^FB Position Channel 1^Position'}
    fbX : FB_MotionStageNC(
        sName                  := 'PP_X',
        AxisRef                := GVL_Axes.Axes[2],
        iPersistentDataStorage := GVL_Common.fbPersistentDataStorage
    ) := (HomeMode := E_EpicsHomeCmd.LOW_LIMIT);

    {attribute 'pytmc' := '
        axis-link: GVL_Axes.Axes[3]
        pv: SH1L2:PP:MMS:03
    '}
    {attribute 'TcLinkTo' := '.fbLimSwStatus.bLimitFwd  := TIIB[XY]^DI Inputs Channel 2^Input 1;
                              .fbLimSwStatus.bLimitBwd := TIIB[XY]^DI Inputs Channel 2^Input 2;
                              .fbEncoderScaling.nRawEncoderUDINT  := TIIB[XY]^FB Position Channel 2^Position'}
    fbY : FB_MotionStageNC(
        sName                  := 'PP_Y',
        AxisRef                := GVL_Axes.Axes[3],
        iPersistentDataStorage := GVL_Common.fbPersistentDataStorage
    ) := (HomeMode := E_EpicsHomeCmd.LOW_LIMIT);

    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:02
    '}
    fbXEPS : LCLS_MotionAbstraction.FB_EPS;

    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:03
    '}
    fbYEPS : LCLS_MotionAbstraction.FB_EPS;

    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS
    '}
    fbPPEPS : FB_PPEPS (
        iXEPS  := fbXEPS,
        iYEPS  := fbYEPS,
        iXMotionStage:=fbX,
        iYMotionStage:=fbY
    );
    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:02
    '}
    fbXHome : FB_HomeToCenter(
        iMotionStage:=fbX
    );
    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:03
    '}
    fbYHome : FB_HomeToCenter(iMotionStage:=fbY);
    bInit   : BOOL := TRUE;

END_VAR

VAR PERSISTENT
    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:02:fXCenterOffset
        io: io
        field: DESC Centering Offset
    '}
    fXCenterOffset: LREAL := 2.5;

    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:03:fYCenterOffset
        io: io
        field: DESC Centering Offset
    '}
    fYCenterOffset: LREAL := 6.5;

    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:03:fInOutThrsh
        io: io
        field: DESC In/Out Threshold
    '}
    fInOutThrsh : LREAL;

    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:03:eInOutStatus
        io: i
        field: DESC In/Out Status
    '}
    eInOutStatus : E_PPStatus;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bInit THEN
    fbX.AssignEPS(iEPS:=fbXEPS);
    fbX.SetModeEnableLimits(
        LimBackward     := TRUE,
        LimForward      := TRUE,
        HomeEnable      := FALSE,
        BrakeMode       := E_StageBrakeMode.IF_ENABLED,
        EnableMode      := E_StageEnableMode.DURING_MOTION,
        HomeMode        := 1,
        UserEnable      := TRUE,
        HardwareEnable  := TRUE
    );
    fbX.SetDefaultMotionParameters (
        HomePosition    := 0.0,
        Velocity        := 3.0,
    );
    // Y
    fbY.AssignEPS(iEPS:=fbYEPS);
    fbY.SetModeEnableLimits(
        LimBackward     := TRUE,
        LimForward      := TRUE,
        HomeEnable      := FALSE,
        BrakeMode       := E_StageBrakeMode.IF_ENABLED,
        EnableMode      := E_StageEnableMode.DURING_MOTION,
        HomeMode        := 1,
        UserEnable      := TRUE,
        HardwareEnable  := TRUE
    );
    fbY.SetDefaultMotionParameters (
        HomePosition    := 0.0,
        Velocity        := 4.0,
    );
   bInit := FALSE;
END_IF

fbPPEPS(
    bPickActive := GVL_Common.eModeSelect <> E_ModeSelector.ModeNone
);

fbX();
fbXHome(
    fCenterOffset    := fXCenterOffset,
    fDefaultVelocity := fbX.MotionCmd.fVelocity
);

fbY();
fbYHome(
    fCenterOffset    := fYCenterOffset,
    fDefaultVelocity := fbY.MotionCmd.fVelocity
);

// Pulse Picker status (Given Y axis moving up is from 0-20.1mm)
IF NOT fbY.MotionStatus.bMoving THEN
    IF fbY.MotionStatus.fActPosition > fInOutThrsh THEN
        eInOutStatus := E_PPStatus.OUT;
    ELSE
        eInOutStatus := E_PPStatus.IN;
    END_IF
ELSE
    eInOutStatus := E_PPStatus.UNKNOWN;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>