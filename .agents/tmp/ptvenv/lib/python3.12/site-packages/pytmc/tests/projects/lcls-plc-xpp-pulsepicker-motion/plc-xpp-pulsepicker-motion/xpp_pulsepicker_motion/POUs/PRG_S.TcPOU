<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_S" Id="{7534196b-5208-4624-b3e1-4d0093be325e}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_S
VAR
    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:01:eModeSelector
        io: io
        field: DESC Pulse Picker mode selector
    '}
    eModeReq    : E_ModeSelector := E_ModeSelector.ModeNone;
    eStatus     : E_StatusIndicator;
    ePickState  : E_PickerState := E_PickerState.Init;
    eState      : INT := 0;

    {attribute 'pytmc' := '
        axis-link: GVL_Axes.Axes[1]
        pv: SH1L2:PP:MMS:01
    '}
    {attribute 'TcLinkTo' := '.fbEncoderScaling.nRawEncoderUDINT := TIIB[Spindle]^FB Position Channel 1^Position'}
    fbS : FB_MotionStageNC(
        sName    := 'Spindle',
        AxisRef  := GVL_Axes.Axes[1],
        iPersistentDataStorage := GVL_Common.fbPersistentDataStorage
    ) := (HomeMode := E_EpicsHomeCmd.HOME_INDEX);

    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:01
    '}
    fbTrigMgr : FB_TriggerSetpointManager(
        AxisRef      := GVL_Axes.Axes[1],
        iMotionStage := fbS
    );

    nErrCode : INT := 0;

    fbMoveNearest : FB_MoveToNearestClosed(iMotionStage := fbS);
    fbFastOpen    : FB_FastOpen(iMotionStage := fbS);
    fbFastClose   : FB_FastClose(iMotionStage := fbS);

    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:01
    '}
    fbHomeIdx : FB_SpindleHomeToCenter(iMotionStage := fbS);

    bPicking   : BOOL;
    ftStopPick : F_TRIG;

END_VAR

VAR PERSISTENT
    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:01:fCenterOffset
        io: io
        field: DESC Center Position Offset
    '}
    fCenterOffset : LREAL := 113.247;

    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:01:fStopPos
        io: io
        field: DESC End Stop Positive
    '}
    fStopPos : LREAL := 11.25;

    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:01:fStopNeg
        io: io
        field: DESC End Stop Negative
    '}
    fStopNeg : LREAL := -12.5;

    {attribute 'pytmc' := '
        pv: SH1L2:PP:MMS:01:fCenter
        io: io
        field: DESC Center Position
    '}
    fCenter : LREAL := 0.0;

    fDefVel : LREAL := 1650;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE ePickState OF

    // INIT ALL
    E_PickerState.Init:
        fbS.SetModeEnableLimits(
            LimBackward    := TRUE,
            LimForward     := TRUE,
            HomeEnable     := FALSE,
            BrakeMode      := E_StageBrakeMode.IF_ENABLED,
            EnableMode     := E_StageEnableMode.ALWAYS,
            HomeMode       := E_EpicsHomeCmd.HOME_INDEX,
            UserEnable     := TRUE,
            HardwareEnable := TRUE
        );
        fbS.SetDefaultMotionParameters(
            HomePosition := 0.0,
            Velocity     := fDefVel,
        );

        // Enable backlash (negative) compensation
        fbS.BacklashCompensation(Enable:=TRUE, RampVelo:=fDefVel/10.0);
        // the backlash value provided here is from demo (must be adapted for prod)
        fbTrigMgr.Reset();
        GVL_Common.eModeSelect := E_ModeSelector.ModeNone;
        ePickState := E_PickerState.ModeSelect;

    // WAIT USER MODE SELECT
    E_PickerState.ModeSelect:
        bPicking := FALSE;
        fbTrigMgr.Stop();
        IF fbS.MotionStatus.bError THEN
            ePickState := E_PickerState.ErrorState;
        ELSIF eModeReq <> E_ModeSelector.ModeNone THEN
            GVL_Common.eModeSelect := eModeReq;
            eStatus    := E_StatusIndicator.Init;
            ePickState := E_PickerState.ModeExecute;
        END_IF

    // MAIN MODE EXECUTE
    E_PickerState.ModeExecute:
        CASE GVL_Common.eModeSelect OF
            E_ModeSelector.FlipFlop, E_ModeSelector.Burst:
                CASE eStatus OF
                    E_StatusIndicator.Init:
                        bPicking := TRUE;
                        fbTrigMgr.Stop();
                        IF fbS.MotionStatus.bPowerIsEnabled THEN
                            fbMoveNearest.Start();
                        END_IF
                        eStatus := E_StatusIndicator.Closed;

                    E_StatusIndicator.Closed:
                        IF fbMoveNearest.Closed THEN
                            fbTrigMgr.Start();
                            eStatus := E_StatusIndicator.Wait;
                        END_IF

                    E_StatusIndicator.Wait:
                        IF eModeReq = E_ModeSelector.ModeNone THEN
                            eStatus    := E_StatusIndicator.Init;
                            GVL_Common.eModeSelect := E_ModeSelector.ModeNone;
                            ePickState := E_PickerState.ModeSelect;
                        ELSIF eModeReq = E_ModeSelector.Close THEN
                            fbTrigMgr.Stop();
                            GVL_Common.eModeSelect := E_ModeSelector.Close;
                            eStatus    := E_StatusIndicator.Init;
                            ePickState := E_PickerState.ModeExecute;
                        ELSIF eModeReq = E_ModeSelector.Open THEN
                            fbTrigMgr.Stop();
                            GVL_Common.eModeSelect := E_ModeSelector.Open;
                            eStatus    := E_StatusIndicator.Init;
                            ePickState := E_PickerState.ModeExecute;
                        END_IF
                END_CASE

            E_ModeSelector.Close:
                CASE eStatus OF
                    E_StatusIndicator.Init:
                        fbFastClose.Start();
                        eStatus := E_StatusIndicator.Closed;
                    E_StatusIndicator.Closed:
                        IF fbFastClose.Closed THEN
                            eModeReq	:= E_ModeSelector.ModeNone;
                            GVL_Common.eModeSelect := E_ModeSelector.ModeNone;
                            eStatus    := E_StatusIndicator.Init;
                            ePickState := E_PickerState.ModeSelect;
                        END_IF
                END_CASE

            E_ModeSelector.Open:
                CASE eStatus OF
                    E_StatusIndicator.Init:
                        fbFastOpen.Start();
                        eStatus := E_StatusIndicator.Opened;
                    E_StatusIndicator.Opened:
                        IF fbFastOpen.Opened THEN
                            eModeReq	:= E_ModeSelector.ModeNone;
                            GVL_Common.eModeSelect := E_ModeSelector.ModeNone;
                            eStatus    := E_StatusIndicator.Init;
                            ePickState := E_PickerState.ModeSelect;
                        END_IF
                END_CASE

            E_ModeSelector.Home:
                CASE eStatus OF
                    E_StatusIndicator.Init:
                        IF fbS.MotionStatus.bMoving THEN
                            fbS.Halt();
                        END_IF
                        eStatus := E_StatusIndicator.Closed;
                    E_StatusIndicator.Closed:
                        IF fbS.MotionStatus.bDone OR NOT fbS.MotionStatus.bMoving THEN
                            fbS.Home(
                                HomePosition := 0.0,
                                HomeMode     := E_EPicsHomeCmd.HOME_INDEX
                            );
                            eStatus := E_StatusIndicator.Done;
                        END_IF
                    E_StatusIndicator.Done:
                        IF fbHomeIdx.bCentered THEN
                            eModeReq               := E_ModeSelector.ModeNone;
                            GVL_Common.eModeSelect := E_ModeSelector.ModeNone;
                            eStatus    := E_StatusIndicator.Init;
                            ePickState := E_PickerState.ModeSelect;
                        END_IF
                END_CASE

            ELSE
                eStatus                := E_StatusIndicator.Init;
                GVL_Common.eModeSelect := E_ModeSelector.ModeNone;
                ePickState             := E_PickerState.ModeSelect;
        END_CASE

    E_PickerState.ErrorState:
        fbTrigMgr.Stop();
        IF NOT fbS.MotionStatus.bError THEN
            ePickState := E_PickerState.ModeSelect;
        END_IF

    ELSE
        ePickState := E_PickerState.Init;
END_CASE

// Global reset / halt overrides
IF fbS.MotionCmd.bReset THEN
    fbTrigMgr.Reset();
    fbHomeIdx.Reset();
    fbS.ExMotionStatus.bLatchReset := FALSE;
    eModeReq               := E_ModeSelector.ModeNone;
    GVL_Common.eModeSelect := E_ModeSelector.ModeNone;
    eStatus    := E_StatusIndicator.Init;
    ePickState := E_PickerState.ModeSelect;
ELSIF fbS.MotionCmd.bHalt AND (GVL_Common.eModeSelect <> E_ModeSelector.Home) THEN
    fbTrigMgr.Stop();
    eModeReq               := E_ModeSelector.ModeNone;
    GVL_Common.eModeSelect := E_ModeSelector.ModeNone;
    eStatus    := E_StatusIndicator.Init;
    ePickState := E_PickerState.ModeSelect;
END_IF

fbTrigMgr(
    Mode := eModeReq,
    fStopPos:=fStopPos,
    fStopNeg:=fStopNeg,
    fCenter:=fCenter
);

fbMoveNearest();

fbFastOpen(
    fCenter:=fCenter
);

fbFastClose(
    fStopPos:=fStopPos
);

fbHomeIdx(
    fCenterOffset    := fCenterOffset,
    fDefaultVelocity := fDefVel
);

fbS();
IF fbS.MotionStatus.bError AND fbS.MotionStatus.bStageReady THEN
    ePickState := E_PickerState.ErrorState;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>