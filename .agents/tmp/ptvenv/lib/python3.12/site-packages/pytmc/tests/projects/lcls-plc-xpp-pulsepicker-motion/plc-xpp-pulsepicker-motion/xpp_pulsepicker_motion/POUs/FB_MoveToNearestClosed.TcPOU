<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MoveToNearestClosed" Id="{6ed107c2-bebb-4576-9274-e415e2ee6172}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MoveToNearestClosed
VAR_OUTPUT
    Closed   : BOOL;
END_VAR
VAR
    iMotionStage 		: I_MotionStage;
    fEndpointPositive  : LREAL :=  11.25;
    fEndpointNegative  : LREAL := -11.25;
    fTarget            : LREAL := 0.0;
    bStarted: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Closed := FALSE;
IF 	bStarted THEN
    IF iMotionStage.MotionStatus.bDone THEN
        Closed := TRUE;
        bStarted := FALSE;
    END_IF
END_IF
]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{d19b4830-b739-4f72-bb4a-99a9c85524b7}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
    iMotionStage : I_MotionStage;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.iMotionStage := iMotionStage ;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{70fa49d8-d54b-4879-afbc-54860b8a35fc}">
      <Declaration><![CDATA[METHOD Start
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Choose closest endpoint
IF ABS(iMotionStage.MotionStatus.fActPosition - fEndpointPositive) < ABS(iMotionStage.MotionStatus.fActPosition - fEndpointNegative) THEN
    fTarget := fEndpointPositive;
ELSE
    fTarget := fEndpointNegative;
END_IF
// Issue move command
iMotionStage.AbsoluteMove(
   Position     := fTarget,
   Velocity     := iMotionStage.MotionCmd.fVelocity,
   Acceleration := iMotionStage.MotionCmd.fAcceleration,
   Deceleration := iMotionStage.MotionCmd.fDeceleration
);

bStarted := TRUE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>