<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FastOpen" Id="{c73d2697-7522-4d8d-b835-3670f2667cbf}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK  FB_FastOpen
VAR_INPUT
    fCenter	: LREAL;
END_VAR
VAR_OUTPUT
    Opened   : BOOL;
END_VAR

VAR
    iMotionStage	: I_MotionStage;
    bStarted : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF (iMotionStage = 0)  THEN
    RETURN;
END_IF

Opened := FALSE;
IF 	bStarted THEN
    IF iMotionStage.MotionStatus.bDone THEN
        Opened := TRUE;
        bStarted := FALSE;
    END_IF
END_IF
]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{749ff317-3d03-4048-b05e-7a300d9a9ca1}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
    iMotionStage : I_MotionStage;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.iMotionStage := iMotionStage ;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{b0724d60-369f-427e-8500-c1421ebea1ab}">
      <Declaration><![CDATA[METHOD Start : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Issue move command
iMotionStage.AbsoluteMoveDefault(
   Position     := fCenter,
   Velocity     := iMotionStage.MotionCmd.fVelocity,
);
bStarted := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>