<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG" Id="{7ddf7142-3738-4120-8059-c5d2220b5135}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG
VAR
    fbPersistentDataStorage : LCLS_Tc_DevAbs.FB_PersistentDataStorage;
    stDefault : ST_PositionState := (
        fDelta        := 0.5,
        bMoveOk       := TRUE,
        bValid        := TRUE,
        bUseRawCounts := FALSE
    );

    {attribute 'pytmc' := '
        pv: TST:D1
        io: io
        array: 1..4
        axis-link: GVL_Axes.Axes[1], GVL_Axes.Axes[2], GVL_Axes.Axes[3], GVL_Axes.Axes[4]
        expand-names: D1M1, D1M2, D1M3, D1M4
    '}
    afbMotorsNCD1 : ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF FB_MotionStageNC[
        (AxisRef := GVL_Axes.Axes[1], iPersistentDataStorage := fbPersistentDataStorage, sName := 'D1M1'),
        (AxisRef := GVL_Axes.Axes[2], iPersistentDataStorage := fbPersistentDataStorage, sName := 'D1M2'),
        (AxisRef := GVL_Axes.Axes[3], iPersistentDataStorage := fbPersistentDataStorage, sName := 'D1M3'),
        (AxisRef := GVL_Axes.Axes[4], iPersistentDataStorage := fbPersistentDataStorage, sName := 'D1M4')
    ];
    aiMotionStageD1     	:  ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage
                        := [afbMotorsNCD1[1], afbMotorsNCD1[2], afbMotorsNCD1[3], afbMotorsNCD1[4]];
    {attribute 'pytmc' := '
        pv: TST:D1:STATE
        io: io
        array: 1..4 | 1..4
        expand-names: D1M1, D1M2, D1M3, D1M4
    '}
    astPositionStateD1 : ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;

    afbStateConfigD1 : ARRAY[1..MotionConstants.MAX_STATE_MOTORS * GeneralConstants.MAX_STATES]
        OF FB_StateConfigurator[
        // Motor 1
        (stPositionState := astPositionStateD1[1][E_State.OUT],      stDefault := stDefault, bSetDefault:= TRUE, sName := 'OUT',      fPosition := 100.0),
        (stPositionState := astPositionStateD1[1][E_State.TARGET1A], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1A', fPosition := 200.0),
        (stPositionState := astPositionStateD1[1][E_State.TARGET1B], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1B', fPosition := 300.0),
        (stPositionState := astPositionStateD1[1][E_State.TARGET1C], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1C', fPosition := 400.0),
        // Motor 2
        (stPositionState := astPositionStateD1[2][E_State.OUT],      stDefault := stDefault, bSetDefault:= TRUE, sName := 'OUT',      fPosition := 100.0),
        (stPositionState := astPositionStateD1[2][E_State.TARGET1A], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1A', fPosition := 200.0),
        (stPositionState := astPositionStateD1[2][E_State.TARGET1B], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1B', fPosition := 300.0),
        (stPositionState := astPositionStateD1[2][E_State.TARGET1C], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1C', fPosition := 400.0),
        // Motor 3
        (stPositionState := astPositionStateD1[3][E_State.OUT],      stDefault := stDefault, bSetDefault:= TRUE, sName := 'OUT',      fPosition := 100.0),
        (stPositionState := astPositionStateD1[3][E_State.TARGET1A], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1A', fPosition := 200.0),
        (stPositionState := astPositionStateD1[3][E_State.TARGET1B], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1B', fPosition := 300.0),
        (stPositionState := astPositionStateD1[3][E_State.TARGET1C], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1C', fPosition := 400.0),
        // Motor 4
        (stPositionState := astPositionStateD1[4][E_State.OUT],      stDefault := stDefault, bSetDefault:= TRUE, sName := 'OUT',      fPosition := 100.0),
        (stPositionState := astPositionStateD1[4][E_State.TARGET1A], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1A', fPosition := 200.0),
        (stPositionState := astPositionStateD1[4][E_State.TARGET1B], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1B', fPosition := 300.0),
        (stPositionState := astPositionStateD1[4][E_State.TARGET1C], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1C', fPosition := 400.0)
    ];
    {attribute 'pytmc' := '
          pv: TST:D1:STATE:SET
          io: io
    '}
    eEnumSetD1          	: E_State;
    {attribute 'pytmc' := '
          pv: TST:D1:STATE:GET
          io: i
    '}
    eEnumGetD1          	: E_State;

    {attribute 'pytmc' := 'pv: TST:D1'}
    fbPositionStateND1 : FB_PositionStateND(
        aiMotionStage    := aiMotionStageD1,
        astPositionState := astPositionStateD1,
        eEnumSet         := eEnumSetD1,
        eEnumGet         := eEnumGetD1,
        nActiveMotorCount    := 4,
        bEnableMotion	:= TRUE,
        eMotionRequestPolicy := E_MotionRequestPolicy.INTERRUPT,
    );

    {attribute 'pytmc' := '
        pv: TST:D2
        io: io
        array: 1..3
        axis-link: GVL_Axes.Axes[5], GVL_Axes.Axes[6], GVL_Axes.Axes[7]
        expand-names: D2M1, D2M2, D2M3
    '}
    afbMotorsNCD2 : ARRAY[1..(MotionConstants.MAX_STATE_MOTORS-1)] OF FB_MotionStageNC[
        (AxisRef := GVL_Axes.Axes[5], iPersistentDataStorage := fbPersistentDataStorage, sName := 'D2M1'),
        (AxisRef := GVL_Axes.Axes[6], iPersistentDataStorage := fbPersistentDataStorage, sName := 'D2M2'),
        (AxisRef := GVL_Axes.Axes[7], iPersistentDataStorage := fbPersistentDataStorage, sName := 'D2M3')
    ];
    aiMotionStageD2     	:  ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage
                        := [afbMotorsNCD2[1], afbMotorsNCD2[2], afbMotorsNCD2[3]];
    {attribute 'pytmc' := '
        pv: TST:D2:STATE
        io: io
        array: 1..3 | 1..3
        expand-names: D2M1, D2M2, D2M3
    '}
    astPositionStateD2 : ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    afbStateConfigD2 : ARRAY[1..((MotionConstants.MAX_STATE_MOTORS-1) * (GeneralConstants.MAX_STATES-1))]
        OF FB_StateConfigurator[
        // Motor 1
        (stPositionState := astPositionStateD2[1][E_State.OUT],      stDefault := stDefault, bSetDefault:= TRUE, sName := 'OUT',      fPosition := 100.0),
        (stPositionState := astPositionStateD2[1][E_State.TARGET1A], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1A', fPosition := 200.0),
        (stPositionState := astPositionStateD2[1][E_State.TARGET1B], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1B', fPosition := 300.0),
        // Motor 2
        (stPositionState := astPositionStateD2[2][E_State.OUT],      stDefault := stDefault, bSetDefault:= TRUE, sName := 'OUT',      fPosition := 100.0),
        (stPositionState := astPositionStateD2[2][E_State.TARGET1A], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1A', fPosition := 200.0),
        (stPositionState := astPositionStateD2[2][E_State.TARGET1B], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1B', fPosition := 300.0),
        // Motor 3
        (stPositionState := astPositionStateD2[3][E_State.OUT],      stDefault := stDefault, bSetDefault:= TRUE, sName := 'OUT',      fPosition := 100.0),
        (stPositionState := astPositionStateD2[3][E_State.TARGET1A], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1A', fPosition := 200.0),
        (stPositionState := astPositionStateD2[3][E_State.TARGET1B], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1B', fPosition := 300.0)
    ];
    {attribute 'pytmc' := '
          pv: TST:D2:STATE:SET
          io: io
    '}
    eEnumSetD2          	: E_State;
    {attribute 'pytmc' := '
          pv: TST:D2:STATE:GET
          io: i
    '}
    eEnumGetD2          	: E_State;

    {attribute 'pytmc' := 'pv: TST:D2'}
    fbPositionStateND2 : FB_PositionStateND(
        aiMotionStage    := aiMotionStageD2,
        astPositionState := astPositionStateD2,
        eEnumSet         := eEnumSetD2,
        eEnumGet         := eEnumGetD2,
        nActiveMotorCount    := 3,
        bEnableMotion	:= TRUE,
        eMotionRequestPolicy := E_MotionRequestPolicy.INTERRUPT,
    );

    {attribute 'pytmc' := '
        pv: TST:D3
        io: io
        array: 1..2
        axis-link: GVL_Axes.Axes[8], GVL_Axes.Axes[9]
        expand-names: D3M1, D3M2
    '}
    afbMotorsNCD3 : ARRAY[1..(MotionConstants.MAX_STATE_MOTORS-2)] OF FB_MotionStageNC[
        (AxisRef := GVL_Axes.Axes[8],  iPersistentDataStorage := fbPersistentDataStorage, sName := 'D3M1'),
        (AxisRef := GVL_Axes.Axes[9], iPersistentDataStorage := fbPersistentDataStorage, sName := 'D3M2')
    ];
    aiMotionStageD3     	:  ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage
                        := [afbMotorsNCD3[1], afbMotorsNCD3[2]];
    {attribute 'pytmc' := '
        pv: TST:D3:STATE
        io: io
        array: 1..2 | 1..2
        expand-names: D3M1, D3M2
    '}
    astPositionStateD3 : ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;

    afbStateConfigD3 : ARRAY[1..((MotionConstants.MAX_STATE_MOTORS-2) * (GeneralConstants.MAX_STATES-2))]
        OF FB_StateConfigurator[
        // Motor 1
        (stPositionState := astPositionStateD3[1][E_State.OUT],      stDefault := stDefault, bSetDefault:= TRUE, sName := 'OUT',      fPosition := 100.0),
        (stPositionState := astPositionStateD3[1][E_State.TARGET1A], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1A', fPosition := 200.0),
        // Motor 2
        (stPositionState := astPositionStateD3[2][E_State.OUT],      stDefault := stDefault, bSetDefault:= TRUE, sName := 'OUT',      fPosition := 100.0),
        (stPositionState := astPositionStateD3[2][E_State.TARGET1A], stDefault := stDefault, bSetDefault:= TRUE, sName := 'TARGET1A', fPosition := 200.0)
    ];
    {attribute 'pytmc' := '
          pv: TST:D3:STATE:SET
          io: io
    '}
    eEnumSetD3          	: E_State;
    {attribute 'pytmc' := '
          pv: TST:D3:STATE:GET
          io: i
    '}
    eEnumGetD3          	: E_State;
    {attribute 'pytmc' := 'pv: TST:D3'}
    fbPositionStateND3 : FB_PositionStateND(
        aiMotionStage    := aiMotionStageD3,
        astPositionState := astPositionStateD3,
        eEnumSet         := eEnumSetD3,
        eEnumGet         := eEnumGetD3,
        nActiveMotorCount    := 2,
        bEnableMotion	:= TRUE,
        eMotionRequestPolicy := E_MotionRequestPolicy.INTERRUPT,
    );
    // Dummy scalar FB_MotionStage instance with no pytmc pragma; exists
    // purely to verify that un-pragma'd FBs are skipped by the EPICS
    // record generator.
    fbDummy : FB_MotionStageNC(
        sName := 'fbDummy',
        AxisRef := GVL_Axes.Axes[10],
        iPersistentDataStorage := fbPersistentDataStorage
    );

    // -- Alias / soft-link test fixtures --
    {attribute 'pytmc' := '
        alias: TST:M1.HLS
        pv: TST:M1:bTestHLS
    '}
    bTestHLS : BOOL;

    {attribute 'pytmc' := '
        alias: TST:M1.LLS
        pv: TST:M1:bTestLLS
    '}
    bTestLLS : BOOL;

    {attribute 'pytmc' := '
        alias: TST:M1.DMOV
        pv: TST:M1:bTestDMOV
    '}
    bTestDMOV : BOOL;

    {attribute 'pytmc' := '
        pv: TST:M1
    '}
    stAlias : ST_Alias;

    {attribute 'pytmc' := '
        pv: TST:M2
    '}
    fbAliasLevel1 : FB_AliasLevel1;

    // -- 64-bit integer type test fixtures --
    nTest64LINT : LINT;

    {attribute 'pytmc' := '
        pv: nTest64ULINT
        io: io
        field: DESC Start an AbsoluteMove
    '}
    nTest64ULINT : ULINT;

    {attribute 'pytmc' := '
        pv: nTest64LWORD
        io: io
        field: DESC Start an AbsoluteMove
    '}
    nTest64LWORD : LWORD;

    bEnableBeamParams : BOOL := TRUE;
    i : UINT;
    bFirstScan : BOOL := TRUE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bFirstScan THEN
    FOR i := 1 TO MotionConstants.MAX_STATE_MOTORS DO
        afbMotorsNCD1[i].SetModeEnableLimits(
            LimBackward    := TRUE,
            LimForward     := TRUE,
            HomeEnable     := FALSE,
            BrakeMode      := E_StageBrakeMode.IF_ENABLED,
            EnableMode     := E_StageEnableMode.DURING_MOTION,
            HomeMode       := E_EpicsHomeCmd.LOW_LIMIT,
            UserEnable     := TRUE,
            HardwareEnable := TRUE
        );
        afbMotorsNCD1[i].SetVelocity(Velocity := 15.5);

    END_FOR
    FOR i := 1 TO (MotionConstants.MAX_STATE_MOTORS-1) DO
        afbMotorsNCD2[i].SetModeEnableLimits(
            LimBackward    := TRUE,
            LimForward     := TRUE,
            HomeEnable     := FALSE,
            BrakeMode      := E_StageBrakeMode.IF_ENABLED,
            EnableMode     := E_StageEnableMode.DURING_MOTION,
            HomeMode       := E_EpicsHomeCmd.LOW_LIMIT,
            UserEnable     := TRUE,
            HardwareEnable := TRUE
        );
        afbMotorsNCD2[i].SetVelocity(Velocity := 15.5);
    END_FOR
    FOR i := 1 TO (MotionConstants.MAX_STATE_MOTORS-2) DO
        afbMotorsNCD3[i].SetModeEnableLimits(
            LimBackward    := TRUE,
            LimForward     := TRUE,
            HomeEnable     := FALSE,
            BrakeMode      := E_StageBrakeMode.IF_ENABLED,
            EnableMode     := E_StageEnableMode.DURING_MOTION,
            HomeMode       := E_EpicsHomeCmd.LOW_LIMIT,
            UserEnable     := TRUE,
            HardwareEnable := TRUE
        );
        afbMotorsNCD3[i].SetVelocity(Velocity := 15.5);
    END_FOR
    bFirstScan := FALSE;
END_IF

FOR i := 1 TO MotionConstants.MAX_STATE_MOTORS * GeneralConstants.MAX_STATES DO
    afbStateConfigD1[i]();
END_FOR
FOR i := 1 TO (MotionConstants.MAX_STATE_MOTORS-1) * (GeneralConstants.MAX_STATES-1) DO
    afbStateConfigD2[i]();
END_FOR
FOR i := 1 TO (MotionConstants.MAX_STATE_MOTORS-2) * (GeneralConstants.MAX_STATES-2) DO
    afbStateConfigD3[i]();
END_FOR

fbPersistentDataStorage();

FOR i := 1 TO MotionConstants.MAX_STATE_MOTORS DO
    afbMotorsNCD1[i]();
END_FOR
FOR i := 1 TO (MotionConstants.MAX_STATE_MOTORS-1) DO
    afbMotorsNCD2[i]();
END_FOR
FOR i := 1 TO (MotionConstants.MAX_STATE_MOTORS-2) DO
    afbMotorsNCD3[i]();
END_FOR

fbPositionStateND1();
fbPositionStateND2();
fbPositionStateND3();

fbDummy();]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>