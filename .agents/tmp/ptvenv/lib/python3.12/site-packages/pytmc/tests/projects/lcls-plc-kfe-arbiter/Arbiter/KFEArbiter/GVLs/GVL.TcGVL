<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4022.18">
  <GVL Name="GVL" Id="{8be29a55-f95b-0019-032e-27be63ad623d}">
    <Declaration><![CDATA[
VAR_GLOBAL
   {attribute 'pytmc' := '
    pv: @(PREFIX)Arbiter:01
    '}
    g_fbArbiter1	:	FB_Arbiter(25);

    {attribute 'pytmc' := '
    pv: @(PREFIX)Arbiter:02
    '}
    g_fbArbiter2	:	FB_Arbiter(25); //Used to line beam parameter

    ReqBP	:	ST_BeamParams; //Currently the placeholder for the fully arbitrated BP set

    // These are added for the additional low selector to figure out the override
    stArbiter1BP:ST_BeamParams; // a place holder for the arbitrated safe beam set from all the connected PLCs
    stCurrentFakeBP:ST_BeamParams; //Currently the placeholder for the fake arbitrated BP set to go to the rest of the PLC

    {attribute 'pytmc' := '
    pv: @(PREFIX)FFO:01
    '}
    {attribute 'TcLinkTo' := '.q_xFastFaultOut:=TIIB[FFO]^Channel 1^Output'}
    g_FastFaultOutput1	:	FB_HardwareFFOutput := (bAutoReset:=TRUE);

    {attribute 'pytmc' := '
    pv: @(PREFIX)FFO:02
    '}
    {attribute 'TcLinkTo' := '.q_xFastFaultOut:=TIIB[FFO]^Channel 2^Output'}
    g_FastFaultOutput2	:	FB_HardwareFFOutput := (bAutoReset:=TRUE);
	
	
	//The following faults will be per hutch and vetoed by the hutch specific veto
	//TMO OPTICS, VAC and Motion, DREAM
	{attribute 'pytmc' := '
    pv: @(PREFIX)FFO:03
    '}
    g_FastFaultOutput3	:	FB_HardwareFFOutput := (bAutoReset:=TRUE);
	{attribute 'pytmc' := '
    pv: @(PREFIX)FFO:04
    '}
    g_FastFaultOutput4	:	FB_HardwareFFOutput := (bAutoReset:=TRUE);
	
	
	//RIX Motion, QRIX and CRIX
	//NOTE: NOT OPTICS, NO VETO for OPTICS
	{attribute 'pytmc' := '
    pv: @(PREFIX)FFO:05
    '}
    g_FastFaultOutput5	:	FB_HardwareFFOutput := (bAutoReset:=TRUE);
	
	{attribute 'pytmc' := '
    pv: @(PREFIX)FFO:06
    '}
    g_FastFaultOutput6	:	FB_HardwareFFOutput := (bAutoReset:=TRUE);
	
	
	//TXI VAC and MOTION 
	//NOTE: NOT OPTICS, NO VETO for OPTICS
	{attribute 'pytmc' := '
    pv: @(PREFIX)FFO:07
    '}
    g_FastFaultOutput7	:	FB_HardwareFFOutput := (bAutoReset:=TRUE);
	

    g_rTestingVelocity	:	LREAL := PMPS_GVL.VISIBLE_TEST_VELOCITY;

     {attribute 'pytmc' := '
       pv: @(PREFIX)ApplyJF
    '}
    bApplyJF: BOOL:=FALSE;
    // Administrative mode for beam intensity
     {attribute 'pytmc' := '
          pv: @(PREFIX)IntensityJF
    '}
    nBeamIntensityJF: REAL :=nBeamIntensity;

    {attribute 'pytmc' := '
          pv: @(PREFIX)CancelJF
    '}
    bCancelJF: BOOL:=FALSE;

    {attribute 'pytmc' := '
          pv: @(PREFIX)DurationJF
    '}
    rDurationJF: REAL:=GVL.MaxDuration;//hours

    {attribute 'pytmc' := '
          pv: @(PREFIX)TimeRemainJF
    '}
    rTimeRemainJF: REAL:=GVL.MaxDuration;//hours

    AttemptReset    :   BOOL; // For testing
END_VAR

VAR_GLOBAL CONSTANT
    MAX_FAST_FAULTS : UINT := 100;
    //Judgement factor constants (administrative mode)
    nBeamIntensity : INT :=5;//mj
    MaxDuration : REAL :=12;

END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>