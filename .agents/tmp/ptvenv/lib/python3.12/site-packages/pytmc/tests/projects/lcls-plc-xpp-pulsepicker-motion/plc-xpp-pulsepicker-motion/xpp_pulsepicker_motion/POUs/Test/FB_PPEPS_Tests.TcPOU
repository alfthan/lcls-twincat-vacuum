<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PPEPS_Tests" Id="{a9bb27fe-4a3c-416c-8abc-9defce10a785}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PPEPS_Tests EXTENDS FB_TestSuite
VAR
    afbDoubleX : ARRAY[1..19] OF FB_MotionStageNC_TestDouble;
    afbDoubleY : ARRAY[1..19] OF FB_MotionStageNC_TestDouble;
    afbXEPS    : ARRAY[1..19] OF LCLS_MotionAbstraction.FB_EPS;
    afbYEPS    : ARRAY[1..19] OF LCLS_MotionAbstraction.FB_EPS;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Move-interlock logic
Test_XInCenter_WhenXWithinWindow();
Test_XNotInCenter_WhenXOutsideWindow();
Test_YAboveMed_WhenYExceedsThreshold();
Test_XMoveAllowed_WhenYLow_AndXInRange();
Test_XMoveBlocked_WhenYHigh_AndXOutsideCenter_MovingAway();
Test_XRecovery_WhenYHigh_AndXMovingTowardCenter();
Test_YMoveAllowed_WhenYLow_AndXInCenter();
Test_YMoveBlocked_WhenYHigh_AndXOutsideCenter();

// Homing gates POWER only (directional stays honest)
Test_XHomeAllowed_GatesPower_WhenYBelowMedium();
Test_XHome_YHigh_PowerNotReleased();
Test_YHomeAllowed_GatesPower_WhenXInCenter();
Test_YHome_PickerActive_AllCleared();
Test_Homing_DoesNotForceDirectional_AntiFakeLimit();
Test_XHoming_CommandHeld_NoExecute_NoPower();

// Picker
Test_PickerActive_BlocksXAndY();
Test_PickerIdle_ReleasesEPS();

// Per-axis bypass
Test_XBypass_OverridesBlockedMove();
Test_Bypass_CannotOverridePickerActive();
Test_XBypass_DoesNotReleasePower();]]></ST>
    </Implementation>
    <Method Name="GetBit" Id="{6c411b8f-6eb1-4d4e-988d-b4347d6f916a}">
      <Declaration><![CDATA[(* Helper: test whether bit nBit is set in nFlags. Retained for fine-grained
   diagnostics; the primary interlock signal asserted by tests is bEPS_OK
   (the per-channel AND-reduction that feeds the drive power/enable interlock). *)
METHOD PRIVATE GetBit : BOOL
VAR_INPUT
    nFlags : UDINT;
    nBit   : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetBit := (nFlags AND SHL(UDINT#1, nBit)) <> 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_XInCenter_WhenXWithinWindow" Id="{ae12d4cd-c75b-469c-b078-7e50fa6fcca6}">
      <Declaration><![CDATA[// X at 0.0 (inside center window) -> bXInCenter TRUE. Picker idle, move in window.
// Directional forward/backward bEPS_OK TRUE.
METHOD PRIVATE Test_XInCenter_WhenXWithinWindow
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[1], iYEPS := afbYEPS[1],
                     iXMotionStage := afbDoubleX[1], iYMotionStage := afbDoubleY[1]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_XInCenter_WhenXWithinWindow');

afbDoubleX[1].MotionStatus.fActPosition := 0.0;
afbDoubleX[1].MotionCmd.fPosition := 0.0;
afbDoubleY[1].MotionStatus.fActPosition := 0.0;

afbDoubleX[1]();
afbDoubleY[1]();
fbUUT(bPickActive := FALSE);

AssertTrue(fbUUT.bXInCenter,
    'bXInCenter should be TRUE when X=0.0');
AssertTrue(afbXEPS[1].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK should be TRUE (picker idle, move in window)');
AssertTrue(afbXEPS[1].EPSBackwardEnable.bEPS_OK,
    'X backward bEPS_OK should be TRUE');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_XNotInCenter_WhenXOutsideWindow" Id="{5cdfb153-0c00-493a-8dab-06dc498275a9}">
      <Declaration><![CDATA[// X at 3.0 (outside center) -> bXInCenter FALSE. Y low, full X range, cmd in range
// -> directional forward bEPS_OK TRUE.
METHOD PRIVATE Test_XNotInCenter_WhenXOutsideWindow
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[2], iYEPS := afbYEPS[2],
                     iXMotionStage := afbDoubleX[2], iYMotionStage := afbDoubleY[2]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_XNotInCenter_WhenXOutsideWindow');

afbDoubleX[2].MotionStatus.fActPosition := 3.0;
afbDoubleX[2].MotionCmd.fPosition := 3.0;
afbDoubleY[2].MotionStatus.fActPosition := 0.0;

afbDoubleX[2]();
afbDoubleY[2]();
fbUUT(bPickActive := FALSE);

AssertFalse(fbUUT.bXInCenter,
    'bXInCenter should be FALSE when X=3.0');
AssertTrue(afbXEPS[2].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK should be TRUE (Y low, full range, cmd in range)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_YAboveMed_WhenYExceedsThreshold" Id="{0bb8315a-e664-48ca-ac9a-19b750d8f5fc}">
      <Declaration><![CDATA[// Y at 15.0 (above medium) -> bYAboveMed TRUE. X in center so Y move allowed
// -> Y forward bEPS_OK TRUE.
METHOD PRIVATE Test_YAboveMed_WhenYExceedsThreshold
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[3], iYEPS := afbYEPS[3],
                     iXMotionStage := afbDoubleX[3], iYMotionStage := afbDoubleY[3]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_YAboveMed_WhenYExceedsThreshold');

afbDoubleX[3].MotionStatus.fActPosition := 0.0;
afbDoubleY[3].MotionStatus.fActPosition := 15.0;
afbDoubleY[3].MotionCmd.fPosition := 15.0;

afbDoubleX[3]();
afbDoubleY[3]();
fbUUT(bPickActive := FALSE);

AssertTrue(fbUUT.bYAboveMed,
    'bYAboveMed should be TRUE when Y=15.0');
AssertTrue(afbYEPS[3].EPSForwardEnable.bEPS_OK,
    'Y forward bEPS_OK should be TRUE (X in center allows Y move)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_XMoveAllowed_WhenYLow_AndXInRange" Id="{788bfe7d-832b-4688-b139-6273f6e07190}">
      <Declaration><![CDATA[// Y low, X cmd within range -> bXMoveAllowed TRUE; directional forward/backward bEPS_OK TRUE.
METHOD PRIVATE Test_XMoveAllowed_WhenYLow_AndXInRange
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[4], iYEPS := afbYEPS[4],
                     iXMotionStage := afbDoubleX[4], iYMotionStage := afbDoubleY[4]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_XMoveAllowed_WhenYLow_AndXInRange');

afbDoubleX[4].MotionStatus.fActPosition := 0.0;
afbDoubleX[4].MotionCmd.fPosition := 3.0;
afbDoubleY[4].MotionStatus.fActPosition := 5.0;

afbDoubleX[4]();
afbDoubleY[4]();
fbUUT(bPickActive := FALSE);

AssertTrue(fbUUT.bXMoveAllowed,
    'bXMoveAllowed should be TRUE when Y low and X cmd=3.0');
AssertTrue(afbXEPS[4].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK should be TRUE');
AssertTrue(afbXEPS[4].EPSBackwardEnable.bEPS_OK,
    'X backward bEPS_OK should be TRUE');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_XMoveBlocked_WhenYHigh_AndXOutsideCenter_MovingAway" Id="{40d950e0-0f58-40b5-825a-435b1876bc9d}">
      <Declaration><![CDATA[// Y high, X outside center, cmd further from center -> bXMoveAllowed FALSE.
// Directional bit1=0 -> forward/backward bEPS_OK FALSE.
METHOD PRIVATE Test_XMoveBlocked_WhenYHigh_AndXOutsideCenter_MovingAway
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[5], iYEPS := afbYEPS[5],
                     iXMotionStage := afbDoubleX[5], iYMotionStage := afbDoubleY[5]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_XMoveBlocked_WhenYHigh_AndXOutsideCenter_MovingAway');

afbDoubleX[5].MotionStatus.fActPosition := 3.0;
afbDoubleX[5].MotionCmd.fPosition := 4.0;
afbDoubleY[5].MotionStatus.fActPosition := 15.0;

afbDoubleX[5]();
afbDoubleY[5]();
fbUUT(bPickActive := FALSE);

AssertFalse(fbUUT.bXMoveAllowed,
    'bXMoveAllowed should be FALSE when Y high and X moving away from center');
AssertFalse(afbXEPS[5].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK should be FALSE (move bit cleared)');
AssertFalse(afbXEPS[5].EPSBackwardEnable.bEPS_OK,
    'X backward bEPS_OK should be FALSE (move bit cleared)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_XRecovery_WhenYHigh_AndXMovingTowardCenter" Id="{12266060-d0d8-475b-bb76-2b8269c04964}">
      <Declaration><![CDATA[// Y high, X outside center, cmd toward center -> recovery allowed.
// bXTowardCenter TRUE, bXMoveAllowed TRUE, forward bEPS_OK TRUE.
METHOD PRIVATE Test_XRecovery_WhenYHigh_AndXMovingTowardCenter
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[6], iYEPS := afbYEPS[6],
                     iXMotionStage := afbDoubleX[6], iYMotionStage := afbDoubleY[6]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_XRecovery_WhenYHigh_AndXMovingTowardCenter');

afbDoubleX[6].MotionStatus.fActPosition := 3.0;
afbDoubleX[6].MotionCmd.fPosition := 0.0;
afbDoubleY[6].MotionStatus.fActPosition := 15.0;

afbDoubleX[6]();
afbDoubleY[6]();
fbUUT(bPickActive := FALSE);

AssertTrue(fbUUT.bXTowardCenter,
    'bXTowardCenter should be TRUE');
AssertTrue(fbUUT.bXMoveAllowed,
    'bXMoveAllowed should be TRUE for recovery move toward center');
AssertTrue(afbXEPS[6].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK should be TRUE (recovery permitted)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_YMoveAllowed_WhenYLow_AndXInCenter" Id="{4bd61fd6-742f-462b-bbd9-ce2b6990eb10}">
      <Declaration><![CDATA[// Y low, X in center, Y cmd within range -> bYMoveAllowed TRUE.
// Y forward/backward bEPS_OK TRUE.
METHOD PRIVATE Test_YMoveAllowed_WhenYLow_AndXInCenter
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[7], iYEPS := afbYEPS[7],
                     iXMotionStage := afbDoubleX[7], iYMotionStage := afbDoubleY[7]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_YMoveAllowed_WhenYLow_AndXInCenter');

afbDoubleX[7].MotionStatus.fActPosition := 0.0;
afbDoubleY[7].MotionStatus.fActPosition := 5.0;
afbDoubleY[7].MotionCmd.fPosition := 18.0;

afbDoubleX[7]();
afbDoubleY[7]();
fbUUT(bPickActive := FALSE);

AssertTrue(fbUUT.bYMoveAllowed,
    'bYMoveAllowed should be TRUE when Y low, X in center, cmd=18.0');
AssertTrue(afbYEPS[7].EPSForwardEnable.bEPS_OK,
    'Y forward bEPS_OK should be TRUE');
AssertTrue(afbYEPS[7].EPSBackwardEnable.bEPS_OK,
    'Y backward bEPS_OK should be TRUE');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_YMoveBlocked_WhenYHigh_AndXOutsideCenter" Id="{916b494a-d224-42a2-8cb8-b3e6e50a4956}">
      <Declaration><![CDATA[// Y high, X outside center -> all Y motion blocked. Y forward/backward bEPS_OK FALSE.
METHOD PRIVATE Test_YMoveBlocked_WhenYHigh_AndXOutsideCenter
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[8], iYEPS := afbYEPS[8],
                     iXMotionStage := afbDoubleX[8], iYMotionStage := afbDoubleY[8]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_YMoveBlocked_WhenYHigh_AndXOutsideCenter');

afbDoubleX[8].MotionStatus.fActPosition := 3.0;
afbDoubleY[8].MotionStatus.fActPosition := 15.0;
afbDoubleY[8].MotionCmd.fPosition := 5.0;

afbDoubleX[8]();
afbDoubleY[8]();
fbUUT(bPickActive := FALSE);

AssertFalse(fbUUT.bYMoveAllowed,
    'bYMoveAllowed should be FALSE when Y high and X outside center');
AssertFalse(afbYEPS[8].EPSForwardEnable.bEPS_OK,
    'Y forward bEPS_OK should be FALSE');
AssertFalse(afbYEPS[8].EPSBackwardEnable.bEPS_OK,
    'Y backward bEPS_OK should be FALSE');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_XHomeAllowed_GatesPower_WhenYBelowMedium" Id="{da7e49c4-d1b4-494c-8730-478dfaed1eb0}">
      <Declaration><![CDATA[// Fresh HOME on X with Y below medium -> X-homing ALLOWED. Homing gates POWER only:
// power bEPS_OK TRUE (bXHomeAllowed releases power bit1). Directional follows the
// real move interlock (cmd=0.0 in range, Y low) -> forward bEPS_OK TRUE independently.
METHOD PRIVATE Test_XHomeAllowed_GatesPower_WhenYBelowMedium
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[9], iYEPS := afbYEPS[9],
                     iXMotionStage := afbDoubleX[9], iYMotionStage := afbDoubleY[9]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_XHomeAllowed_GatesPower_WhenYBelowMedium');

afbDoubleX[9].MotionStatus.fActPosition := 3.0;
afbDoubleX[9].MotionCmd.fPosition := 0.0;
afbDoubleX[9].MotionStatus.eCommand := E_EpicsMotorCmd.HOME;
afbDoubleX[9].ExMotionStatus.bExecute := TRUE;
afbDoubleY[9].MotionStatus.fActPosition := 5.0;

afbDoubleX[9]();
afbDoubleY[9]();
fbUUT(bPickActive := FALSE);

AssertTrue(fbUUT.bXHoming,
    'bXHoming should be TRUE for fresh HOME request');
AssertTrue(fbUUT.bXHomeAllowed,
    'bXHomeAllowed should be TRUE when Y below medium');
AssertTrue(afbXEPS[9].EPSPowerEnable.bEPS_OK,
    'X power bEPS_OK should be TRUE (homing allowed releases power)');
AssertTrue(afbXEPS[9].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK should be TRUE (move interlock allows it; homing does not gate direction)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_XHome_YHigh_PowerNotReleased" Id="{1b2c3d4e-0009-0009-0009-000000000009}">
      <Declaration><![CDATA[// Fresh HOME on X but Y HIGH -> bXHomeAllowed = NOT bYAboveMed = FALSE.
// Homing gates POWER: power bit1 = bXHomeAllowed = FALSE -> X power bEPS_OK FALSE.
// Directional is independent and here also blocked (Y high, cmd away) -> forward bEPS_OK FALSE.
METHOD PRIVATE Test_XHome_YHigh_PowerNotReleased
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[10], iYEPS := afbYEPS[10],
                     iXMotionStage := afbDoubleX[10], iYMotionStage := afbDoubleY[10]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_XHome_YHigh_PowerNotReleased');

afbDoubleX[10].MotionStatus.fActPosition := 3.0;
afbDoubleX[10].MotionCmd.fPosition := 4.0;
afbDoubleX[10].MotionStatus.eCommand := E_EpicsMotorCmd.HOME;
afbDoubleX[10].ExMotionStatus.bExecute := TRUE;
afbDoubleY[10].MotionStatus.fActPosition := 15.0;

afbDoubleX[10]();
afbDoubleY[10]();
fbUUT(bPickActive := FALSE);

AssertTrue(fbUUT.bXHoming,
    'bXHoming should be TRUE (request is live)');
AssertFalse(fbUUT.bXHomeAllowed,
    'bXHomeAllowed should be FALSE when Y high');
AssertFalse(afbXEPS[10].EPSPowerEnable.bEPS_OK,
    'X power bEPS_OK should be FALSE (home not allowed gates power)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_YHomeAllowed_GatesPower_WhenXInCenter" Id="{1b2c3d4e-0011-0011-0011-000000000011}">
      <Declaration><![CDATA[// Fresh HOME on Y, X in center, picker idle -> Y-homing ALLOWED. Power bEPS_OK TRUE.
// Directional follows the real move interlock independently.
METHOD PRIVATE Test_YHomeAllowed_GatesPower_WhenXInCenter
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[11], iYEPS := afbYEPS[11],
                     iXMotionStage := afbDoubleX[11], iYMotionStage := afbDoubleY[11]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_YHomeAllowed_GatesPower_WhenXInCenter');

afbDoubleX[11].MotionStatus.fActPosition := 0.0;
afbDoubleY[11].MotionStatus.fActPosition := 0.0;
afbDoubleY[11].MotionCmd.fPosition := 0.0;
afbDoubleY[11].MotionStatus.eCommand := E_EpicsMotorCmd.HOME;
afbDoubleY[11].ExMotionStatus.bExecute := TRUE;

afbDoubleX[11]();
afbDoubleY[11]();
fbUUT(bPickActive := FALSE);

AssertTrue(fbUUT.bYHoming,
    'bYHoming should be TRUE for fresh HOME request');
AssertTrue(fbUUT.bYHomeAllowed,
    'bYHomeAllowed should be TRUE when X in center and picker idle');
AssertTrue(afbYEPS[11].EPSPowerEnable.bEPS_OK,
    'Y power bEPS_OK should be TRUE (homing allowed releases power)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_YHome_PickerActive_AllCleared" Id="{562c375b-d7bf-4a00-ad8f-95c221be446f}">
      <Declaration><![CDATA[// Fresh HOME on Y, X in center, picker ACTIVE -> picker overrides all.
// bYHomeAllowed forced FALSE; all three Y bEPS_OK FALSE (bit0 held 0 everywhere).
METHOD PRIVATE Test_YHome_PickerActive_AllCleared
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[12], iYEPS := afbYEPS[12],
                     iXMotionStage := afbDoubleX[12], iYMotionStage := afbDoubleY[12]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_YHome_PickerActive_AllCleared');

afbDoubleX[12].MotionStatus.fActPosition := 0.0;
afbDoubleY[12].MotionStatus.fActPosition := 0.0;
afbDoubleY[12].MotionStatus.eCommand := E_EpicsMotorCmd.HOME;
afbDoubleY[12].ExMotionStatus.bExecute := TRUE;

afbDoubleX[12]();
afbDoubleY[12]();
fbUUT(bPickActive := TRUE);

AssertFalse(fbUUT.bYHomeAllowed,
    'bYHomeAllowed should be FALSE under picker active');
AssertFalse(afbYEPS[12].EPSPowerEnable.bEPS_OK,
    'Y power bEPS_OK should be FALSE (picker active)');
AssertFalse(afbYEPS[12].EPSForwardEnable.bEPS_OK,
    'Y forward bEPS_OK should be FALSE (picker active)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Homing_DoesNotForceDirectional_AntiFakeLimit" Id="{913f2b88-6e1e-4b3f-a39a-d1aa90d72dd8}">
      <Declaration><![CDATA[// CORE GUARANTEE: during an ALLOWED home, the directional EPS must still follow the
// real move interlock - homing must NOT force the directional bit (which would fake a
// limit switch). Setup: X home allowed (Y low) but a directional move that is blocked.
// Expect: X power bEPS_OK TRUE (home authorized power) AND X forward bEPS_OK FALSE
// (directional honestly blocked). The two channels decouple - that is the design.
METHOD PRIVATE Test_Homing_DoesNotForceDirectional_AntiFakeLimit
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[13], iYEPS := afbYEPS[13],
                     iXMotionStage := afbDoubleX[13], iYMotionStage := afbDoubleY[13]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_Homing_DoesNotForceDirectional_AntiFakeLimit');

afbDoubleX[13].MotionStatus.fActPosition := 8.0;   // outside full range so move blocked
afbDoubleX[13].MotionCmd.fPosition := 9.0;          // cmd out of [fXLimMin, fXLimMax]
afbDoubleX[13].MotionStatus.eCommand := E_EpicsMotorCmd.HOME;
afbDoubleX[13].ExMotionStatus.bExecute := TRUE;
afbDoubleY[13].MotionStatus.fActPosition := 5.0;   // below medium -> X-homing allowed

afbDoubleX[13]();
afbDoubleY[13]();
fbUUT(bPickActive := FALSE);

AssertTrue(fbUUT.bXHoming,
    'bXHoming should be TRUE');
AssertTrue(fbUUT.bXHomeAllowed,
    'bXHomeAllowed should be TRUE (Y below medium)');
AssertTrue(afbXEPS[13].EPSPowerEnable.bEPS_OK,
    'X power bEPS_OK should be TRUE (home authorizes power)');
AssertFalse(fbUUT.bXMoveAllowed,
    'bXMoveAllowed should be FALSE (cmd out of range) - homing must not force it');
AssertFalse(afbXEPS[13].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK should be FALSE (directional follows real move interlock, not homing)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_XHoming_CommandHeld_NoExecute_NoPower" Id="{28aeb929-dc2a-45d2-a716-66c227daccce}">
      <Declaration><![CDATA[// REGRESSION for the latch bug: eCommand stays HOME but bExecute FALSE (stale, held
// selection). bXHoming MUST be FALSE so the power channel is released normally (not
// gated by a phantom home) and the directional channel follows the move interlock.
METHOD PRIVATE Test_XHoming_CommandHeld_NoExecute_NoPower
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[14], iYEPS := afbYEPS[14],
                     iXMotionStage := afbDoubleX[14], iYMotionStage := afbDoubleY[14]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_XHoming_CommandHeld_NoExecute_NoPower');

afbDoubleX[14].MotionStatus.fActPosition := 3.0;
afbDoubleX[14].MotionCmd.fPosition := 0.0;             // an allowed move (Y low)
afbDoubleX[14].MotionStatus.eCommand := E_EpicsMotorCmd.HOME; // command still reads HOME...
afbDoubleX[14].ExMotionStatus.bExecute := FALSE;                // ...but no fresh execute
afbDoubleY[14].MotionStatus.fActPosition := 5.0;

afbDoubleX[14]();
afbDoubleY[14]();
fbUUT(bPickActive := FALSE);

AssertFalse(fbUUT.bXHoming,
    'bXHoming should be FALSE when no fresh execute (latch regression)');
AssertTrue(afbXEPS[14].EPSPowerEnable.bEPS_OK,
    'X power bEPS_OK should be TRUE (not homing -> power released normally)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_PickerActive_BlocksXAndY" Id="{c1a2b3c4-0001-0001-0001-000000000010}">
      <Declaration><![CDATA[// Picker active -> all three bEPS_OK FALSE on both axes (bit0 held 0 everywhere).
METHOD PRIVATE Test_PickerActive_BlocksXAndY
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[15], iYEPS := afbYEPS[15],
                     iXMotionStage := afbDoubleX[15], iYMotionStage := afbDoubleY[15]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_PickerActive_BlocksXAndY');

afbDoubleX[15].MotionStatus.fActPosition := 0.0;
afbDoubleX[15].MotionCmd.fPosition := 3.0;
afbDoubleY[15].MotionStatus.fActPosition := 5.0;
afbDoubleY[15].MotionCmd.fPosition := 8.0;

afbDoubleX[15]();
afbDoubleY[15]();
fbUUT(bPickActive := TRUE);

AssertFalse(afbXEPS[15].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK should be FALSE (picker active)');
AssertFalse(afbXEPS[15].EPSPowerEnable.bEPS_OK,
    'X power bEPS_OK should be FALSE (picker active)');
AssertFalse(afbYEPS[15].EPSForwardEnable.bEPS_OK,
    'Y forward bEPS_OK should be FALSE (picker active)');
AssertFalse(afbYEPS[15].EPSPowerEnable.bEPS_OK,
    'Y power bEPS_OK should be FALSE (picker active)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_PickerIdle_ReleasesEPS" Id="{c1a2b3c4-0001-0001-0001-000000000011}">
      <Declaration><![CDATA[// Picker idle with a valid in-range state -> directional forward/backward bEPS_OK TRUE both axes.
METHOD PRIVATE Test_PickerIdle_ReleasesEPS
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[16], iYEPS := afbYEPS[16],
                     iXMotionStage := afbDoubleX[16], iYMotionStage := afbDoubleY[16]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_PickerIdle_ReleasesEPS');

afbDoubleX[16].MotionStatus.fActPosition := 0.0;
afbDoubleY[16].MotionStatus.fActPosition := 0.0;

afbDoubleX[16]();
afbDoubleY[16]();
fbUUT(bPickActive := FALSE);

AssertTrue(afbXEPS[16].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK should be TRUE when picker idle');
AssertTrue(afbXEPS[16].EPSBackwardEnable.bEPS_OK,
    'X backward bEPS_OK should be TRUE when picker idle');
AssertTrue(afbYEPS[16].EPSForwardEnable.bEPS_OK,
    'Y forward bEPS_OK should be TRUE when picker idle');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_XBypass_OverridesBlockedMove" Id="{c1a2b3c4-0001-0001-0001-000000000012}">
      <Declaration><![CDATA[// Per-axis bypass forces the DIRECTIONAL move bit TRUE even when the interlock blocks
// (Y high, X outside, cmd away). Picker idle -> X forward/backward bEPS_OK TRUE.
// Y not bypassed and blocked -> Y forward bEPS_OK FALSE.
METHOD PRIVATE Test_XBypass_OverridesBlockedMove
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[17], iYEPS := afbYEPS[17],
                     iXMotionStage := afbDoubleX[17], iYMotionStage := afbDoubleY[17]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_XBypass_OverridesBlockedMove');

afbDoubleX[17].MotionStatus.fActPosition := 3.0;
afbDoubleX[17].MotionCmd.fPosition := 4.0;   // normally blocked
afbDoubleY[17].MotionStatus.fActPosition := 15.0;

fbUUT.bXBypass := TRUE;
fbUUT.bYBypass := FALSE;

afbDoubleX[17]();
afbDoubleY[17]();
fbUUT(bPickActive := FALSE);

AssertTrue(afbXEPS[17].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK should be TRUE (bypass forces move bit, picker idle)');
AssertTrue(afbXEPS[17].EPSBackwardEnable.bEPS_OK,
    'X backward bEPS_OK should be TRUE (bypass forces move bit)');
AssertFalse(afbYEPS[17].EPSForwardEnable.bEPS_OK,
    'Y forward bEPS_OK should be FALSE (Y not bypassed, move blocked)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Bypass_CannotOverridePickerActive" Id="{c1a2b3c4-0001-0001-0001-000000000013}">
      <Declaration><![CDATA[// SAFETY: bypass on BOTH axes must NOT defeat the picker. With picker active, the
// NOT bPickActive wrapper holds directional bit1 = 0 and bit0 = 0 -> all bEPS_OK FALSE.
METHOD PRIVATE Test_Bypass_CannotOverridePickerActive
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[18], iYEPS := afbYEPS[18],
                     iXMotionStage := afbDoubleX[18], iYMotionStage := afbDoubleY[18]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_Bypass_CannotOverridePickerActive');

afbDoubleX[18].MotionStatus.fActPosition := 0.0;
afbDoubleX[18].MotionCmd.fPosition := 0.0;
afbDoubleY[18].MotionStatus.fActPosition := 5.0;
afbDoubleY[18].MotionCmd.fPosition := 5.0;

fbUUT.bXBypass := TRUE;
fbUUT.bYBypass := TRUE;

afbDoubleX[18]();
afbDoubleY[18]();
fbUUT(bPickActive := TRUE);

AssertFalse(afbXEPS[18].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK must stay FALSE (picker active, bypass cannot override)');
AssertFalse(afbYEPS[18].EPSForwardEnable.bEPS_OK,
    'Y forward bEPS_OK must stay FALSE (picker active, bypass cannot override)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_XBypass_DoesNotReleasePower" Id="{c1a2b3c4-0001-0001-0001-000000000014}">
      <Declaration><![CDATA[// Bypass touches the DIRECTIONAL channel only. With X home requested but NOT allowed
// (Y high), bypass forces the directional bit but must NOT release power: power is gated
// by homing, which bypass does not touch -> X power bEPS_OK FALSE while forward bEPS_OK TRUE.
METHOD PRIVATE Test_XBypass_DoesNotReleasePower
VAR_INST
    fbUUT : FB_PPEPS(iXEPS := afbXEPS[19], iYEPS := afbYEPS[19],
                     iXMotionStage := afbDoubleX[19], iYMotionStage := afbDoubleY[19]);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Test_XBypass_DoesNotReleasePower');

afbDoubleX[19].MotionStatus.fActPosition := 3.0;
afbDoubleX[19].MotionCmd.fPosition := 4.0;
afbDoubleX[19].MotionStatus.eCommand := E_EpicsMotorCmd.HOME;
afbDoubleX[19].ExMotionStatus.bExecute := TRUE;
afbDoubleY[19].MotionStatus.fActPosition := 15.0;   // Y high -> home not allowed

fbUUT.bXBypass := TRUE;

afbDoubleX[19]();
afbDoubleY[19]();
fbUUT(bPickActive := FALSE);

AssertTrue(afbXEPS[19].EPSForwardEnable.bEPS_OK,
    'X forward bEPS_OK should be TRUE (bypass forces directional bit)');
AssertFalse(afbXEPS[19].EPSPowerEnable.bEPS_OK,
    'X power bEPS_OK should be FALSE (bypass does not touch power; home not allowed)');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
