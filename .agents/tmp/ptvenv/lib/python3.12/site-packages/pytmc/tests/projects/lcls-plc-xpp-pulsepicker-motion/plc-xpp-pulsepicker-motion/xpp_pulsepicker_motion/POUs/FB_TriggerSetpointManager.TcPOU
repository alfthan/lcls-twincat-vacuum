<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TriggerSetpointManager" Id="{9f19d4ff-0d4c-45cd-8530-aede7c8e52d2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TriggerSetpointManager
VAR_INPUT
    Mode     : E_ModeSelector;
    bWaitDone : BOOL := TRUE;
    fStopPos : LREAL;
    fStopNeg : LREAL;
    fCenter : LREAL;
END_VAR

VAR_OUTPUT
    fSetpoint : LREAL;
    nMoveIdx  : INT;
    bBusy     : BOOL;
END_VAR

VAR
    fbMoveAbs0 : MC_MoveAbsolute;
    fbMoveAbs1 : MC_MoveAbsolute;
    AxisRef    : REFERENCE TO AXIS_REF;
    iMotionStage : I_MotionStage;

    fbTrigSrc  : LCLS_Tc_MotSync.FB_TriggerSourceEL1124;
    {attribute 'pytmc' := 'pv:'}
    fbTrigMgr  : LCLS_Tc_MotSync.FB_TriggerManagerEL1124(
        fTriggerFrequencyExpected := fTargetFreq,
        iTriggerSource := fbTrigSrc
    );

    eState       : INT := 0;
    lastEndPoint : LREAL := 0.0;
    bStarted     : BOOL;

    // Overshoot counters
    {attribute 'pytmc' := '
        pv: nOvrCntPos
        io: i
        field: DESC Positive Stop Position over counters
    '}
    nOvrCntPos : UDINT;
    {attribute 'pytmc' := '
        pv: nOvrCntNeg
        io: i
        field: DESC Negative Stop Position over counters
    '}
    nOvrCntNeg : UDINT;

    // Averaging
    bAvg    : BOOL := FALSE;
    fSumPos : LREAL := 0.0;
    nSmpl   : UDINT := 0;
    fAvgPos : LREAL := 0.0;

    rtStop      : R_TRIG;
    rtNewTrig   : R_TRIG;

    // Internal busy flags per FB
    bBusy0 : BOOL;
    bBusy1 : BOOL;

    fTargetFreq : LREAL := 30.0;
    {attribute 'pytmc' := '
        pv: bResetCnt
        io: io
        field: DESC Reset Stop Position over counters
    '}
    bResetCnt  : BOOL := FALSE;
    rtResetCnt : R_TRIG;

END_VAR

VAR PERSISTENT
    {attribute 'pytmc' := '
        pv: fLimitPos
        io: io
        field: DESC Positive Overshoot Limit
    '}
    fLimitPos : LREAL := 14.5;

    {attribute 'pytmc' := '
        pv: fLimitNeg
        io: io
        field: DESC Negative Overshoot Limit
    '}
    fLimitNeg : LREAL := -14.5;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF iMotionStage = 0 THEN
    RETURN;
END_IF

fbTrigMgr();

// Combine busy flags
bBusy := bBusy0 OR bBusy1;

CASE eState OF
    // WAIT FOR START
    0:
        IF bStarted THEN
            eState := 1;
        END_IF

    // WAIT FOR TRIGGER
    1:
        IF fbTrigMgr.NewTriggerIsAvailable THEN
            // Safety clear of accumulators before a new move
            bAvg    R= FALSE;
            fSumPos := 0.0;
            nSmpl   := 0;
            fAvgPos := 0.0;
            eState  := 2;
        END_IF

    // COMMAND MOVE ON TRIGGER
    2:
        CASE Mode OF
            E_ModeSelector.Burst:
                IF (fSetpoint = fStopPos) OR (fSetpoint = fStopNeg) THEN
                    fSetpoint := fCenter;
                ELSE
                    IF ABS(iMotionStage.MotionStatus.fActPosition - fStopPos)
                      < ABS(iMotionStage.MotionStatus.fActPosition - fStopNeg) THEN
                        fSetpoint := fStopPos;
                    ELSE
                        fSetpoint := fStopNeg;
                    END_IF
                END_IF

            E_ModeSelector.FlipFlop:
                IF lastEndPoint = fStopPos THEN
                    fSetpoint    := fStopNeg;
                    lastEndPoint := fStopNeg;
                ELSE
                    fSetpoint    := fStopPos;
                    lastEndPoint := fStopPos;
                END_IF
        END_CASE

        IF nMoveIdx = 0 THEN
            fbMoveAbs0.Execute := FALSE;
            fbMoveAbs1.Execute := TRUE;
            nMoveIdx := 1;
        ELSE
            fbMoveAbs1.Execute := FALSE;
            fbMoveAbs0.Execute := TRUE;
            nMoveIdx := 0;
        END_IF

        fbTrigMgr.UnlatchTrigger();
        eState := SEL(bWaitDone, 1, 3);

    // WAIT FOR MOVE COMPLETE (optional)
    3:
        IF (nMoveIdx = 0 AND (fbMoveAbs0.Done OR AxisRef.Status.StandStill OR fbMoveAbs0.Error)) OR
           (nMoveIdx = 1 AND (fbMoveAbs1.Done OR AxisRef.Status.StandStill OR fbMoveAbs1.Error)) THEN
            fbMoveAbs0.Execute := FALSE;
            fbMoveAbs1.Execute := FALSE;
            eState := 1;
        END_IF

    ELSE
        eState := 0;
END_CASE

// Motion FBs
fbMoveAbs0(
    Axis       := AxisRef,
    Position   := fSetpoint,
    Velocity   := iMotionStage.MotionCmd.fVelocity,
    BufferMode := MC_BufferMode.MC_Aborting,
    Busy       => bBusy0
);
fbMoveAbs1(
    Axis       := AxisRef,
    Position   := fSetpoint,
    Velocity   := iMotionStage.MotionCmd.fVelocity,
    BufferMode := MC_BufferMode.MC_Aborting,
    Busy       => bBusy1
);

// Detect when stage crosses the setpoint heading toward the stop
rtStop(CLK :=
    (nMoveIdx = 0 AND iMotionStage.MotionStatus.fActPosition < fSetpoint) OR
    (nMoveIdx = 1 AND iMotionStage.MotionStatus.fActPosition > fSetpoint)
);
bAvg S= rtStop.Q;

// Accumulate position while averaging window is open
IF bAvg THEN
    fSumPos := fSumPos + iMotionStage.MotionStatus.fActPosition;
    nSmpl   := nSmpl + 1;
END_IF

// Compute average on the rising edge of the next trigger
// Compute average on the rising edge of the next trigger
rtNewTrig(CLK := fbTrigMgr.NewTriggerIsAvailable);
IF bAvg AND rtNewTrig.Q THEN
    IF nSmpl > 0 THEN
        fAvgPos := fSumPos / nSmpl;
    ELSE
        fAvgPos := iMotionStage.MotionStatus.fActPosition;
    END_IF

    IF fAvgPos > fLimitPos THEN
        nOvrCntPos := nOvrCntPos + 1;
    END_IF
    IF fAvgPos < fLimitNeg THEN
        nOvrCntNeg := nOvrCntNeg + 1;
    END_IF

    fSumPos := 0.0;
    nSmpl   := 0;
    bAvg    := FALSE;
END_IF

// Reset overshoot counters on rising edge, then self-clear
rtResetCnt(CLK := bResetCnt);
IF rtResetCnt.Q THEN
    nOvrCntPos := 0;
    nOvrCntNeg := 0;
    bResetCnt  := FALSE;
END_IF]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{ff01f169-3e3f-4d9c-bd86-8d2bcf836c65}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
    AxisRef    : REFERENCE TO AXIS_REF;
    iMotionStage : I_MotionStage;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.AxisRef REF= AxisRef;
THIS^.iMotionStage := iMotionStage ;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{ba112a95-1b3a-40cb-95ca-25bed47cf79d}">
      <Declaration><![CDATA[METHOD Reset
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[    fbTrigMgr.SetFrequency(fTargetFreq);
fbTrigMgr.ResetTriggerCounter();
nMoveIdx     := 0;
fSetpoint    := 0.0;
lastEndPoint := 0.0;
bStarted     := FALSE;
eState       := 0;
fbMoveAbs0.Execute := FALSE;
fbMoveAbs1.Execute := FALSE;
// Reset averaging state
bAvg    R= FALSE;
fSumPos := 0.0;
nSmpl   := 0;
fAvgPos := 0.0;
// Reset overshoot counters
nOvrCntPos := 0;
nOvrCntNeg := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{6a9e85e7-695f-43e7-9600-3365de2137bd}">
      <Declaration><![CDATA[METHOD Start
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbTrigMgr.Stop();
fbMoveAbs0.Execute := FALSE;
fbMoveAbs1.Execute := FALSE;
IF ABS(iMotionStage.MotionStatus.fActPosition - fStopPos)
    < ABS(iMotionStage.MotionStatus.fActPosition - fStopNeg) THEN
    fSetpoint    := fStopPos;
    lastEndPoint := fStopPos;
ELSE
    fSetpoint    := fStopNeg;
    lastEndPoint := fStopNeg;
END_IF
fbTrigMgr.Start();
nMoveIdx := 0;
bStarted := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{4f5ea7c1-f494-4fe8-9319-58ac1ca7ab78}">
      <Declaration><![CDATA[METHOD Stop
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbTrigMgr.Stop();
fbMoveAbs0.Execute := FALSE;
fbMoveAbs1.Execute := FALSE;
eState   := 0;
bStarted := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>