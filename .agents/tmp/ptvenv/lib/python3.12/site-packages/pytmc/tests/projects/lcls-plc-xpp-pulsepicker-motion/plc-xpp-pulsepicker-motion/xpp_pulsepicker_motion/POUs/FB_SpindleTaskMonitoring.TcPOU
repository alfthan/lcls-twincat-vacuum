<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SpindleTaskMonitoring" Id="{6f10fcca-9fcc-4420-ae83-af79a52c9a6b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SpindleTaskMonitoring
VAR_INPUT
    iMotionStage : I_MotionStage; // Interface, assigned via FB_Init at instantiation
END_VAR
VAR_OUTPUT
    nTaskExceedCounter : UDINT;   // Current overrun counter
    nExceedsDelta      : UDINT;   // Difference since last check
    bNewExceeds        : BOOL;    // TRUE if new overrun detected
    bError             : BOOL;    // FB error flag
    nErrorId           : UDINT;   // FB error code
END_VAR
VAR
    fbReadTaskExceedCounter : FB_ReadTaskExceedCounter;
    fBusyEdge               : F_TRIG;
    nPreviousCounter        : UDINT := 0;
    nCurTick                : ULINT := 0;
    nLastCheckTick          : ULINT := 0;
    nCheckIntervalNs        : ULINT := 1_000_000_000; // 1s
    bMonitorRequest         : BOOL := FALSE;
    bFBResetSent            : BOOL := FALSE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF (iMotionStage = 0) THEN
    // Outputs default values for fault/no interface assignment
    nTaskExceedCounter := 0;
    nExceedsDelta := 0;
    bNewExceeds := FALSE;
    bError := FALSE;
    nErrorId := 0;
    RETURN;
END_IF

nCurTick := F_GetCurDcTickTime64();

IF (nCurTick - nLastCheckTick) >= nCheckIntervalNs THEN
    bMonitorRequest := TRUE;
    nLastCheckTick := nCurTick;
END_IF

fbReadTaskExceedCounter(
    bExecute := bMonitorRequest,
    nTaskAdsPort := TwinCAT_SystemInfoVarList._TaskInfo[GETCURTASKINDEXEX()].AdsPort
);

fBusyEdge(CLK := fbReadTaskExceedCounter.bBusy);

bError   := fbReadTaskExceedCounter.bError;
nErrorId := fbReadTaskExceedCounter.nErrorId;

IF fBusyEdge.Q AND NOT bError THEN
    nTaskExceedCounter := fbReadTaskExceedCounter.nExceedCounter;
    nExceedsDelta := 0;
    bNewExceeds := FALSE;
    IF nTaskExceedCounter > nPreviousCounter THEN
        bNewExceeds := TRUE;
        nExceedsDelta := nTaskExceedCounter - nPreviousCounter;
        nPreviousCounter := nTaskExceedCounter;

        // Issue spindle reset via the interface
        IF NOT bFBResetSent THEN
            iMotionStage.MotionCmd.bReset := TRUE;
            bFBResetSent := TRUE;
        END_IF
    ELSE
        iMotionStage.MotionCmd.bReset := FALSE;
        bFBResetSent := FALSE;
    END_IF

    bMonitorRequest := FALSE;
END_IF

IF bError THEN
    bMonitorRequest := FALSE;
    nExceedsDelta := 0;
    bNewExceeds := FALSE;
    iMotionStage.MotionCmd.bReset := FALSE;
    bFBResetSent := FALSE;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>