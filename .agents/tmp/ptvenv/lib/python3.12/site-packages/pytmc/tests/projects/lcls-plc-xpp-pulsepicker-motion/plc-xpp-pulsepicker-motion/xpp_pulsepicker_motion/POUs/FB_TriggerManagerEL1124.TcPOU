<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TriggerManagerEL1124" Id="{8a4cde9d-d03f-437f-b339-3c856c9117ea}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TriggerManagerEL1124 EXTENDS FB_TriggerManager
VAR
    bTriggerInputPrev       : BOOL := FALSE;
    nMinDebounceNs          : ULINT := 2000000; // 2 ms debounce in ns
    nLastTriggerTick        : ULINT := 0;
    nPrevTriggerTick        : ULINT := 0;
   {attribute 'pytmc' := '
        pv: fCurrentTriggerFrequency
        io: i
        field: DESC Current Trigger Frequency
    '}
    fCurrentTriggerFrequency : REAL := 0.0;
    nCurTick : ULINT := 0;
    nDeltaTick: ULINT;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF (iTriggerSource = 0) THEN
    RETURN;
END_IF

nCurTick := F_GetCurDcTickTime64();

IF bRunning AND iTriggerSource.Trigger AND NOT bTriggerInputPrev THEN
    IF (nCurTick - nLastTriggerTick) >= nMinDebounceNs THEN
        bNewLatchPending := TRUE;
        nNumberOfTriggersSinceLastCounterReset := nNumberOfTriggersSinceLastCounterReset + 1;

        IF NOT bHaveNotReceivedFirstTriggerSinceLastStart THEN
            nDeltaTick := nCurTick - nPrevTriggerTick;
            IF nDeltaTick > 0 THEN
                fCurrentTriggerFrequency := 1.0 / (ULINT_TO_REAL(nDeltaTick) * 1E-9);
            ELSE
                fCurrentTriggerFrequency := fCurrentTriggerFrequency;
            END_IF
        ELSE
            bHaveNotReceivedFirstTriggerSinceLastStart := FALSE;
        END_IF

        nPrevTriggerTick := nCurTick;
        nLastTriggerTick := nCurTick;
    END_IF
END_IF

bTriggerInputPrev := iTriggerSource.Trigger;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>