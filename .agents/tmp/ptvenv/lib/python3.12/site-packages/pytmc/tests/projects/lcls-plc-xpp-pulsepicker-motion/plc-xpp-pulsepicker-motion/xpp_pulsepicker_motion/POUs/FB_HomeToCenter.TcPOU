<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_HomeToCenter" Id="{b1d20a44-0001-4a10-9c20-7a3f0e2c1101}" SpecialFunc="None">
    <Declaration><![CDATA[(*  FB_HomeToCenter - Limit-switch homing + centering sequence.

 Overview:
   This FB does NOT command the home; it observes the rising edge of bHoming, waits for the
   drive to confirm bDone AND bHomed, then issues a centering AbsoluteMove to
   fCenterOffset and zeroes the position via MC_SetPosition.the drive's own switch-homing finds the reference, so the FB only sequences
   "wait homed -> center -> zero".

 Per-instance wiring (via FB_Init):
   iMotionStage : the stage interface this FB sequences.
   refAxis      : the AXIS_REF used for the position-zero (e.g. GVL_AXES.Axes[2]
                  for X, GVL_AXES.Axes[3] for Y).

 Per-instance parameters:
   fCenterOffset    : centering target after home (X: 2.5, Y: 6.5).
   fDefaultVelocity : centering move velocity, also the velocity restore fallback.
*)
FUNCTION_BLOCK FB_HomeToCenter
VAR_INPUT
    fCenterOffset    : LREAL;
    fDefaultVelocity : LREAL;
END_VAR
VAR
    iMotionStage : I_MotionStage;

    {attribute 'hide'}
    rtHomingStart  : R_TRIG;
    {attribute 'hide'}
    rtWaitHomeDone : R_TRIG;
    {attribute 'hide'}
    rtCenterDone   : R_TRIG;
    {attribute 'hide'}
    rtError        : R_TRIG;

    fPrevVelocity   : LREAL;
    fbMcSetPosition : MC_SetPosition;
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
        pv: bCentered
        io: i
        field: ZNAM FALSE
        field: ONAM TRUE
        field: DESC TRUE if the stage is centered
    '}
    bCentered      : BOOL;
    bHomeDone      : BOOL;
    bLocalError    : BOOL;
    eHomeCenterState : E_HomeCenterState := E_HomeCenterState.Idle;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF (iMotionStage = 0) THEN
    RETURN;
END_IF

// Edge detection - all R_TRIG instances tick every cycle, outside the CASE.
rtError(CLK := iMotionStage.MotionStatus.bError AND iMotionStage.MotionStatus.bStageReady);
rtHomingStart(CLK := iMotionStage.MotionStatus.bHoming);
// Fires when the drive confirms both done and homed during the wait state.
rtWaitHomeDone(CLK := iMotionStage.MotionStatus.bDone
        AND iMotionStage.MotionStatus.bHomed
        AND (eHomeCenterState = E_HomeCenterState.WaitHomeDone));
// Fires when the centering move completes.
rtCenterDone(CLK := iMotionStage.MotionStatus.bDone
        AND (eHomeCenterState = E_HomeCenterState.CenterMove));

// Any drive error redirects to Error from any point in the sequence.
IF rtError.Q THEN
    eHomeCenterState := E_HomeCenterState.Error;
END_IF

CASE eHomeCenterState OF
    E_HomeCenterState.Idle:
        // The NC side owns the home trigger. Enter the sequence on the rising
        // edge of bHoming (NC is the source of truth).
        IF rtHomingStart.Q THEN
            Reset();
            bCentered := FALSE;
            // Preserve current velocity to restore after centering; fall back to default.
            IF iMotionStage.MotionCmd.fVelocity <> 0.0 THEN
                fPrevVelocity := iMotionStage.MotionCmd.fVelocity;
            ELSE
                fPrevVelocity := fDefaultVelocity;
            END_IF
            eHomeCenterState := E_HomeCenterState.WaitHomeDone;
        END_IF

    E_HomeCenterState.WaitHomeDone:
        // Drive is homing against the switch. Wait for both bDone and bHomed,
        // confirming the homing move has fully settled, then center.
        IF rtWaitHomeDone.Q THEN
            iMotionStage.AbsoluteMoveDefault(
                Position := fCenterOffset,
                Velocity := fDefaultVelocity
            );
            eHomeCenterState := E_HomeCenterState.CenterMove;
        END_IF

    E_HomeCenterState.CenterMove:
        // AbsoluteMoveDefault clears bDone before starting, so rtCenterDone only
        // fires on the fresh rising edge from THIS move completing.
        IF rtCenterDone.Q THEN
            // Define the current (centered) position as zero.
            fbMcSetPosition.Execute := TRUE;
            eHomeCenterState := E_HomeCenterState.WaitCenterDone;
        END_IF

    E_HomeCenterState.WaitCenterDone:
        // fbMcSetPosition runs unconditionally below the CASE each cycle.
        IF fbMcSetPosition.Done THEN
            fbMcSetPosition.Execute := FALSE;
            bCentered := TRUE;
            bHomeDone := TRUE;
            eHomeCenterState := E_HomeCenterState.HomingDone;
        END_IF

    E_HomeCenterState.HomingDone:
        // Restore motion parameters to the pre-homing state, then return to Idle
        // ready for the next NC-initiated homing cycle.
        iMotionStage.SetDefaultMotionParameters(
            HomePosition := 0.0,
            Velocity     := fPrevVelocity
        );
        iMotionStage.MotionCmd.fPosition := iMotionStage.MotionCmd.fHomePosition;
        eHomeCenterState := E_HomeCenterState.Idle;

    E_HomeCenterState.Error:
        // Latch error output and safe the sequence. Caller must invoke Reset().
        bLocalError := TRUE;
        fbMcSetPosition.Execute := FALSE;
        bCentered := FALSE;
        bHomeDone := FALSE;
        IF iMotionStage.ExMotionStatus.bLatchReset THEN
            bLocalError := FALSE;
            eHomeCenterState := E_HomeCenterState.Idle;
        END_IF

END_CASE

// MC_SetPosition runs every cycle; Execute is gated by WaitCenterDone above.
// Axis comes from the injected refAxis so X and Y target their own axes.
fbMcSetPosition(
    Axis     := iMotionStage.Axis,
    Mode     := 0,
    Position := 0.0
);]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{75fde0c8-5e38-4fef-b90e-94053e0aad38}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
    iMotionStage : I_MotionStage;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.iMotionStage := iMotionStage;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{b1d20a44-0003-4a10-9c20-7a3f0e2c1103}">
      <Declaration><![CDATA[METHOD Reset
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bCentered := FALSE;
bHomeDone := FALSE;
bLocalError := FALSE;
fbMcSetPosition.Execute := FALSE;
eHomeCenterState := E_HomeCenterState.Idle;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>